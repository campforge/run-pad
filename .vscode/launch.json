{
    "version": "0.3.0",
    "configurations": [
        {
            "name": "RunPad (Debug)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/main/RunPad/bin/Debug/net10.0/RunPad.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/main/RunPad",
            "stopAtEntry": false,
            "console": "internalConsole",
            "justMyCode": false,
            "logging": {
                "moduleLoad": false
