        },
        {
            "name": "RunPad (Release)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/main/RunPad/bin/Release/net10.0/RunPad.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/main/RunPad",
            "stopAtEntry": false,
            "console": "internalConsole",
            "justMyCode": false,
            "logging": {
                "moduleLoad": false
            },
            "env": {
                "DOTNET_ENVIRONMENT": "Production"
            }
        }
    ]
