<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Local fork of the MarkView.Avalonia 12.3.0 NuGet package, referenced as a project so RunPad
         can change the control itself (for example, mapping rendered blocks back to source lines).
         Origin and license: README.md and LICENSE.md in this folder. -->
    <RootNamespace>MarkView.Avalonia</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Markdig" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Themes\**" />
  </ItemGroup>

</Project>
