<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DotPad.Avalonia.Themes.DotPadTheme">
    <StyleInclude Source="avares://DotPad.Avalonia.Themes/Themes/VsCodeDark.axaml" />
    <StyleInclude Source="avares://DotPad.Avalonia.Themes/Themes/VsCodeLight.axaml" />
    <StyleInclude Source="avares://DotPad.Avalonia.Themes/Themes/RiderDark.axaml" />
    <StyleInclude Source="avares://DotPad.Avalonia.Themes/Themes/RiderLight.axaml" />
    <StyleInclude Source="avares://DotPad.Avalonia.Themes/Themes/Vs2022Dark.axaml" />
    <StyleInclude Source="avares://DotPad.Avalonia.Themes/Themes/Vs2022Light.axaml" />
    <StyleInclude Source="avares://DotPad.Avalonia.Themes/Themes/DotPadMidnight.axaml" />
    <StyleInclude Source="avares://DotPad.Avalonia.Themes/Themes/DotPadWarmLight.axaml" />

    <!-- ── Compact controls (TODO.md #113: live user report — LINQPad 4 shown as a denser
         reference; app-wide instead of scattered per-window, so every stock FluentTheme control
         DotPad hasn't already hand-tuned gets the same treatment, not just the ones someone
         happened to touch). FontSize=13/Padding="6,4" aren't arbitrary — they're the exact values
         DotPad's own windows already use in scattered LOCAL overrides today (e.g. ConditionDialog's
         and RenameSymbolDialog's own TextBox Padding, MainWindow's own MenuItem FontSize) —
         promoted here to a single app-wide default instead of duplicated per-window. ────────── -->
