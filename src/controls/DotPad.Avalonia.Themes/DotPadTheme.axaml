        <Setter Property="FontSize"  Value="12"/>
        <Setter Property="Padding"   Value="8,4"/>
        <Setter Property="MinHeight" Value="26"/>
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="FontSize"  Value="12"/>
        <Setter Property="MinHeight" Value="26"/>
    </Style>
    <Style Selector="Button">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding"  Value="10,5"/>
    </Style>
    <Style Selector="CheckBox, RadioButton">
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBox">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding"  Value="6,4"/>
    </Style>
    <Style Selector="NumericUpDown">
        <Setter Property="FontSize"  Value="12"/>
        <Setter Property="MinHeight" Value="26"/>
    </Style>
    <Style Selector="ToolTip">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding"  Value="6,4"/>
    </Style> -->

    <!-- ── DataGrid ─────────────────────────────────────────────────────── -->
    <Style Selector="DataGrid">
        <Setter Property="Background"               Value="{DynamicResource DotPad.Output.BackgroundBrush}"/>
        <Setter Property="Foreground"               Value="{DynamicResource DotPad.Text.PrimaryBrush}"/>
        <Setter Property="BorderBrush"              Value="{DynamicResource DotPad.Border.BackgroundBrush}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DotPad.Separator.BackgroundBrush}"/>
        <Setter Property="VerticalGridLinesBrush"   Value="{DynamicResource DotPad.Separator.BackgroundBrush}"/>
        <Setter Property="RowBackground"            Value="Transparent"/>
    </Style>

    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background"     Value="{DynamicResource DotPad.Panel.BackgroundBrush}"/>
        <Setter Property="Foreground"     Value="{DynamicResource DotPad.Text.SecondaryBrush}"/>
        <Setter Property="SeparatorBrush" Value="{DynamicResource DotPad.Separator.BackgroundBrush}"/>
        <Setter Property="FontSize"       Value="12"/>
        <Setter Property="MinHeight"      Value="28"/>
    </Style>
    <Style Selector="DataGridColumnHeader:pointerover /template/ Grid#PART_ColumnHeaderRoot">
        <Setter Property="Background" Value="{DynamicResource DotPad.Toolbar.Button.HoverBrush}"/>
    </Style>

    <Style Selector="DataGridRow">
        <Setter Property="Foreground" Value="{DynamicResource DotPad.Text.PrimaryBrush}"/>
        <Setter Property="MinHeight"  Value="24"/>
    </Style>
    <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill"    Value="{DynamicResource DotPad.Toolbar.Button.HoverBrush}"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill"    Value="{DynamicResource DotPad.Accent.BackgroundBrush}"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="DataGridRow:selected:pointerover /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill"    Value="{DynamicResource DotPad.Accent.BackgroundBrush}"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="DataGridRow:selected:focus /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill"    Value="{DynamicResource DotPad.Accent.BackgroundBrush}"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="DataGridRow:selected:pointerover:focus /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill"    Value="{DynamicResource DotPad.Accent.BackgroundBrush}"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="DataGridCell">
        <Setter Property="Foreground"     Value="{DynamicResource DotPad.Text.PrimaryBrush}"/>
        <Setter Property="FontSize"       Value="13"/>
        <Setter Property="MinHeight"      Value="24"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- ── TreeView ──────────────────────────────────────────────────────── -->
    <Style Selector="TreeView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding"    Value="0"/>
    </Style>
    <Style Selector="TreeViewItem">
        <Setter Property="Foreground" Value="{DynamicResource DotPad.Text.PrimaryBrush}"/>
        <Setter Property="Padding"    Value="2,4"/>
    </Style>
    <Style Selector="TreeViewItem:pointerover /template/ Border">
        <Setter Property="Background" Value="{DynamicResource DotPad.Toolbar.Button.HoverBrush}"/>
    </Style>
    <Style Selector="TreeViewItem:selected /template/ Border">
        <Setter Property="Background" Value="{DynamicResource DotPad.Accent.BackgroundBrush}"/>
    </Style>
    <Style Selector="TreeViewItem:selected:pointerover /template/ Border">
        <Setter Property="Background" Value="{DynamicResource DotPad.Accent.BackgroundBrush}"/>
    </Style>
    <Style Selector="TreeViewItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource DotPad.Accent.ForegroundBrush}"/>
    </Style>

</Styles>
