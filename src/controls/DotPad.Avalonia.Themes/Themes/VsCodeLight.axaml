<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="using:DotPad.Avalonia.Themes">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="{x:Static themes:DotPadThemeVariants.VsCodeLight}">
                    <SolidColorBrush x:Key="DotPad.Sidebar.BackgroundBrush"           Color="#F3F3F3" />
                    <SolidColorBrush x:Key="DotPad.Toolbar.BackgroundBrush"           Color="#F3F3F3" />
                    <SolidColorBrush x:Key="DotPad.Toolbar.BorderBrush"               Color="#E7E7E7" />
                    <SolidColorBrush x:Key="DotPad.Editor.BackgroundBrush"            Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DotPad.Editor.SelectionBrush"             Color="#ADD6FF" />
                    <SolidColorBrush x:Key="DotPad.Output.BackgroundBrush"            Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DotPad.Output.ErrorForeground"            Color="#CC0000" />
                    <SolidColorBrush x:Key="DotPad.Output.StackTraceForeground"       Color="#A31515" />
                    <SolidColorBrush x:Key="DotPad.Panel.BackgroundBrush"             Color="#F3F3F3" />
                    <SolidColorBrush x:Key="DotPad.StatusBar.BackgroundBrush"         Color="#007ACC" />
                    <SolidColorBrush x:Key="DotPad.StatusBar.ForegroundBrush"         Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DotPad.Status.RunningBrush"               Color="#4FC1FF" />
                    <SolidColorBrush x:Key="DotPad.Status.CancelledBrush"             Color="#9E9E9E" />
                    <SolidColorBrush x:Key="DotPad.Status.SuccessBrush"               Color="#4EC94E" />
                    <SolidColorBrush x:Key="DotPad.Status.ErrorBrush"                 Color="#F14C4C" />
                    <SolidColorBrush x:Key="DotPad.Status.PausedBrush"                Color="#FFA500" />
                    <SolidColorBrush x:Key="DotPad.Separator.BackgroundBrush"         Color="#E7E7E7" />
                    <SolidColorBrush x:Key="DotPad.Border.BackgroundBrush"            Color="#DDDDDD" />
                    <SolidColorBrush x:Key="DotPad.Text.PrimaryBrush"                 Color="#383838" />
                    <SolidColorBrush x:Key="DotPad.Text.SecondaryBrush"               Color="#717171" />
                    <SolidColorBrush x:Key="DotPad.Accent.BackgroundBrush"            Color="#C8EBFB" />
                    <SolidColorBrush x:Key="DotPad.Accent.ForegroundBrush"            Color="#005FB8" />
                    <SolidColorBrush x:Key="DotPad.Tab.AccentBrush"                    Color="#007ACC" />
                    <Color             x:Key="DotPad.Tab.AccentColor"                               >#007ACC</Color>
                    <SolidColorBrush x:Key="DotPad.Toolbar.Button.HoverBrush"         Color="#E0E0E0" />
                    <SolidColorBrush x:Key="DotPad.Icon.PlayBrush"                    Color="#26862B" />
                    <SolidColorBrush x:Key="DotPad.Icon.StopBrush"                    Color="#B80000" />
                    <SolidColorBrush x:Key="DotPad.Icon.DebugBrush"                   Color="#C26500" />
                    <SolidColorBrush x:Key="DotPad.Icon.StepBrush"                    Color="#006BB3" />
                    <SolidColorBrush x:Key="DotPad.Icon.DisabledBrush"               Color="#AAAAAA" />
                    <SolidColorBrush x:Key="DotPad.Margin.BreakpointBrush"           Color="#CC0000" />
                    <SolidColorBrush x:Key="DotPad.Margin.BreakpointVerifiedBrush"   Color="#388A34" />
                    <SolidColorBrush x:Key="DotPad.Margin.BreakpointUnverifiedBrush" Color="#BF8803" />
                    <SolidColorBrush x:Key="DotPad.Margin.BreakpointPreviewBrush"    Color="#AA7070" />
                    <SolidColorBrush x:Key="DotPad.Margin.BreakpointConditionBadgeBrush" Color="#8A5FBF" />
                    <SolidColorBrush x:Key="DotPad.Margin.DebugArrowBrush"           Color="#E8B400" />
                    <SolidColorBrush x:Key="DotPad.Margin.DebugLineBrush"            Color="#4CFFFF00" />
                    <SolidColorBrush x:Key="DotPad.Margin.LineNumberBrush"          Color="#9E9E9E" />
                    <SolidColorBrush x:Key="DotPad.Margin.CodeFixErrorBrush"     Color="#F14C4C" />
                    <SolidColorBrush x:Key="DotPad.Margin.CodeFixWarningBrush"   Color="#BF8803" />
                    <SolidColorBrush x:Key="DotPad.Folding.ChevronBrush"            Color="#9D9D9D" />
                    <SolidColorBrush x:Key="DotPad.Folding.ChevronHoverBrush"       Color="#424242" />
                    <SolidColorBrush x:Key="DotPad.Folding.LineBrush"               Color="#D3D3D3" />
                    <SolidColorBrush x:Key="DotPad.Dump.TableHeaderBrush"           Color="#0066B3" />
                    <SolidColorBrush x:Key="DotPad.Dump.TableHeaderForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DotPad.Dump.TableBorderBrush"           Color="#B0B8C8" />
                    <SolidColorBrush x:Key="DotPad.Dump.TableEvenRowBrush"          Color="#EDF2FB" />
                    <SolidColorBrush x:Key="DotPad.Dump.StringBrush"                Color="#A31515" />
                    <SolidColorBrush x:Key="DotPad.Dump.NumberBrush"                Color="#098658" />
                    <SolidColorBrush x:Key="DotPad.Dump.BoolBrush"                  Color="#0000CC" />
                    <SolidColorBrush x:Key="DotPad.Dump.EnumBrush"                  Color="#267F99" />
                    <SolidColorBrush x:Key="DotPad.Dump.DateTimeBrush"              Color="#7B3FA0" />
                    <SolidColorBrush x:Key="DotPad.Dump.PropertyNameBrush"          Color="#0F4A8A" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
