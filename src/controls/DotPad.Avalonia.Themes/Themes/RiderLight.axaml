<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="using:DotPad.Avalonia.Themes">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <!-- JetBrains Rider New UI — Light -->
                <ResourceDictionary x:Key="{x:Static themes:DotPadThemeVariants.RiderLight}">
                    <SolidColorBrush x:Key="DotPad.Sidebar.BackgroundBrush"           Color="#ECECEC" />
                    <SolidColorBrush x:Key="DotPad.Toolbar.BackgroundBrush"           Color="#EBEBEB" />
                    <SolidColorBrush x:Key="DotPad.Toolbar.BorderBrush"               Color="#CBCBCB" />
                    <SolidColorBrush x:Key="DotPad.Editor.BackgroundBrush"            Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DotPad.Editor.SelectionBrush"             Color="#BDD5F5" />
                    <SolidColorBrush x:Key="DotPad.Output.BackgroundBrush"            Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DotPad.Output.ErrorForeground"            Color="#CC0000" />
                    <SolidColorBrush x:Key="DotPad.Output.StackTraceForeground"       Color="#A31515" />
                    <SolidColorBrush x:Key="DotPad.Panel.BackgroundBrush"             Color="#F5F5F5" />
                    <SolidColorBrush x:Key="DotPad.StatusBar.BackgroundBrush"         Color="#EBEBEB" />
                    <SolidColorBrush x:Key="DotPad.StatusBar.ForegroundBrush"         Color="#6C6C6C" />
                    <SolidColorBrush x:Key="DotPad.Status.RunningBrush"               Color="#0078D4" />
                    <SolidColorBrush x:Key="DotPad.Status.CancelledBrush"             Color="#767676" />
                    <SolidColorBrush x:Key="DotPad.Status.SuccessBrush"               Color="#267F26" />
                    <SolidColorBrush x:Key="DotPad.Status.ErrorBrush"                 Color="#D00000" />
                    <SolidColorBrush x:Key="DotPad.Status.PausedBrush"                Color="#B35C00" />
                    <SolidColorBrush x:Key="DotPad.Separator.BackgroundBrush"         Color="#DBDBDB" />
                    <SolidColorBrush x:Key="DotPad.Border.BackgroundBrush"            Color="#CBCBCB" />
                    <SolidColorBrush x:Key="DotPad.Text.PrimaryBrush"                 Color="#1A1A1A" />
                    <SolidColorBrush x:Key="DotPad.Text.SecondaryBrush"               Color="#6C6C6C" />
                    <SolidColorBrush x:Key="DotPad.Accent.BackgroundBrush"            Color="#BDD5F5" />
                    <SolidColorBrush x:Key="DotPad.Accent.ForegroundBrush"            Color="#2470B3" />
                    <SolidColorBrush x:Key="DotPad.Tab.AccentBrush"                    Color="#2470B3" />
                    <Color             x:Key="DotPad.Tab.AccentColor"                               >#2470B3</Color>
                    <SolidColorBrush x:Key="DotPad.Toolbar.Button.HoverBrush"         Color="#D8D8D8" />
                    <SolidColorBrush x:Key="DotPad.Icon.PlayBrush"                    Color="#267F26" />
                    <SolidColorBrush x:Key="DotPad.Icon.StopBrush"                    Color="#C50000" />
                    <SolidColorBrush x:Key="DotPad.Icon.DebugBrush"                   Color="#B35C00" />
                    <SolidColorBrush x:Key="DotPad.Icon.StepBrush"                    Color="#1060C0" />
                    <SolidColorBrush x:Key="DotPad.Icon.DisabledBrush"               Color="#A8A8A8" />
                    <SolidColorBrush x:Key="DotPad.Margin.BreakpointBrush"           Color="#D9001B" />
                    <SolidColorBrush x:Key="DotPad.Margin.BreakpointVerifiedBrush"   Color="#2E8B3D" />
                    <SolidColorBrush x:Key="DotPad.Margin.BreakpointUnverifiedBrush" Color="#B8860B" />
                    <SolidColorBrush x:Key="DotPad.Margin.BreakpointPreviewBrush"    Color="#AA7070" />
                    <SolidColorBrush x:Key="DotPad.Margin.BreakpointConditionBadgeBrush" Color="#8A5FBF" />
                    <SolidColorBrush x:Key="DotPad.Margin.DebugArrowBrush"           Color="#E8B400" />
                    <SolidColorBrush x:Key="DotPad.Margin.DebugLineBrush"            Color="#50FFFF00" />
                    <SolidColorBrush x:Key="DotPad.Margin.LineNumberBrush"          Color="#A6A6A6" />
                    <SolidColorBrush x:Key="DotPad.Margin.CodeFixErrorBrush"     Color="#D00000" />
                    <SolidColorBrush x:Key="DotPad.Margin.CodeFixWarningBrush"   Color="#B8860B" />
                    <SolidColorBrush x:Key="DotPad.Folding.ChevronBrush"            Color="#ABABAB" />
                    <SolidColorBrush x:Key="DotPad.Folding.ChevronHoverBrush"       Color="#565656" />
                    <SolidColorBrush x:Key="DotPad.Folding.LineBrush"               Color="#D8D8D8" />
                    <SolidColorBrush x:Key="DotPad.Dump.TableHeaderBrush"           Color="#1060C0" />
                    <SolidColorBrush x:Key="DotPad.Dump.TableHeaderForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DotPad.Dump.TableBorderBrush"           Color="#B8BFCC" />
                    <SolidColorBrush x:Key="DotPad.Dump.TableEvenRowBrush"          Color="#EDF4FD" />
                    <SolidColorBrush x:Key="DotPad.Dump.StringBrush"                Color="#A31515" />
                    <SolidColorBrush x:Key="DotPad.Dump.NumberBrush"                Color="#098658" />
                    <SolidColorBrush x:Key="DotPad.Dump.BoolBrush"                  Color="#1060C0" />
                    <SolidColorBrush x:Key="DotPad.Dump.EnumBrush"                  Color="#267F99" />
                    <SolidColorBrush x:Key="DotPad.Dump.DateTimeBrush"              Color="#7B3FA0" />
                    <SolidColorBrush x:Key="DotPad.Dump.PropertyNameBrush"          Color="#0F4A8A" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
