<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="using:DotPad.Avalonia.Themes">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="{x:Static themes:DotPadThemeVariants.DotPadMidnight}">
                    <SolidColorBrush x:Key="DotPad.Sidebar.BackgroundBrush"           Color="#1E2228" />
                    <SolidColorBrush x:Key="DotPad.Toolbar.BackgroundBrush"           Color="#232831" />
                    <SolidColorBrush x:Key="DotPad.Toolbar.BorderBrush"               Color="#323844" />
                    <SolidColorBrush x:Key="DotPad.Editor.BackgroundBrush"            Color="#16191F" />
                    <SolidColorBrush x:Key="DotPad.Editor.SelectionBrush"             Color="#2E4F8C" />
                    <SolidColorBrush x:Key="DotPad.Output.BackgroundBrush"            Color="#171B21" />
                    <SolidColorBrush x:Key="DotPad.Output.ErrorForeground"            Color="#E06C75" />
                    <SolidColorBrush x:Key="DotPad.Output.StackTraceForeground"       Color="#C89A9A" />
                    <SolidColorBrush x:Key="DotPad.Panel.BackgroundBrush"             Color="#20242B" />
                    <SolidColorBrush x:Key="DotPad.StatusBar.BackgroundBrush"         Color="#20242B" />
                    <SolidColorBrush x:Key="DotPad.StatusBar.ForegroundBrush"         Color="#D7DAE0" />
                    <SolidColorBrush x:Key="DotPad.Status.RunningBrush"               Color="#61AFEF" />
                    <SolidColorBrush x:Key="DotPad.Status.CancelledBrush"             Color="#8E949D" />
                    <SolidColorBrush x:Key="DotPad.Status.SuccessBrush"               Color="#73C991" />
                    <SolidColorBrush x:Key="DotPad.Status.ErrorBrush"                 Color="#E06C75" />
                    <SolidColorBrush x:Key="DotPad.Status.PausedBrush"                Color="#E5C07B" />
                    <SolidColorBrush x:Key="DotPad.Separator.BackgroundBrush"         Color="#2E333D" />
                    <SolidColorBrush x:Key="DotPad.Border.BackgroundBrush"            Color="#353B46" />
                    <SolidColorBrush x:Key="DotPad.Text.PrimaryBrush"                 Color="#D7DAE0" />
                    <SolidColorBrush x:Key="DotPad.Text.SecondaryBrush"               Color="#99A2AF" />
                    <SolidColorBrush x:Key="DotPad.Accent.BackgroundBrush"            Color="#5B8CFF" />
                    <SolidColorBrush x:Key="DotPad.Accent.ForegroundBrush"            Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DotPad.Tab.AccentBrush"                    Color="#5B8CFF" />
                    <Color             x:Key="DotPad.Tab.AccentColor"                               >#5B8CFF</Color>
                    <SolidColorBrush x:Key="DotPad.Toolbar.Button.HoverBrush"         Color="#323844" />
                    <SolidColorBrush x:Key="DotPad.Icon.PlayBrush"                    Color="#73C991" />
                    <SolidColorBrush x:Key="DotPad.Icon.StopBrush"                    Color="#E06C75" />
                    <SolidColorBrush x:Key="DotPad.Icon.DebugBrush"                   Color="#E5C07B" />
                    <SolidColorBrush x:Key="DotPad.Icon.StepBrush"                    Color="#61AFEF" />
                    <SolidColorBrush x:Key="DotPad.Icon.DisabledBrush"               Color="#666C76" />
                    <SolidColorBrush x:Key="DotPad.Margin.BreakpointBrush"           Color="#E06C75" />
                    <SolidColorBrush x:Key="DotPad.Margin.BreakpointVerifiedBrush"   Color="#89CA78" />
                    <SolidColorBrush x:Key="DotPad.Margin.BreakpointUnverifiedBrush" Color="#E5C07B" />
                    <SolidColorBrush x:Key="DotPad.Margin.BreakpointPreviewBrush"    Color="#8B4A57" />
                    <SolidColorBrush x:Key="DotPad.Margin.BreakpointConditionBadgeBrush" Color="#B18AE0" />
                    <SolidColorBrush x:Key="DotPad.Margin.DebugArrowBrush"           Color="#F2CC60" />
                    <SolidColorBrush x:Key="DotPad.Margin.DebugLineBrush"            Color="#336BC46D" />
                    <SolidColorBrush x:Key="DotPad.Margin.LineNumberBrush"          Color="#5C6370" />
                    <SolidColorBrush x:Key="DotPad.Margin.CodeFixErrorBrush"     Color="#E06C75" />
                    <SolidColorBrush x:Key="DotPad.Margin.CodeFixWarningBrush"   Color="#E5C07B" />
                    <SolidColorBrush x:Key="DotPad.Folding.ChevronBrush"            Color="#8E949D" />
                    <SolidColorBrush x:Key="DotPad.Folding.ChevronHoverBrush"       Color="#D7DAE0" />
                    <SolidColorBrush x:Key="DotPad.Folding.LineBrush"               Color="#3A404A" />
                    <SolidColorBrush x:Key="DotPad.Dump.TableHeaderBrush"           Color="#355A9A" />
                    <SolidColorBrush x:Key="DotPad.Dump.TableHeaderForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DotPad.Dump.TableBorderBrush"           Color="#353B46" />
                    <SolidColorBrush x:Key="DotPad.Dump.TableEvenRowBrush"          Color="#1E2228" />
                    <SolidColorBrush x:Key="DotPad.Dump.StringBrush"                Color="#D19A66" />
                    <SolidColorBrush x:Key="DotPad.Dump.NumberBrush"                Color="#98C379" />
                    <SolidColorBrush x:Key="DotPad.Dump.BoolBrush"                  Color="#61AFEF" />
                    <SolidColorBrush x:Key="DotPad.Dump.EnumBrush"                  Color="#56B6C2" />
                    <SolidColorBrush x:Key="DotPad.Dump.DateTimeBrush"              Color="#C678DD" />
                    <SolidColorBrush x:Key="DotPad.Dump.PropertyNameBrush"          Color="#7DCFFF" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
