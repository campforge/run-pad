<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="using:DotPad.Avalonia.Themes">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="{x:Static themes:DotPadThemeVariants.VsCodeDark}">
                    <SolidColorBrush x:Key="DotPad.Sidebar.BackgroundBrush"           Color="#252526" />
                    <SolidColorBrush x:Key="DotPad.Toolbar.BackgroundBrush"           Color="#3C3C3C" />
                    <SolidColorBrush x:Key="DotPad.Toolbar.BorderBrush"               Color="#2D2D2D" />
                    <SolidColorBrush x:Key="DotPad.Editor.BackgroundBrush"            Color="#121414" />
                    <SolidColorBrush x:Key="DotPad.Editor.SelectionBrush"             Color="#264F78" />
                    <SolidColorBrush x:Key="DotPad.Output.BackgroundBrush"            Color="#1E1E1E" />
                    <SolidColorBrush x:Key="DotPad.Output.ErrorForeground"            Color="#F14C4C" />
                    <SolidColorBrush x:Key="DotPad.Output.StackTraceForeground"       Color="#CD9591" />
                    <SolidColorBrush x:Key="DotPad.Panel.BackgroundBrush"             Color="#252526" />
                    <SolidColorBrush x:Key="DotPad.StatusBar.BackgroundBrush"         Color="#007ACC" />
                    <SolidColorBrush x:Key="DotPad.StatusBar.ForegroundBrush"         Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DotPad.Status.RunningBrush"               Color="#4FC1FF" />
                    <SolidColorBrush x:Key="DotPad.Status.CancelledBrush"             Color="#9E9E9E" />
                    <SolidColorBrush x:Key="DotPad.Status.SuccessBrush"               Color="#4EC94E" />
                    <SolidColorBrush x:Key="DotPad.Status.ErrorBrush"                 Color="#F14C4C" />
                    <SolidColorBrush x:Key="DotPad.Status.PausedBrush"                Color="#FFA500" />
                    <SolidColorBrush x:Key="DotPad.Separator.BackgroundBrush"         Color="#454545" />
                    <SolidColorBrush x:Key="DotPad.Border.BackgroundBrush"            Color="#3C3C3C" />
                    <SolidColorBrush x:Key="DotPad.Text.PrimaryBrush"                 Color="#CCCCCC" />
                    <SolidColorBrush x:Key="DotPad.Text.SecondaryBrush"               Color="#9E9E9E" />
                    <SolidColorBrush x:Key="DotPad.Accent.BackgroundBrush"            Color="#0E639C" />
                    <SolidColorBrush x:Key="DotPad.Accent.ForegroundBrush"            Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DotPad.Tab.AccentBrush"                    Color="#007ACC" />
                    <Color             x:Key="DotPad.Tab.AccentColor"                               >#007ACC</Color>
                    <SolidColorBrush x:Key="DotPad.Tab.DirtyBrush"                     Color="#CCA700" />
                    <SolidColorBrush x:Key="DotPad.Toolbar.Button.HoverBrush"         Color="#505050" />
                    <SolidColorBrush x:Key="DotPad.Icon.PlayBrush"                    Color="#4EC94E" />
                    <SolidColorBrush x:Key="DotPad.Icon.StopBrush"                    Color="#E05555" />
                    <SolidColorBrush x:Key="DotPad.Icon.DebugBrush"                   Color="#F5A623" />
                    <SolidColorBrush x:Key="DotPad.Icon.StepBrush"                    Color="#4FC1FF" />
                    <SolidColorBrush x:Key="DotPad.Icon.DisabledBrush"               Color="#5C5C5C" />
                    <SolidColorBrush x:Key="DotPad.Margin.BreakpointBrush"           Color="#E51400" />
                    <SolidColorBrush x:Key="DotPad.Margin.BreakpointVerifiedBrush"   Color="#89D185" />
                    <SolidColorBrush x:Key="DotPad.Margin.BreakpointUnverifiedBrush" Color="#CCA700" />
                    <SolidColorBrush x:Key="DotPad.Margin.BreakpointPreviewBrush"    Color="#8B3030" />
                    <SolidColorBrush x:Key="DotPad.Margin.BreakpointConditionBadgeBrush" Color="#B18AE0" />
                    <SolidColorBrush x:Key="DotPad.Margin.DebugArrowBrush"           Color="#FFCC00" />
                    <SolidColorBrush x:Key="DotPad.Margin.DebugLineBrush"            Color="#33FFD800" />
                    <SolidColorBrush x:Key="DotPad.Margin.LineNumberBrush"          Color="#858585" />
                    <SolidColorBrush x:Key="DotPad.Margin.CodeFixErrorBrush"     Color="#F14C4C" />
                    <SolidColorBrush x:Key="DotPad.Margin.CodeFixWarningBrush"   Color="#CCA700" />
                    <SolidColorBrush x:Key="DotPad.Folding.ChevronBrush"            Color="#858585" />
                    <SolidColorBrush x:Key="DotPad.Folding.ChevronHoverBrush"       Color="#C5C5C5" />
                    <SolidColorBrush x:Key="DotPad.Folding.LineBrush"               Color="#404040" />
                    <SolidColorBrush x:Key="DotPad.Dump.TableHeaderBrush"           Color="#1B4F7D" />
                    <SolidColorBrush x:Key="DotPad.Dump.TableHeaderForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DotPad.Dump.TableBorderBrush"           Color="#3C3C3C" />
                    <SolidColorBrush x:Key="DotPad.Dump.TableEvenRowBrush"          Color="#252525" />
                    <SolidColorBrush x:Key="DotPad.Dump.StringBrush"                Color="#CE9178" />
                    <SolidColorBrush x:Key="DotPad.Dump.NumberBrush"                Color="#B5CEA8" />
                    <SolidColorBrush x:Key="DotPad.Dump.BoolBrush"                  Color="#569CD6" />
                    <SolidColorBrush x:Key="DotPad.Dump.EnumBrush"                  Color="#4EC9B0" />
                    <SolidColorBrush x:Key="DotPad.Dump.DateTimeBrush"              Color="#C8A0D4" />
                    <SolidColorBrush x:Key="DotPad.Dump.PropertyNameBrush"          Color="#9CDCFE" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
