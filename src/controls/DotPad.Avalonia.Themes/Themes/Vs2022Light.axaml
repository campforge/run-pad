<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="using:DotPad.Avalonia.Themes">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="{x:Static themes:DotPadThemeVariants.Vs2022Light}">
                    <SolidColorBrush x:Key="DotPad.Sidebar.BackgroundBrush"           Color="#F5F5F5" />
                    <SolidColorBrush x:Key="DotPad.Toolbar.BackgroundBrush"           Color="#EEEEF2" />
                    <SolidColorBrush x:Key="DotPad.Toolbar.BorderBrush"               Color="#CCCEDB" />
                    <SolidColorBrush x:Key="DotPad.Editor.BackgroundBrush"            Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DotPad.Editor.SelectionBrush"             Color="#ADD6FF" />
                    <SolidColorBrush x:Key="DotPad.Output.BackgroundBrush"            Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DotPad.Output.ErrorForeground"            Color="#CC0000" />
                    <SolidColorBrush x:Key="DotPad.Output.StackTraceForeground"       Color="#A31515" />
                    <SolidColorBrush x:Key="DotPad.Panel.BackgroundBrush"             Color="#F5F5F5" />
                    <SolidColorBrush x:Key="DotPad.StatusBar.BackgroundBrush"         Color="#68217A" />
                    <SolidColorBrush x:Key="DotPad.StatusBar.ForegroundBrush"         Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DotPad.StatusBar.DebuggingBrush"          Color="#CA5100" />
                    <SolidColorBrush x:Key="DotPad.Status.RunningBrush"               Color="#4FC1FF" />
                    <SolidColorBrush x:Key="DotPad.Status.CancelledBrush"             Color="#9E9E9E" />
                    <SolidColorBrush x:Key="DotPad.Status.SuccessBrush"               Color="#4EC94E" />
                    <SolidColorBrush x:Key="DotPad.Status.ErrorBrush"                 Color="#F14C4C" />
                    <SolidColorBrush x:Key="DotPad.Status.PausedBrush"                Color="#FFA500" />
                    <SolidColorBrush x:Key="DotPad.Separator.BackgroundBrush"         Color="#CCCEDB" />
                    <SolidColorBrush x:Key="DotPad.Border.BackgroundBrush"            Color="#CCCEDB" />
                    <SolidColorBrush x:Key="DotPad.Text.PrimaryBrush"                 Color="#1E1E1E" />
                    <SolidColorBrush x:Key="DotPad.Text.SecondaryBrush"               Color="#717171" />
                    <SolidColorBrush x:Key="DotPad.Accent.BackgroundBrush"            Color="#ADD6FF" />
                    <SolidColorBrush x:Key="DotPad.Accent.ForegroundBrush"            Color="#000000" />
                    <SolidColorBrush x:Key="DotPad.Tab.AccentBrush"                    Color="#68217A" />
                    <Color             x:Key="DotPad.Tab.AccentColor"                               >#68217A</Color>
                    <SolidColorBrush x:Key="DotPad.Toolbar.Button.HoverBrush"         Color="#C9DEF5" />
                    <SolidColorBrush x:Key="DotPad.Icon.PlayBrush"                    Color="#2A7E2A" />
                    <SolidColorBrush x:Key="DotPad.Icon.StopBrush"                    Color="#C00000" />
                    <SolidColorBrush x:Key="DotPad.Icon.DebugBrush"                   Color="#C25800" />
                    <SolidColorBrush x:Key="DotPad.Icon.PauseBrush"                   Color="#C25800" />
                    <SolidColorBrush x:Key="DotPad.Icon.StepBrush"                    Color="#0066B8" />
                    <SolidColorBrush x:Key="DotPad.Icon.DisabledBrush"               Color="#AAAAAA" />
                    <SolidColorBrush x:Key="DotPad.Margin.BreakpointBrush"           Color="#CC0000" />
                    <SolidColorBrush x:Key="DotPad.Margin.BreakpointVerifiedBrush"   Color="#2E7D32" />
                    <SolidColorBrush x:Key="DotPad.Margin.BreakpointUnverifiedBrush" Color="#B8860B" />
                    <SolidColorBrush x:Key="DotPad.Margin.BreakpointPreviewBrush"    Color="#AA7070" />
                    <SolidColorBrush x:Key="DotPad.Margin.DebugArrowBrush"           Color="#E8B400" />
                    <SolidColorBrush x:Key="DotPad.Margin.DebugLineBrush"            Color="#50FFEE00" />
                    <SolidColorBrush x:Key="DotPad.Folding.ChevronBrush"            Color="#ABABAB" />
                    <SolidColorBrush x:Key="DotPad.Folding.ChevronHoverBrush"       Color="#555555" />
                    <SolidColorBrush x:Key="DotPad.Folding.LineBrush"               Color="#DEDEDE" />
                    <SolidColorBrush x:Key="DotPad.Dump.TableHeaderBrush"           Color="#0066B8" />
                    <SolidColorBrush x:Key="DotPad.Dump.TableHeaderForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DotPad.Dump.TableBorderBrush"           Color="#ADBAD0" />
                    <SolidColorBrush x:Key="DotPad.Dump.TableEvenRowBrush"          Color="#EDF3FD" />
                    <SolidColorBrush x:Key="DotPad.Dump.StringBrush"                Color="#A31515" />
                    <SolidColorBrush x:Key="DotPad.Dump.NumberBrush"                Color="#098658" />
                    <SolidColorBrush x:Key="DotPad.Dump.BoolBrush"                  Color="#0000CC" />
                    <SolidColorBrush x:Key="DotPad.Dump.EnumBrush"                  Color="#267F99" />
                    <SolidColorBrush x:Key="DotPad.Dump.DateTimeBrush"              Color="#7B3FA0" />
                    <SolidColorBrush x:Key="DotPad.Dump.PropertyNameBrush"          Color="#0F4A8A" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
