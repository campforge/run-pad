<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="using:Invoklet.Avalonia.Themes">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="{x:Static themes:InvokletThemeVariants.Vs2022Light}">
                    <SolidColorBrush x:Key="Invoklet.Sidebar.BackgroundBrush"           Color="#F5F5F5" />
                    <SolidColorBrush x:Key="Invoklet.Toolbar.BackgroundBrush"           Color="#EEEEF2" />
                    <SolidColorBrush x:Key="Invoklet.TitleBar.BackgroundBrush"          Color="#F5F5F5" />
                    <SolidColorBrush x:Key="Invoklet.Toolbar.BorderBrush"               Color="#CCCEDB" />
                    <SolidColorBrush x:Key="Invoklet.Editor.BackgroundBrush"            Color="#FFFFFF" />
                    <SolidColorBrush x:Key="Invoklet.Editor.SelectionBrush"             Color="#ADD6FF" />
                    <SolidColorBrush x:Key="Invoklet.Output.BackgroundBrush"            Color="#FFFFFF" />
                    <SolidColorBrush x:Key="Invoklet.Output.ErrorForeground"            Color="#CC0000" />
                    <SolidColorBrush x:Key="Invoklet.Output.StackTraceForeground"       Color="#A31515" />
                    <SolidColorBrush x:Key="Invoklet.Panel.BackgroundBrush"             Color="#F5F5F5" />
                    <SolidColorBrush x:Key="Invoklet.StatusBar.BackgroundBrush"         Color="#F5F5F5" />
                    <SolidColorBrush x:Key="Invoklet.StatusBar.ForegroundBrush"         Color="#1E1E1E" />
                    <SolidColorBrush x:Key="Invoklet.Status.RunningBrush"               Color="#005FB8" />
                    <SolidColorBrush x:Key="Invoklet.Status.CancelledBrush"             Color="#62666C" />
                    <SolidColorBrush x:Key="Invoklet.Status.SuccessBrush"               Color="#23723B" />
                    <SolidColorBrush x:Key="Invoklet.Status.ErrorBrush"                 Color="#B42332" />
                    <SolidColorBrush x:Key="Invoklet.Status.PausedBrush"                Color="#895200" />
                    <SolidColorBrush x:Key="Invoklet.Separator.BackgroundBrush"         Color="#CCCEDB" />
                    <SolidColorBrush x:Key="Invoklet.Border.BackgroundBrush"            Color="#CCCEDB" />
                    <SolidColorBrush x:Key="Invoklet.Text.PrimaryBrush"                 Color="#1E1E1E" />
                    <!-- Fluent's menu popups: a menu bar's dropdowns and submenus draw their own border with these. -->
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#F5F5F5" />
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#CCCEDB" />
                    <!-- Fluent's ComboBox dropdown: the same surface as the menus. -->
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#F5F5F5" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#CCCEDB" />
                    <!-- Fluent's plain buttons (and DropDownButton): the secondary button's surface. -->
                    <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#C9DEF5" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#EEEEF2" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#CCCEDB" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#CCCEDB" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#CCCEDB" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#CCCEDB" />
                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#6F6F6F" />
                    <!-- Fluent's Expander ("Storage and usage"): the panel surface for its header, the editor's for its content. -->
                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#F5F5F5" />
                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#C9DEF5" />
                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="#EEEEF2" />
                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundDisabled" Color="#F5F5F5" />
                    <SolidColorBrush x:Key="ExpanderHeaderForeground" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="ExpanderHeaderForegroundPointerOver" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="ExpanderHeaderForegroundPressed" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="ExpanderHeaderForegroundDisabled" Color="#6F6F6F" />
                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#CCCEDB" />
                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="#CCCEDB" />
                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="#CCCEDB" />
                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrushDisabled" Color="#CCCEDB" />
                    <SolidColorBrush x:Key="ExpanderChevronForeground" Color="#6F6F6F" />
                    <SolidColorBrush x:Key="ExpanderChevronForegroundPointerOver" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="ExpanderChevronForegroundPressed" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="ExpanderChevronForegroundDisabled" Color="#6F6F6F" />
                    <SolidColorBrush x:Key="ExpanderContentBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#CCCEDB" />
                    <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPressed" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="#6F6F6F" />
                    <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundDisabled" Color="#6F6F6F" />
                    <SolidColorBrush x:Key="Invoklet.Text.SecondaryBrush"               Color="#6F6F6F" />
                    <SolidColorBrush x:Key="Invoklet.Accent.BackgroundBrush"            Color="#ADD6FF" />
                    <SolidColorBrush x:Key="Invoklet.Accent.ForegroundBrush"            Color="#000000" />
                    <SolidColorBrush x:Key="Invoklet.ToolTab.SelectedBackgroundBrush" Color="#E1D7E4" />
                    <SolidColorBrush x:Key="Invoklet.ToolTab.SelectedForegroundBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="Invoklet.ToolTab.SelectedBorderBrush" Color="#AE8BB8" />
                    <!-- Default (primary) dialog button: white text at least 4.5:1 in every state. -->
                    <SolidColorBrush x:Key="Invoklet.Button.Primary.BackgroundBrush"     Color="#68217A" />
                    <SolidColorBrush x:Key="Invoklet.Button.Primary.HoverBrush"          Color="#5A1D6A" />
                    <SolidColorBrush x:Key="Invoklet.Button.Primary.PressedBrush"        Color="#4D185A" />
                    <SolidColorBrush x:Key="Invoklet.Button.Primary.ForegroundBrush"     Color="#FFFFFF" />
                    <!-- Shared keyboard-focus ring; independent of selection and primary actions. -->
                    <SolidColorBrush x:Key="Invoklet.Focus.BorderBrush"                  Color="#68217A" />
                    <SolidColorBrush x:Key="Invoklet.Focus.ContrastBrush"                Color="#FFFFFF" />
                    <Thickness        x:Key="Invoklet.Focus.Thickness">2</Thickness>
                    <Thickness        x:Key="Invoklet.Focus.ContrastThickness">1</Thickness>
                    <CornerRadius     x:Key="Invoklet.Focus.CornerRadius">4</CornerRadius>
                    <CornerRadius     x:Key="Invoklet.Focus.InnerCornerRadius">2</CornerRadius>
                    <SolidColorBrush x:Key="Invoklet.Tab.AccentBrush"                    Color="#68217A" />
                    <Color             x:Key="Invoklet.Tab.AccentColor"                               >#68217A</Color>
                    <SolidColorBrush x:Key="Invoklet.Tab.DirtyBrush"                     Color="#B8860B" />
                    <SolidColorBrush x:Key="Invoklet.Toolbar.Button.HoverBrush"         Color="#C9DEF5" />
                    <SolidColorBrush x:Key="Invoklet.Icon.PlayBrush"                    Color="#2A7E2A" />
                    <SolidColorBrush x:Key="Invoklet.Icon.StopBrush"                    Color="#C00000" />
                    <SolidColorBrush x:Key="Invoklet.Icon.DebugBrush"                   Color="#C25800" />
                    <SolidColorBrush x:Key="Invoklet.Icon.StepBrush"                    Color="#0066B8" />
                    <SolidColorBrush x:Key="Invoklet.Icon.DisabledBrush"               Color="#AAAAAA" />
                    <SolidColorBrush x:Key="Invoklet.Margin.BreakpointBrush"           Color="#CC0000" />
                    <SolidColorBrush x:Key="Invoklet.Margin.BreakpointVerifiedBrush"   Color="#2E7D32" />
                    <SolidColorBrush x:Key="Invoklet.Margin.BreakpointUnverifiedBrush" Color="#B8860B" />
                    <SolidColorBrush x:Key="Invoklet.Margin.BreakpointPreviewBrush"    Color="#AA7070" />
                    <SolidColorBrush x:Key="Invoklet.Margin.BreakpointConditionBadgeBrush" Color="#8A5FBF" />
                    <SolidColorBrush x:Key="Invoklet.Margin.DebugArrowBrush"           Color="#E8B400" />
                    <SolidColorBrush x:Key="Invoklet.Margin.DebugLineBrush"            Color="#50FFEE00" />
                    <SolidColorBrush x:Key="Invoklet.Margin.LineNumberBrush"          Color="#A6A6A6" />
                    <SolidColorBrush x:Key="Invoklet.Margin.CodeFixErrorBrush"     Color="#F14C4C" />
                    <SolidColorBrush x:Key="Invoklet.Margin.CodeFixWarningBrush"   Color="#B8860B" />
                    <SolidColorBrush x:Key="Invoklet.Folding.ChevronBrush"            Color="#ABABAB" />
                    <SolidColorBrush x:Key="Invoklet.Folding.ChevronHoverBrush"       Color="#555555" />
                    <SolidColorBrush x:Key="Invoklet.Folding.LineBrush"               Color="#DEDEDE" />
                    <SolidColorBrush x:Key="Invoklet.Margin.CurrentLineBrush"          Color="#0D000000" />
                    <SolidColorBrush x:Key="Invoklet.Editor.BraceMatchBrush"           Color="#3D8E5BC8" />
                    <SolidColorBrush x:Key="Invoklet.Editor.BraceMismatchBrush"        Color="#40DC3C3C" />
                    <SolidColorBrush x:Key="Invoklet.Editor.ActiveScopeGuideBrush"     Color="#9A72C9" />
                    <SolidColorBrush x:Key="Invoklet.Dump.TableHeaderBrush"           Color="#0066B8" />
                    <SolidColorBrush x:Key="Invoklet.Dump.TableHeaderForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="Invoklet.Dump.TableBorderBrush"           Color="#ADBAD0" />
                    <SolidColorBrush x:Key="Invoklet.Dump.TableEvenRowBrush"          Color="#EDF3FD" />
                    <SolidColorBrush x:Key="Invoklet.Dump.StringBrush"                Color="#A31515" />
                    <SolidColorBrush x:Key="Invoklet.Dump.NumberBrush"                Color="#098658" />
                    <SolidColorBrush x:Key="Invoklet.Dump.BoolBrush"                  Color="#0000CC" />
                    <SolidColorBrush x:Key="Invoklet.Dump.EnumBrush"                  Color="#267F99" />
                    <SolidColorBrush x:Key="Invoklet.Dump.DateTimeBrush"              Color="#7B3FA0" />
                    <SolidColorBrush x:Key="Invoklet.Dump.PropertyNameBrush"          Color="#0F4A8A" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
