<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="using:Invoklet.Avalonia.Themes">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="{x:Static themes:InvokletThemeVariants.VsCodeLight}">
                    <SolidColorBrush x:Key="Invoklet.Sidebar.BackgroundBrush"           Color="#F3F3F3" />
                    <SolidColorBrush x:Key="Invoklet.Toolbar.BackgroundBrush"           Color="#F3F3F3" />
                    <SolidColorBrush x:Key="Invoklet.TitleBar.BackgroundBrush"          Color="#F3F3F3" />
                    <SolidColorBrush x:Key="Invoklet.Toolbar.BorderBrush"               Color="#E7E7E7" />
                    <SolidColorBrush x:Key="Invoklet.Editor.BackgroundBrush"            Color="#FFFFFF" />
                    <SolidColorBrush x:Key="Invoklet.Editor.SelectionBrush"             Color="#ADD6FF" />
                    <SolidColorBrush x:Key="Invoklet.Output.BackgroundBrush"            Color="#FFFFFF" />
                    <SolidColorBrush x:Key="Invoklet.Output.ErrorForeground"            Color="#CC0000" />
                    <SolidColorBrush x:Key="Invoklet.Output.StackTraceForeground"       Color="#A31515" />
                    <SolidColorBrush x:Key="Invoklet.Panel.BackgroundBrush"             Color="#F3F3F3" />
                    <SolidColorBrush x:Key="Invoklet.StatusBar.BackgroundBrush"         Color="#F3F3F3" />
                    <SolidColorBrush x:Key="Invoklet.StatusBar.ForegroundBrush"         Color="#383838" />
                    <SolidColorBrush x:Key="Invoklet.Status.RunningBrush"               Color="#005FB8" />
                    <SolidColorBrush x:Key="Invoklet.Status.CancelledBrush"             Color="#62666C" />
                    <SolidColorBrush x:Key="Invoklet.Status.SuccessBrush"               Color="#23723B" />
                    <SolidColorBrush x:Key="Invoklet.Status.ErrorBrush"                 Color="#B42332" />
                    <SolidColorBrush x:Key="Invoklet.Status.PausedBrush"                Color="#895200" />
                    <SolidColorBrush x:Key="Invoklet.Separator.BackgroundBrush"         Color="#E7E7E7" />
                    <SolidColorBrush x:Key="Invoklet.Border.BackgroundBrush"            Color="#DDDDDD" />
                    <SolidColorBrush x:Key="Invoklet.Text.PrimaryBrush"                 Color="#383838" />
                    <!-- Fluent's menu popups: a menu bar's dropdowns and submenus draw their own border with these. -->
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#DDDDDD" />
                    <!-- Fluent's ComboBox dropdown: the same surface as the menus. -->
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#DDDDDD" />
                    <!-- Fluent's plain buttons (and DropDownButton): the secondary button's surface. -->
                    <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E0E0E0" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#DDDDDD" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#DDDDDD" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#DDDDDD" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#383838" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#383838" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#383838" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#DDDDDD" />
                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#6D6D6D" />
                    <!-- Fluent's Expander ("Storage and usage"): the panel surface for its header, the editor's for its content. -->
                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#E0E0E0" />
                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundDisabled" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="ExpanderHeaderForeground" Color="#383838" />
                    <SolidColorBrush x:Key="ExpanderHeaderForegroundPointerOver" Color="#383838" />
                    <SolidColorBrush x:Key="ExpanderHeaderForegroundPressed" Color="#383838" />
                    <SolidColorBrush x:Key="ExpanderHeaderForegroundDisabled" Color="#6D6D6D" />
                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#DDDDDD" />
                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="#DDDDDD" />
                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="#DDDDDD" />
                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrushDisabled" Color="#DDDDDD" />
                    <SolidColorBrush x:Key="ExpanderChevronForeground" Color="#6D6D6D" />
                    <SolidColorBrush x:Key="ExpanderChevronForegroundPointerOver" Color="#383838" />
                    <SolidColorBrush x:Key="ExpanderChevronForegroundPressed" Color="#383838" />
                    <SolidColorBrush x:Key="ExpanderChevronForegroundDisabled" Color="#6D6D6D" />
                    <SolidColorBrush x:Key="ExpanderContentBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#DDDDDD" />
                    <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#383838" />
                    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#383838" />
                    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="#383838" />
                    <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="#383838" />
                    <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver" Color="#383838" />
                    <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPressed" Color="#383838" />
                    <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="#6D6D6D" />
                    <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundDisabled" Color="#6D6D6D" />
                    <SolidColorBrush x:Key="Invoklet.Text.SecondaryBrush"               Color="#6D6D6D" />
                    <SolidColorBrush x:Key="Invoklet.Accent.BackgroundBrush"            Color="#C8EBFB" />
                    <SolidColorBrush x:Key="Invoklet.Accent.ForegroundBrush"            Color="#005FB8" />
                    <SolidColorBrush x:Key="Invoklet.ToolTab.SelectedBackgroundBrush" Color="#D1DEEB" />
                    <SolidColorBrush x:Key="Invoklet.ToolTab.SelectedForegroundBrush" Color="#383838" />
                    <SolidColorBrush x:Key="Invoklet.ToolTab.SelectedBorderBrush" Color="#7AA9D6" />
                    <!-- Default (primary) dialog button: white text at least 4.5:1 in every state. -->
                    <SolidColorBrush x:Key="Invoklet.Button.Primary.BackgroundBrush"     Color="#0078C9" />
                    <SolidColorBrush x:Key="Invoklet.Button.Primary.HoverBrush"          Color="#006CB5" />
                    <SolidColorBrush x:Key="Invoklet.Button.Primary.PressedBrush"        Color="#0060A0" />
                    <SolidColorBrush x:Key="Invoklet.Button.Primary.ForegroundBrush"     Color="#FFFFFF" />
                    <SolidColorBrush x:Key="Invoklet.Button.Secondary.BorderBrush"     Color="#ACACAC" />
                    <!-- Shared keyboard-focus ring; independent of selection and primary actions. -->
                    <SolidColorBrush x:Key="Invoklet.Focus.BorderBrush"                  Color="#005FB8" />
                    <SolidColorBrush x:Key="Invoklet.Focus.ContrastBrush"                Color="#FFFFFF" />
                    <Thickness        x:Key="Invoklet.Focus.Thickness">2</Thickness>
                    <Thickness        x:Key="Invoklet.Focus.ContrastThickness">1</Thickness>
                    <CornerRadius     x:Key="Invoklet.Focus.CornerRadius">4</CornerRadius>
                    <CornerRadius     x:Key="Invoklet.Focus.InnerCornerRadius">2</CornerRadius>
                    <SolidColorBrush x:Key="Invoklet.Tab.AccentBrush"                    Color="#007ACC" />
                    <Color             x:Key="Invoklet.Tab.AccentColor"                               >#007ACC</Color>
                    <SolidColorBrush x:Key="Invoklet.Tab.DirtyBrush"                     Color="#BF8803" />
                    <SolidColorBrush x:Key="Invoklet.Toolbar.Button.HoverBrush"         Color="#E0E0E0" />
                    <SolidColorBrush x:Key="Invoklet.Icon.PlayBrush"                    Color="#26862B" />
                    <SolidColorBrush x:Key="Invoklet.Icon.StopBrush"                    Color="#B80000" />
                    <SolidColorBrush x:Key="Invoklet.Icon.DebugBrush"                   Color="#C26500" />
                    <SolidColorBrush x:Key="Invoklet.Icon.StepBrush"                    Color="#006BB3" />
                    <SolidColorBrush x:Key="Invoklet.Icon.DisabledBrush"               Color="#AAAAAA" />
                    <SolidColorBrush x:Key="Invoklet.Margin.BreakpointBrush"           Color="#CC0000" />
                    <SolidColorBrush x:Key="Invoklet.Margin.BreakpointVerifiedBrush"   Color="#388A34" />
                    <SolidColorBrush x:Key="Invoklet.Margin.BreakpointUnverifiedBrush" Color="#BF8803" />
                    <SolidColorBrush x:Key="Invoklet.Margin.BreakpointPreviewBrush"    Color="#AA7070" />
                    <SolidColorBrush x:Key="Invoklet.Margin.BreakpointConditionBadgeBrush" Color="#8A5FBF" />
                    <SolidColorBrush x:Key="Invoklet.Margin.DebugArrowBrush"           Color="#E8B400" />
                    <SolidColorBrush x:Key="Invoklet.Margin.DebugLineBrush"            Color="#4CFFFF00" />
                    <SolidColorBrush x:Key="Invoklet.Margin.LineNumberBrush"          Color="#9E9E9E" />
                    <SolidColorBrush x:Key="Invoklet.Margin.CodeFixErrorBrush"     Color="#F14C4C" />
                    <SolidColorBrush x:Key="Invoklet.Margin.CodeFixWarningBrush"   Color="#BF8803" />
                    <SolidColorBrush x:Key="Invoklet.Folding.ChevronBrush"            Color="#9D9D9D" />
                    <SolidColorBrush x:Key="Invoklet.Folding.ChevronHoverBrush"       Color="#424242" />
                    <SolidColorBrush x:Key="Invoklet.Folding.LineBrush"               Color="#D3D3D3" />
                    <SolidColorBrush x:Key="Invoklet.Margin.CurrentLineBrush"          Color="#0D000000" />
                    <SolidColorBrush x:Key="Invoklet.Editor.BraceMatchBrush"           Color="#3D8E5BC8" />
                    <SolidColorBrush x:Key="Invoklet.Editor.BraceMismatchBrush"        Color="#40DC3C3C" />
                    <SolidColorBrush x:Key="Invoklet.Editor.ActiveScopeGuideBrush"     Color="#9A72C9" />
                    <SolidColorBrush x:Key="Invoklet.Dump.TableHeaderBrush"           Color="#0066B3" />
                    <SolidColorBrush x:Key="Invoklet.Dump.TableHeaderForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="Invoklet.Dump.TableBorderBrush"           Color="#B0B8C8" />
                    <SolidColorBrush x:Key="Invoklet.Dump.TableEvenRowBrush"          Color="#EDF2FB" />
                    <SolidColorBrush x:Key="Invoklet.Dump.StringBrush"                Color="#A31515" />
                    <SolidColorBrush x:Key="Invoklet.Dump.NumberBrush"                Color="#098658" />
                    <SolidColorBrush x:Key="Invoklet.Dump.BoolBrush"                  Color="#0000CC" />
                    <SolidColorBrush x:Key="Invoklet.Dump.EnumBrush"                  Color="#267F99" />
                    <SolidColorBrush x:Key="Invoklet.Dump.DateTimeBrush"              Color="#7B3FA0" />
                    <SolidColorBrush x:Key="Invoklet.Dump.PropertyNameBrush"          Color="#0F4A8A" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
