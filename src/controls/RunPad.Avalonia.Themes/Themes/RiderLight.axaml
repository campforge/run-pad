<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="using:RunPad.Avalonia.Themes">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <!-- JetBrains Rider New UI — Light -->
                <ResourceDictionary x:Key="{x:Static themes:RunPadThemeVariants.RiderLight}">
                    <SolidColorBrush x:Key="RunPad.Sidebar.BackgroundBrush"           Color="#ECECEC" />
                    <SolidColorBrush x:Key="RunPad.Toolbar.BackgroundBrush"           Color="#EBEBEB" />
                    <SolidColorBrush x:Key="RunPad.Toolbar.BorderBrush"               Color="#CBCBCB" />
                    <SolidColorBrush x:Key="RunPad.Editor.BackgroundBrush"            Color="#FFFFFF" />
                    <SolidColorBrush x:Key="RunPad.Editor.SelectionBrush"             Color="#BDD5F5" />
                    <SolidColorBrush x:Key="RunPad.Output.BackgroundBrush"            Color="#FFFFFF" />
                    <SolidColorBrush x:Key="RunPad.Output.ErrorForeground"            Color="#CC0000" />
                    <SolidColorBrush x:Key="RunPad.Output.StackTraceForeground"       Color="#A31515" />
                    <SolidColorBrush x:Key="RunPad.Panel.BackgroundBrush"             Color="#F5F5F5" />
                    <SolidColorBrush x:Key="RunPad.StatusBar.BackgroundBrush"         Color="#EBEBEB" />
                    <SolidColorBrush x:Key="RunPad.StatusBar.ForegroundBrush"         Color="#6C6C6C" />
                    <SolidColorBrush x:Key="RunPad.Status.RunningBrush"               Color="#0078D4" />
                    <SolidColorBrush x:Key="RunPad.Status.CancelledBrush"             Color="#767676" />
                    <SolidColorBrush x:Key="RunPad.Status.SuccessBrush"               Color="#267F26" />
                    <SolidColorBrush x:Key="RunPad.Status.ErrorBrush"                 Color="#D00000" />
                    <SolidColorBrush x:Key="RunPad.Status.PausedBrush"                Color="#B35C00" />
                    <SolidColorBrush x:Key="RunPad.Separator.BackgroundBrush"         Color="#DBDBDB" />
                    <SolidColorBrush x:Key="RunPad.Border.BackgroundBrush"            Color="#CBCBCB" />
                    <SolidColorBrush x:Key="RunPad.Text.PrimaryBrush"                 Color="#1A1A1A" />
                    <SolidColorBrush x:Key="RunPad.Text.SecondaryBrush"               Color="#696969" />
                    <SolidColorBrush x:Key="RunPad.Accent.BackgroundBrush"            Color="#BDD5F5" />
                    <SolidColorBrush x:Key="RunPad.Accent.ForegroundBrush"            Color="#2470B3" />
                    <SolidColorBrush x:Key="RunPad.Tab.AccentBrush"                    Color="#2470B3" />
                    <Color             x:Key="RunPad.Tab.AccentColor"                               >#2470B3</Color>
                    <SolidColorBrush x:Key="RunPad.Tab.DirtyBrush"                     Color="#B8860B" />
                    <SolidColorBrush x:Key="RunPad.Toolbar.Button.HoverBrush"         Color="#D8D8D8" />
                    <SolidColorBrush x:Key="RunPad.Icon.PlayBrush"                    Color="#267F26" />
                    <SolidColorBrush x:Key="RunPad.Icon.StopBrush"                    Color="#C50000" />
                    <SolidColorBrush x:Key="RunPad.Icon.DebugBrush"                   Color="#B35C00" />
                    <SolidColorBrush x:Key="RunPad.Icon.StepBrush"                    Color="#1060C0" />
                    <SolidColorBrush x:Key="RunPad.Icon.DisabledBrush"               Color="#A8A8A8" />
                    <SolidColorBrush x:Key="RunPad.Margin.BreakpointBrush"           Color="#D9001B" />
                    <SolidColorBrush x:Key="RunPad.Margin.BreakpointVerifiedBrush"   Color="#2E8B3D" />
                    <SolidColorBrush x:Key="RunPad.Margin.BreakpointUnverifiedBrush" Color="#B8860B" />
                    <SolidColorBrush x:Key="RunPad.Margin.BreakpointPreviewBrush"    Color="#AA7070" />
                    <SolidColorBrush x:Key="RunPad.Margin.BreakpointConditionBadgeBrush" Color="#8A5FBF" />
                    <SolidColorBrush x:Key="RunPad.Margin.DebugArrowBrush"           Color="#E8B400" />
                    <SolidColorBrush x:Key="RunPad.Margin.DebugLineBrush"            Color="#50FFFF00" />
                    <SolidColorBrush x:Key="RunPad.Margin.LineNumberBrush"          Color="#A6A6A6" />
                    <SolidColorBrush x:Key="RunPad.Margin.CodeFixErrorBrush"     Color="#D00000" />
                    <SolidColorBrush x:Key="RunPad.Margin.CodeFixWarningBrush"   Color="#B8860B" />
                    <SolidColorBrush x:Key="RunPad.Folding.ChevronBrush"            Color="#ABABAB" />
                    <SolidColorBrush x:Key="RunPad.Folding.ChevronHoverBrush"       Color="#565656" />
                    <SolidColorBrush x:Key="RunPad.Folding.LineBrush"               Color="#D8D8D8" />
                    <SolidColorBrush x:Key="RunPad.Margin.CurrentLineBrush"          Color="#0D000000" />
                    <SolidColorBrush x:Key="RunPad.Editor.BraceMatchBrush"           Color="#3D8E5BC8" />
                    <SolidColorBrush x:Key="RunPad.Editor.BraceMismatchBrush"        Color="#40DC3C3C" />
                    <SolidColorBrush x:Key="RunPad.Editor.ActiveScopeGuideBrush"     Color="#9A72C9" />
                    <SolidColorBrush x:Key="RunPad.Dump.TableHeaderBrush"           Color="#1060C0" />
                    <SolidColorBrush x:Key="RunPad.Dump.TableHeaderForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="RunPad.Dump.TableBorderBrush"           Color="#B8BFCC" />
                    <SolidColorBrush x:Key="RunPad.Dump.TableEvenRowBrush"          Color="#EDF4FD" />
                    <SolidColorBrush x:Key="RunPad.Dump.StringBrush"                Color="#A31515" />
                    <SolidColorBrush x:Key="RunPad.Dump.NumberBrush"                Color="#098658" />
                    <SolidColorBrush x:Key="RunPad.Dump.BoolBrush"                  Color="#1060C0" />
                    <SolidColorBrush x:Key="RunPad.Dump.EnumBrush"                  Color="#267F99" />
                    <SolidColorBrush x:Key="RunPad.Dump.DateTimeBrush"              Color="#7B3FA0" />
                    <SolidColorBrush x:Key="RunPad.Dump.PropertyNameBrush"          Color="#0F4A8A" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
