<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="using:RunPad.Avalonia.Themes">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="{x:Static themes:RunPadThemeVariants.VsCodeLight}">
                    <SolidColorBrush x:Key="RunPad.Sidebar.BackgroundBrush"           Color="#F3F3F3" />
                    <SolidColorBrush x:Key="RunPad.Toolbar.BackgroundBrush"           Color="#F3F3F3" />
                    <SolidColorBrush x:Key="RunPad.TitleBar.BackgroundBrush"          Color="#F3F3F3" />
                    <SolidColorBrush x:Key="RunPad.Toolbar.BorderBrush"               Color="#E7E7E7" />
                    <SolidColorBrush x:Key="RunPad.Editor.BackgroundBrush"            Color="#FFFFFF" />
                    <SolidColorBrush x:Key="RunPad.Editor.SelectionBrush"             Color="#ADD6FF" />
                    <SolidColorBrush x:Key="RunPad.Output.BackgroundBrush"            Color="#FFFFFF" />
                    <SolidColorBrush x:Key="RunPad.Output.ErrorForeground"            Color="#CC0000" />
                    <SolidColorBrush x:Key="RunPad.Output.StackTraceForeground"       Color="#A31515" />
                    <SolidColorBrush x:Key="RunPad.Panel.BackgroundBrush"             Color="#F3F3F3" />
                    <SolidColorBrush x:Key="RunPad.StatusBar.BackgroundBrush"         Color="#F3F3F3" />
                    <SolidColorBrush x:Key="RunPad.StatusBar.ForegroundBrush"         Color="#383838" />
                    <SolidColorBrush x:Key="RunPad.Status.RunningBrush"               Color="#005FB8" />
                    <SolidColorBrush x:Key="RunPad.Status.CancelledBrush"             Color="#62666C" />
                    <SolidColorBrush x:Key="RunPad.Status.SuccessBrush"               Color="#23723B" />
                    <SolidColorBrush x:Key="RunPad.Status.ErrorBrush"                 Color="#B42332" />
                    <SolidColorBrush x:Key="RunPad.Status.PausedBrush"                Color="#895200" />
                    <SolidColorBrush x:Key="RunPad.Separator.BackgroundBrush"         Color="#E7E7E7" />
                    <SolidColorBrush x:Key="RunPad.Border.BackgroundBrush"            Color="#DDDDDD" />
                    <SolidColorBrush x:Key="RunPad.Text.PrimaryBrush"                 Color="#383838" />
                    <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#383838" />
                    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#383838" />
                    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="#383838" />
                    <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="#383838" />
                    <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver" Color="#383838" />
                    <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPressed" Color="#383838" />
                    <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="#6D6D6D" />
                    <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundDisabled" Color="#6D6D6D" />
                    <SolidColorBrush x:Key="RunPad.Text.SecondaryBrush"               Color="#6D6D6D" />
                    <SolidColorBrush x:Key="RunPad.Accent.BackgroundBrush"            Color="#C8EBFB" />
                    <SolidColorBrush x:Key="RunPad.Accent.ForegroundBrush"            Color="#005FB8" />
                    <SolidColorBrush x:Key="RunPad.ToolTab.SelectedBackgroundBrush" Color="#D1DEEB" />
                    <SolidColorBrush x:Key="RunPad.ToolTab.SelectedForegroundBrush" Color="#383838" />
                    <SolidColorBrush x:Key="RunPad.ToolTab.SelectedBorderBrush" Color="#7AA9D6" />
                    <!-- Default (primary) dialog button: white text at least 4.5:1 in every state. -->
                    <SolidColorBrush x:Key="RunPad.Button.Primary.BackgroundBrush"     Color="#0078C9" />
                    <SolidColorBrush x:Key="RunPad.Button.Primary.HoverBrush"          Color="#006CB5" />
                    <SolidColorBrush x:Key="RunPad.Button.Primary.PressedBrush"        Color="#0060A0" />
                    <SolidColorBrush x:Key="RunPad.Button.Primary.ForegroundBrush"     Color="#FFFFFF" />
                    <!-- Shared keyboard-focus ring; independent of selection and primary actions. -->
                    <SolidColorBrush x:Key="RunPad.Focus.BorderBrush"                  Color="#005FB8" />
                    <SolidColorBrush x:Key="RunPad.Focus.ContrastBrush"                Color="#FFFFFF" />
                    <Thickness        x:Key="RunPad.Focus.Thickness">2</Thickness>
                    <Thickness        x:Key="RunPad.Focus.ContrastThickness">1</Thickness>
                    <CornerRadius     x:Key="RunPad.Focus.CornerRadius">4</CornerRadius>
                    <CornerRadius     x:Key="RunPad.Focus.InnerCornerRadius">2</CornerRadius>
                    <SolidColorBrush x:Key="RunPad.Tab.AccentBrush"                    Color="#007ACC" />
                    <Color             x:Key="RunPad.Tab.AccentColor"                               >#007ACC</Color>
                    <SolidColorBrush x:Key="RunPad.Tab.DirtyBrush"                     Color="#BF8803" />
                    <SolidColorBrush x:Key="RunPad.Toolbar.Button.HoverBrush"         Color="#E0E0E0" />
                    <SolidColorBrush x:Key="RunPad.Icon.PlayBrush"                    Color="#26862B" />
                    <SolidColorBrush x:Key="RunPad.Icon.StopBrush"                    Color="#B80000" />
                    <SolidColorBrush x:Key="RunPad.Icon.DebugBrush"                   Color="#C26500" />
                    <SolidColorBrush x:Key="RunPad.Icon.StepBrush"                    Color="#006BB3" />
                    <SolidColorBrush x:Key="RunPad.Icon.DisabledBrush"               Color="#AAAAAA" />
                    <SolidColorBrush x:Key="RunPad.Margin.BreakpointBrush"           Color="#CC0000" />
                    <SolidColorBrush x:Key="RunPad.Margin.BreakpointVerifiedBrush"   Color="#388A34" />
                    <SolidColorBrush x:Key="RunPad.Margin.BreakpointUnverifiedBrush" Color="#BF8803" />
                    <SolidColorBrush x:Key="RunPad.Margin.BreakpointPreviewBrush"    Color="#AA7070" />
                    <SolidColorBrush x:Key="RunPad.Margin.BreakpointConditionBadgeBrush" Color="#8A5FBF" />
                    <SolidColorBrush x:Key="RunPad.Margin.DebugArrowBrush"           Color="#E8B400" />
                    <SolidColorBrush x:Key="RunPad.Margin.DebugLineBrush"            Color="#4CFFFF00" />
                    <SolidColorBrush x:Key="RunPad.Margin.LineNumberBrush"          Color="#9E9E9E" />
                    <SolidColorBrush x:Key="RunPad.Margin.CodeFixErrorBrush"     Color="#F14C4C" />
                    <SolidColorBrush x:Key="RunPad.Margin.CodeFixWarningBrush"   Color="#BF8803" />
                    <SolidColorBrush x:Key="RunPad.Folding.ChevronBrush"            Color="#9D9D9D" />
                    <SolidColorBrush x:Key="RunPad.Folding.ChevronHoverBrush"       Color="#424242" />
                    <SolidColorBrush x:Key="RunPad.Folding.LineBrush"               Color="#D3D3D3" />
                    <SolidColorBrush x:Key="RunPad.Margin.CurrentLineBrush"          Color="#0D000000" />
                    <SolidColorBrush x:Key="RunPad.Editor.BraceMatchBrush"           Color="#3D8E5BC8" />
                    <SolidColorBrush x:Key="RunPad.Editor.BraceMismatchBrush"        Color="#40DC3C3C" />
                    <SolidColorBrush x:Key="RunPad.Editor.ActiveScopeGuideBrush"     Color="#9A72C9" />
                    <SolidColorBrush x:Key="RunPad.Dump.TableHeaderBrush"           Color="#0066B3" />
                    <SolidColorBrush x:Key="RunPad.Dump.TableHeaderForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="RunPad.Dump.TableBorderBrush"           Color="#B0B8C8" />
                    <SolidColorBrush x:Key="RunPad.Dump.TableEvenRowBrush"          Color="#EDF2FB" />
                    <SolidColorBrush x:Key="RunPad.Dump.StringBrush"                Color="#A31515" />
                    <SolidColorBrush x:Key="RunPad.Dump.NumberBrush"                Color="#098658" />
                    <SolidColorBrush x:Key="RunPad.Dump.BoolBrush"                  Color="#0000CC" />
                    <SolidColorBrush x:Key="RunPad.Dump.EnumBrush"                  Color="#267F99" />
                    <SolidColorBrush x:Key="RunPad.Dump.DateTimeBrush"              Color="#7B3FA0" />
                    <SolidColorBrush x:Key="RunPad.Dump.PropertyNameBrush"          Color="#0F4A8A" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
