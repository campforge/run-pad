<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="using:DotPad.Avalonia.Themes">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <!-- JetBrains Rider New UI — Dark -->
                <ResourceDictionary x:Key="{x:Static themes:DotPadThemeVariants.RiderDark}">
                    <SolidColorBrush x:Key="DotPad.Sidebar.BackgroundBrush"           Color="#2B2D30" />
                    <SolidColorBrush x:Key="DotPad.Toolbar.BackgroundBrush"           Color="#2B2D30" />
                    <SolidColorBrush x:Key="DotPad.Toolbar.BorderBrush"               Color="#393B40" />
                    <SolidColorBrush x:Key="DotPad.Editor.BackgroundBrush"            Color="#1E1F22" />
                    <SolidColorBrush x:Key="DotPad.Editor.SelectionBrush"             Color="#214283" />
                    <SolidColorBrush x:Key="DotPad.Output.BackgroundBrush"            Color="#1E1F22" />
                    <SolidColorBrush x:Key="DotPad.Output.ErrorForeground"            Color="#F14C4C" />
                    <SolidColorBrush x:Key="DotPad.Output.StackTraceForeground"       Color="#CD9591" />
                    <SolidColorBrush x:Key="DotPad.Panel.BackgroundBrush"             Color="#2B2D30" />
                    <SolidColorBrush x:Key="DotPad.StatusBar.BackgroundBrush"         Color="#2B2D30" />
                    <SolidColorBrush x:Key="DotPad.StatusBar.ForegroundBrush"         Color="#9AA7B0" />
                    <SolidColorBrush x:Key="DotPad.Status.RunningBrush"               Color="#4FC1FF" />
                    <SolidColorBrush x:Key="DotPad.Status.CancelledBrush"             Color="#9E9E9E" />
                    <SolidColorBrush x:Key="DotPad.Status.SuccessBrush"               Color="#4EC94E" />
                    <SolidColorBrush x:Key="DotPad.Status.ErrorBrush"                 Color="#F14C4C" />
                    <SolidColorBrush x:Key="DotPad.Status.PausedBrush"                Color="#FFA500" />
                    <SolidColorBrush x:Key="DotPad.Separator.BackgroundBrush"         Color="#393B40" />
                    <SolidColorBrush x:Key="DotPad.Border.BackgroundBrush"            Color="#43454A" />
                    <SolidColorBrush x:Key="DotPad.Text.PrimaryBrush"                 Color="#DFE1E5" />
                    <SolidColorBrush x:Key="DotPad.Text.SecondaryBrush"               Color="#9AA7B0" />
                    <SolidColorBrush x:Key="DotPad.Accent.BackgroundBrush"            Color="#2D5FAD" />
                    <SolidColorBrush x:Key="DotPad.Accent.ForegroundBrush"            Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DotPad.Tab.AccentBrush"                    Color="#4E9FDE" />
                    <Color             x:Key="DotPad.Tab.AccentColor"                               >#4E9FDE</Color>
                    <SolidColorBrush x:Key="DotPad.Tab.DirtyBrush"                     Color="#D7A544" />
                    <SolidColorBrush x:Key="DotPad.Toolbar.Button.HoverBrush"         Color="#3C3E42" />
                    <SolidColorBrush x:Key="DotPad.Icon.PlayBrush"                    Color="#59C459" />
                    <SolidColorBrush x:Key="DotPad.Icon.StopBrush"                    Color="#F75D5D" />
                    <SolidColorBrush x:Key="DotPad.Icon.DebugBrush"                   Color="#FFA94D" />
                    <SolidColorBrush x:Key="DotPad.Icon.StepBrush"                    Color="#56A8F5" />
                    <SolidColorBrush x:Key="DotPad.Icon.DisabledBrush"               Color="#636669" />
                    <SolidColorBrush x:Key="DotPad.Margin.BreakpointBrush"           Color="#F75464" />
                    <SolidColorBrush x:Key="DotPad.Margin.BreakpointVerifiedBrush"   Color="#6AAB73" />
                    <SolidColorBrush x:Key="DotPad.Margin.BreakpointUnverifiedBrush" Color="#D7A544" />
                    <SolidColorBrush x:Key="DotPad.Margin.BreakpointPreviewBrush"    Color="#8B3040" />
                    <SolidColorBrush x:Key="DotPad.Margin.BreakpointConditionBadgeBrush" Color="#B18AE0" />
                    <SolidColorBrush x:Key="DotPad.Margin.DebugArrowBrush"           Color="#FFD040" />
                    <SolidColorBrush x:Key="DotPad.Margin.DebugLineBrush"            Color="#3CFFD000" />
                    <SolidColorBrush x:Key="DotPad.Margin.LineNumberBrush"          Color="#67696B" />
                    <SolidColorBrush x:Key="DotPad.Margin.CodeFixErrorBrush"     Color="#F14C4C" />
                    <SolidColorBrush x:Key="DotPad.Margin.CodeFixWarningBrush"   Color="#D7A544" />
                    <SolidColorBrush x:Key="DotPad.Folding.ChevronBrush"            Color="#6B6B6B" />
                    <SolidColorBrush x:Key="DotPad.Folding.ChevronHoverBrush"       Color="#BDBDBD" />
                    <SolidColorBrush x:Key="DotPad.Folding.LineBrush"               Color="#3A3D41" />
                    <SolidColorBrush x:Key="DotPad.Dump.TableHeaderBrush"           Color="#2D5FAD" />
                    <SolidColorBrush x:Key="DotPad.Dump.TableHeaderForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DotPad.Dump.TableBorderBrush"           Color="#43454A" />
                    <SolidColorBrush x:Key="DotPad.Dump.TableEvenRowBrush"          Color="#252729" />
                    <SolidColorBrush x:Key="DotPad.Dump.StringBrush"                Color="#CE9178" />
                    <SolidColorBrush x:Key="DotPad.Dump.NumberBrush"                Color="#B5CEA8" />
                    <SolidColorBrush x:Key="DotPad.Dump.BoolBrush"                  Color="#56A8F5" />
                    <SolidColorBrush x:Key="DotPad.Dump.EnumBrush"                  Color="#4EC9B0" />
                    <SolidColorBrush x:Key="DotPad.Dump.DateTimeBrush"              Color="#C8A0D4" />
                    <SolidColorBrush x:Key="DotPad.Dump.PropertyNameBrush"          Color="#9CDCFE" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
