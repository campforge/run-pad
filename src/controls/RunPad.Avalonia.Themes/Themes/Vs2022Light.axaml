<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="using:RunPad.Avalonia.Themes">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="{x:Static themes:RunPadThemeVariants.Vs2022Light}">
                    <SolidColorBrush x:Key="RunPad.Sidebar.BackgroundBrush"           Color="#F5F5F5" />
                    <SolidColorBrush x:Key="RunPad.Toolbar.BackgroundBrush"           Color="#EEEEF2" />
                    <SolidColorBrush x:Key="RunPad.TitleBar.BackgroundBrush"          Color="#F5F5F5" />
                    <SolidColorBrush x:Key="RunPad.Toolbar.BorderBrush"               Color="#CCCEDB" />
                    <SolidColorBrush x:Key="RunPad.Editor.BackgroundBrush"            Color="#FFFFFF" />
                    <SolidColorBrush x:Key="RunPad.Editor.SelectionBrush"             Color="#ADD6FF" />
                    <SolidColorBrush x:Key="RunPad.Output.BackgroundBrush"            Color="#FFFFFF" />
                    <SolidColorBrush x:Key="RunPad.Output.ErrorForeground"            Color="#CC0000" />
                    <SolidColorBrush x:Key="RunPad.Output.StackTraceForeground"       Color="#A31515" />
                    <SolidColorBrush x:Key="RunPad.Panel.BackgroundBrush"             Color="#F5F5F5" />
                    <SolidColorBrush x:Key="RunPad.StatusBar.BackgroundBrush"         Color="#F5F5F5" />
                    <SolidColorBrush x:Key="RunPad.StatusBar.ForegroundBrush"         Color="#1E1E1E" />
                    <SolidColorBrush x:Key="RunPad.Status.RunningBrush"               Color="#005FB8" />
                    <SolidColorBrush x:Key="RunPad.Status.CancelledBrush"             Color="#62666C" />
                    <SolidColorBrush x:Key="RunPad.Status.SuccessBrush"               Color="#23723B" />
                    <SolidColorBrush x:Key="RunPad.Status.ErrorBrush"                 Color="#B42332" />
                    <SolidColorBrush x:Key="RunPad.Status.PausedBrush"                Color="#895200" />
                    <SolidColorBrush x:Key="RunPad.Separator.BackgroundBrush"         Color="#CCCEDB" />
                    <SolidColorBrush x:Key="RunPad.Border.BackgroundBrush"            Color="#CCCEDB" />
                    <SolidColorBrush x:Key="RunPad.Text.PrimaryBrush"                 Color="#1E1E1E" />
                    <!-- Fluent's menu popups: a menu bar's dropdowns and submenus draw their own border with these. -->
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#F5F5F5" />
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#CCCEDB" />
                    <!-- Fluent's ComboBox dropdown: the same surface as the menus. -->
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#F5F5F5" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#CCCEDB" />
                    <!-- Fluent's plain buttons (and DropDownButton): the secondary button's surface. -->
                    <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#C9DEF5" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#EEEEF2" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#CCCEDB" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#CCCEDB" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#CCCEDB" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#CCCEDB" />
                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#6F6F6F" />
                    <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPressed" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="#6F6F6F" />
                    <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundDisabled" Color="#6F6F6F" />
                    <SolidColorBrush x:Key="RunPad.Text.SecondaryBrush"               Color="#6F6F6F" />
                    <SolidColorBrush x:Key="RunPad.Accent.BackgroundBrush"            Color="#ADD6FF" />
                    <SolidColorBrush x:Key="RunPad.Accent.ForegroundBrush"            Color="#000000" />
                    <SolidColorBrush x:Key="RunPad.ToolTab.SelectedBackgroundBrush" Color="#E1D7E4" />
                    <SolidColorBrush x:Key="RunPad.ToolTab.SelectedForegroundBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="RunPad.ToolTab.SelectedBorderBrush" Color="#AE8BB8" />
                    <!-- Default (primary) dialog button: white text at least 4.5:1 in every state. -->
                    <SolidColorBrush x:Key="RunPad.Button.Primary.BackgroundBrush"     Color="#68217A" />
                    <SolidColorBrush x:Key="RunPad.Button.Primary.HoverBrush"          Color="#5A1D6A" />
                    <SolidColorBrush x:Key="RunPad.Button.Primary.PressedBrush"        Color="#4D185A" />
                    <SolidColorBrush x:Key="RunPad.Button.Primary.ForegroundBrush"     Color="#FFFFFF" />
                    <!-- Shared keyboard-focus ring; independent of selection and primary actions. -->
                    <SolidColorBrush x:Key="RunPad.Focus.BorderBrush"                  Color="#68217A" />
                    <SolidColorBrush x:Key="RunPad.Focus.ContrastBrush"                Color="#FFFFFF" />
                    <Thickness        x:Key="RunPad.Focus.Thickness">2</Thickness>
                    <Thickness        x:Key="RunPad.Focus.ContrastThickness">1</Thickness>
                    <CornerRadius     x:Key="RunPad.Focus.CornerRadius">4</CornerRadius>
                    <CornerRadius     x:Key="RunPad.Focus.InnerCornerRadius">2</CornerRadius>
                    <SolidColorBrush x:Key="RunPad.Tab.AccentBrush"                    Color="#68217A" />
                    <Color             x:Key="RunPad.Tab.AccentColor"                               >#68217A</Color>
                    <SolidColorBrush x:Key="RunPad.Tab.DirtyBrush"                     Color="#B8860B" />
                    <SolidColorBrush x:Key="RunPad.Toolbar.Button.HoverBrush"         Color="#C9DEF5" />
                    <SolidColorBrush x:Key="RunPad.Icon.PlayBrush"                    Color="#2A7E2A" />
                    <SolidColorBrush x:Key="RunPad.Icon.StopBrush"                    Color="#C00000" />
                    <SolidColorBrush x:Key="RunPad.Icon.DebugBrush"                   Color="#C25800" />
                    <SolidColorBrush x:Key="RunPad.Icon.StepBrush"                    Color="#0066B8" />
                    <SolidColorBrush x:Key="RunPad.Icon.DisabledBrush"               Color="#AAAAAA" />
                    <SolidColorBrush x:Key="RunPad.Margin.BreakpointBrush"           Color="#CC0000" />
                    <SolidColorBrush x:Key="RunPad.Margin.BreakpointVerifiedBrush"   Color="#2E7D32" />
                    <SolidColorBrush x:Key="RunPad.Margin.BreakpointUnverifiedBrush" Color="#B8860B" />
                    <SolidColorBrush x:Key="RunPad.Margin.BreakpointPreviewBrush"    Color="#AA7070" />
                    <SolidColorBrush x:Key="RunPad.Margin.BreakpointConditionBadgeBrush" Color="#8A5FBF" />
                    <SolidColorBrush x:Key="RunPad.Margin.DebugArrowBrush"           Color="#E8B400" />
                    <SolidColorBrush x:Key="RunPad.Margin.DebugLineBrush"            Color="#50FFEE00" />
                    <SolidColorBrush x:Key="RunPad.Margin.LineNumberBrush"          Color="#A6A6A6" />
                    <SolidColorBrush x:Key="RunPad.Margin.CodeFixErrorBrush"     Color="#F14C4C" />
                    <SolidColorBrush x:Key="RunPad.Margin.CodeFixWarningBrush"   Color="#B8860B" />
                    <SolidColorBrush x:Key="RunPad.Folding.ChevronBrush"            Color="#ABABAB" />
                    <SolidColorBrush x:Key="RunPad.Folding.ChevronHoverBrush"       Color="#555555" />
                    <SolidColorBrush x:Key="RunPad.Folding.LineBrush"               Color="#DEDEDE" />
                    <SolidColorBrush x:Key="RunPad.Margin.CurrentLineBrush"          Color="#0D000000" />
                    <SolidColorBrush x:Key="RunPad.Editor.BraceMatchBrush"           Color="#3D8E5BC8" />
                    <SolidColorBrush x:Key="RunPad.Editor.BraceMismatchBrush"        Color="#40DC3C3C" />
                    <SolidColorBrush x:Key="RunPad.Editor.ActiveScopeGuideBrush"     Color="#9A72C9" />
                    <SolidColorBrush x:Key="RunPad.Dump.TableHeaderBrush"           Color="#0066B8" />
                    <SolidColorBrush x:Key="RunPad.Dump.TableHeaderForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="RunPad.Dump.TableBorderBrush"           Color="#ADBAD0" />
                    <SolidColorBrush x:Key="RunPad.Dump.TableEvenRowBrush"          Color="#EDF3FD" />
                    <SolidColorBrush x:Key="RunPad.Dump.StringBrush"                Color="#A31515" />
                    <SolidColorBrush x:Key="RunPad.Dump.NumberBrush"                Color="#098658" />
                    <SolidColorBrush x:Key="RunPad.Dump.BoolBrush"                  Color="#0000CC" />
                    <SolidColorBrush x:Key="RunPad.Dump.EnumBrush"                  Color="#267F99" />
                    <SolidColorBrush x:Key="RunPad.Dump.DateTimeBrush"              Color="#7B3FA0" />
                    <SolidColorBrush x:Key="RunPad.Dump.PropertyNameBrush"          Color="#0F4A8A" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
