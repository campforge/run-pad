<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RunPad.Avalonia.Themes.RunPadTheme">
    <StyleInclude Source="avares://RunPad.Avalonia.Themes/Themes/VsCodeDark.axaml" />
    <StyleInclude Source="avares://RunPad.Avalonia.Themes/Themes/VsCodeLight.axaml" />
    <StyleInclude Source="avares://RunPad.Avalonia.Themes/Themes/RiderDark.axaml" />
    <StyleInclude Source="avares://RunPad.Avalonia.Themes/Themes/RiderLight.axaml" />
    <StyleInclude Source="avares://RunPad.Avalonia.Themes/Themes/Vs2022Dark.axaml" />
    <StyleInclude Source="avares://RunPad.Avalonia.Themes/Themes/Vs2022Light.axaml" />
    <StyleInclude Source="avares://RunPad.Avalonia.Themes/Themes/RunPadMidnight.axaml" />
    <StyleInclude Source="avares://RunPad.Avalonia.Themes/Themes/RunPadWarmLight.axaml" />

    <!-- ── DataGrid ─────────────────────────────────────────────────────── -->
    <Style Selector="DataGrid">
        <Setter Property="Background"               Value="{DynamicResource RunPad.Output.BackgroundBrush}"/>
        <Setter Property="Foreground"               Value="{DynamicResource RunPad.Text.PrimaryBrush}"/>
        <Setter Property="BorderBrush"              Value="{DynamicResource RunPad.Border.BackgroundBrush}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource RunPad.Separator.BackgroundBrush}"/>
        <Setter Property="VerticalGridLinesBrush"   Value="{DynamicResource RunPad.Separator.BackgroundBrush}"/>
        <Setter Property="RowBackground"            Value="Transparent"/>
    </Style>

    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background"     Value="{DynamicResource RunPad.Panel.BackgroundBrush}"/>
        <Setter Property="Foreground"     Value="{DynamicResource RunPad.Text.SecondaryBrush}"/>
        <Setter Property="SeparatorBrush" Value="{DynamicResource RunPad.Separator.BackgroundBrush}"/>
        <Setter Property="FontSize"       Value="12"/>
        <Setter Property="MinHeight"      Value="28"/>
    </Style>
    <Style Selector="DataGridColumnHeader:pointerover /template/ Grid#PART_ColumnHeaderRoot">
        <Setter Property="Background" Value="{DynamicResource RunPad.Toolbar.Button.HoverBrush}"/>
    </Style>

    <Style Selector="DataGridRow">
        <Setter Property="Foreground" Value="{DynamicResource RunPad.Text.PrimaryBrush}"/>
        <Setter Property="MinHeight"  Value="24"/>
    </Style>
    <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill"    Value="{DynamicResource RunPad.Toolbar.Button.HoverBrush}"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill"    Value="{DynamicResource RunPad.Accent.BackgroundBrush}"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="DataGridRow:selected:pointerover /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill"    Value="{DynamicResource RunPad.Accent.BackgroundBrush}"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="DataGridRow:selected:focus /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill"    Value="{DynamicResource RunPad.Accent.BackgroundBrush}"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="DataGridRow:selected:pointerover:focus /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill"    Value="{DynamicResource RunPad.Accent.BackgroundBrush}"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="DataGridCell">
        <Setter Property="Foreground"     Value="{DynamicResource RunPad.Text.PrimaryBrush}"/>
        <Setter Property="FontSize"       Value="13"/>
        <Setter Property="MinHeight"      Value="24"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- ── TreeView ──────────────────────────────────────────────────────── -->
    <Style Selector="TreeView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding"    Value="0"/>
    </Style>
    <Style Selector="TreeViewItem">
        <Setter Property="Foreground" Value="{DynamicResource RunPad.Text.PrimaryBrush}"/>
        <Setter Property="Padding"    Value="2,4"/>
    </Style>
    <Style Selector="TreeViewItem:pointerover /template/ Border">
        <Setter Property="Background" Value="{DynamicResource RunPad.Toolbar.Button.HoverBrush}"/>
    </Style>
    <Style Selector="TreeViewItem:selected /template/ Border">
        <Setter Property="Background" Value="{DynamicResource RunPad.Accent.BackgroundBrush}"/>
    </Style>
    <Style Selector="TreeViewItem:selected:pointerover /template/ Border">
        <Setter Property="Background" Value="{DynamicResource RunPad.Accent.BackgroundBrush}"/>
    </Style>
    <!-- On the selected item's own header only: a Foreground on the whole item is inherited by its
         children's text too. -->
    <Style Selector="TreeViewItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Foreground" Value="{DynamicResource RunPad.Accent.ForegroundBrush}"/>
    </Style>

    <!-- ── Default dialog button ──────────────────────────────────────────── -->
    <!-- The button a dialog's Enter presses (IsDefault) is its primary action and looks like it:
         theme accent with white text. Disabled keeps Fluent's own look. -->
    <Style Selector="Button[IsDefault=True]:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background"  Value="{DynamicResource RunPad.Button.Primary.BackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource RunPad.Button.Primary.BackgroundBrush}"/>
        <Setter Property="Foreground"  Value="{DynamicResource RunPad.Button.Primary.ForegroundBrush}"/>
    </Style>
    <Style Selector="Button[IsDefault=True]:not(:disabled):pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background"  Value="{DynamicResource RunPad.Button.Primary.HoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource RunPad.Button.Primary.HoverBrush}"/>
        <Setter Property="Foreground"  Value="{DynamicResource RunPad.Button.Primary.ForegroundBrush}"/>
    </Style>
    <Style Selector="Button[IsDefault=True]:not(:disabled):pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background"  Value="{DynamicResource RunPad.Button.Primary.PressedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource RunPad.Button.Primary.PressedBrush}"/>
        <Setter Property="Foreground"  Value="{DynamicResource RunPad.Button.Primary.ForegroundBrush}"/>
    </Style>

    <!-- Keyboard focus: a ring in the button's text colour inside the accent, visible whatever
         the focus adorner around the button shows. -->
    <Style Selector="Button[IsDefault=True]:not(:disabled):focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush"     Value="{DynamicResource RunPad.Button.Primary.ForegroundBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- ── Panel seam ──────────────────────────────────────────────────── -->
    <!-- A one-DIP layout seam with a five-DIP transparent drag target overlapping the adjacent
         panels. The hit area does not reserve a blank band on either side of the line. -->
    <Style Selector="GridSplitter.seam">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="ZIndex" Value="10"/>
        <Setter Property="Template">
            <ControlTemplate TargetType="GridSplitter">
                <Panel Background="{TemplateBinding Background}">
                    <Border x:Name="PART_Line" Background="{DynamicResource RunPad.Separator.BackgroundBrush}"/>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="GridSplitter.seam[ResizeDirection=Columns]">
        <Setter Property="Width" Value="5"/>
        <Setter Property="Margin" Value="-2,0"/>
    </Style>
    <Style Selector="GridSplitter.seam[ResizeDirection=Rows]">
        <Setter Property="Height" Value="5"/>
        <Setter Property="Margin" Value="0,-2"/>
    </Style>
    <Style Selector="GridSplitter.seam[ResizeDirection=Columns] /template/ Border#PART_Line">
        <Setter Property="Width" Value="1"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style Selector="GridSplitter.seam[ResizeDirection=Rows] /template/ Border#PART_Line">
        <Setter Property="Height" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ── Keyboard focus ─────────────────────────────────────────────────── -->
    <!-- One keyboard-focus look: Fluent's focus frame (white in dark themes, black in light ones),
         shown when a control is reached with the keyboard and not when it is clicked. Fluent's
         ComboBox is the exception — it fills itself with the accent instead (over its text) — so a
         combo box gets the same frame as everything else and no fill. Text fields keep their own
         focused border, shown with the caret. -->
    <Style Selector="ComboBox">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border BorderThickness="{DynamicResource SystemControlFocusVisualPrimaryThickness}"
                        BorderBrush="{DynamicResource SystemControlFocusVisualPrimaryBrush}"
                        CornerRadius="4">
                    <Border BorderThickness="1"
                            BorderBrush="{DynamicResource SystemControlFocusVisualSecondaryBrush}"
                            CornerRadius="3"/>
                </Border>
            </FocusAdornerTemplate>
        </Setter>
    </Style>
    <Style Selector="ComboBox:focus-visible /template/ Border#HighlightBackground">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <!-- ── Panel tabs ─────────────────────────────────────────────────────── -->
    <!-- Tabs of a panel (Results/Debugger/IL, and the Debugger's own Threads/Locals/…), drawn like
         the document tabs above the editor: inactive tabs on the panel colour, the selected tab in
         the colour of its content so the two join, a separator after each tab, the hover brush on
         hover, no accent line; keyboard focus shows Fluent's focus frame. TabControl.Background is the
         content's colour. "nested" is the smaller row inside a panel. -->
    <Style Selector="TabControl.panel">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate TargetType="TabControl">
                <DockPanel>
                    <Border x:Name="PART_Strip" DockPanel.Dock="Top"
                            Background="{DynamicResource RunPad.Panel.BackgroundBrush}">
                        <ItemsPresenter Name="PART_ItemsPresenter"
                                        ItemsPanel="{TemplateBinding ItemsPanel}"/>
                    </Border>
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter Name="PART_SelectedContentHost"
                                          Content="{TemplateBinding SelectedContent}"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TabControl.panel > TabItem">
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="MinHeight"  Value="28"/>
        <Setter Property="Height"     Value="28"/>
        <Setter Property="Padding"    Value="12,0"/>
        <Setter Property="Margin"     Value="0"/>
        <Setter Property="Background" Value="{DynamicResource RunPad.Panel.BackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource RunPad.Text.SecondaryBrush}"/>
        <Setter Property="Template">
            <ControlTemplate TargetType="TabItem">
                <!-- Transparent: the whole tab takes clicks whatever brush the theme supplies. -->
                <Panel Background="Transparent">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource RunPad.Separator.BackgroundBrush}"
                            BorderThickness="0,0,1,0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TabControl.panel > TabItem:selected">
        <Setter Property="Background" Value="{Binding $parent[TabControl].Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource RunPad.Text.PrimaryBrush}"/>
    </Style>
    <Style Selector="TabControl.panel > TabItem:pointerover /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource RunPad.Toolbar.Button.HoverBrush}"/>
    </Style>
    <Style Selector="TabControl.panel.nested > TabItem">
        <Setter Property="FontSize"  Value="12"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Height"    Value="24"/>
        <Setter Property="Padding"   Value="10,0"/>
    </Style>

</Styles>
