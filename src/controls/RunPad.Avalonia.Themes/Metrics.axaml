<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Existing compact dimensions, named by role; code fonts and UI scaling are independent. -->
    <x:Double x:Key="RunPad.Type.Body">13</x:Double>
    <x:Double x:Key="RunPad.Type.Caption">12</x:Double>
    <x:Double x:Key="RunPad.Space.Tight">4</x:Double>
    <x:Double x:Key="RunPad.Space.Control">8</x:Double>
    <x:Double x:Key="RunPad.Space.Section">16</x:Double>
    <x:Double x:Key="RunPad.Size.PanelTab">28</x:Double>
    <x:Double x:Key="RunPad.Size.NestedTab">24</x:Double>
    <x:Double x:Key="RunPad.Size.IconButton">26</x:Double>
    <x:Double x:Key="RunPad.Size.ToolbarIcon">16</x:Double>
    <Thickness x:Key="RunPad.Padding.IconButton">4</Thickness>
    <CornerRadius x:Key="RunPad.Radius.Control">4</CornerRadius>
    <CornerRadius x:Key="RunPad.Radius.Selection">5</CornerRadius>
    <!-- Windows, dialogs and everything that pops up (menus, dropdowns, tooltips, flyouts, the editor's
         completion lists and tips) share one radius; what sits inside them uses Control or Selection. -->
    <CornerRadius x:Key="RunPad.Radius.Overlay">8</CornerRadius>
    <!-- The same corner just inside a 1 px frame, for surfaces drawn within a window's border. -->
    <CornerRadius x:Key="RunPad.Radius.OverlayInner">7</CornerRadius>
    <CornerRadius x:Key="RunPad.Radius.OverlayInnerTop">7,7,0,0</CornerRadius>
    <!-- Fluent's own keys, so its popups, flyouts, menus, dropdowns and controls follow these. -->
    <StaticResource x:Key="OverlayCornerRadius" ResourceKey="RunPad.Radius.Overlay"/>
    <StaticResource x:Key="ControlCornerRadius" ResourceKey="RunPad.Radius.Control"/>
    <!-- Fluent's padding inside menus, context menus and submenus: keeps the rounded item highlights
         off the menu's rounded border. -->
    <Thickness x:Key="MenuFlyoutPresenterThemePadding">4</Thickness>
    <!-- The same inside a ComboBox's dropdown. -->
    <Thickness x:Key="ComboBoxDropdownBorderPadding">4</Thickness>
    <x:Double x:Key="RunPad.Type.DialogTitle">15</x:Double>
    <Thickness x:Key="RunPad.Dialog.Padding">24</Thickness>
    <Thickness x:Key="RunPad.Dialog.ActionsMargin">0,24,0,0</Thickness>
</ResourceDictionary>
