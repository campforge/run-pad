  <ItemGroup>
    <ProjectReference Include="..\RunPad.Desktop\RunPad.Desktop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RunPad.NonUI.Tests" />
  </ItemGroup>
</Project>
