<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="using:Invoklet.Avalonia.Themes"
             x:Class="Invoklet.App"
             Name="Invoklet">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Invoklet/Resources/Icons.axaml"/>
                <ResourceInclude Source="avares://Invoklet/Resources/WindowDecorations.axaml"/>
                <ResourceInclude Source="avares://Invoklet/Resources/WindowChrome.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <themes:InvokletTheme />
        <StyleInclude Source="avares://Invoklet/TemplatedControls/IconButton.axaml"/>
        <StyleInclude Source="avares://Invoklet/TemplatedControls/IconToggleButton.axaml"/>
        <StyleInclude Source="avares://Invoklet/TemplatedControls/ToolbarComboBox.axaml"/>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <StyleInclude Source="avares://MarkView.Avalonia/Themes/MarkdownTheme.axaml"/>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <StyleInclude Source="avares://Invoklet/Resources/PopupStyles.axaml"/>
        <Style Selector="Window">
            <Setter Property="WindowDecorationsTheme" Value="{StaticResource InvokletWindowDecorations}"/>
        </Style>
    </Application.Styles>
</Application>
