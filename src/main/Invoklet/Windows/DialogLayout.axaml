<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Invoklet.Windows.DialogLayout"
             x:Name="Root" x:CompileBindings="False">
    <Grid Margin="{DynamicResource Invoklet.Dialog.Padding}"
          RowDefinitions="Auto,Auto" ColumnDefinitions="24,12,*">
        <!-- Decorative: the heading says what the dialog is about. -->
        <Border x:Name="KindBadge" Width="24" Height="24" CornerRadius="12" VerticalAlignment="Top"
                AutomationProperties.AccessibilityView="Raw">
            <TextBlock x:Name="KindGlyph" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontWeight="SemiBold" FontSize="{DynamicResource Invoklet.Type.Body}"
                       Foreground="{DynamicResource Invoklet.Button.Primary.ForegroundBrush}"/>
        </Border>
        <StackPanel Grid.Column="2" Spacing="{DynamicResource Invoklet.Space.Control}">
            <TextBlock x:Name="HeadingBlock" Text="{Binding #Root.Heading}" TextWrapping="Wrap" FontWeight="SemiBold"
                       FontSize="{DynamicResource Invoklet.Type.DialogTitle}"/>
            <TextBlock x:Name="FileNameBlock" Text="{Binding #Root.FileName}"
                       IsVisible="{Binding #Root.FileName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       TextWrapping="Wrap" FontWeight="SemiBold"
                       FontSize="{DynamicResource Invoklet.Type.Body}"/>
            <TextBlock Text="{Binding #Root.Message}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Invoklet.Text.SecondaryBrush}"
                       FontSize="{DynamicResource Invoklet.Type.Body}"/>
            <ContentControl Content="{Binding #Root.Body}"/>
        </StackPanel>
        <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnDefinitions="Auto,*,Auto"
              Margin="{DynamicResource Invoklet.Dialog.ActionsMargin}">
            <ContentControl Content="{Binding #Root.LeadingActions}" VerticalAlignment="Center"/>
            <ContentControl Grid.Column="2" Content="{Binding #Root.Actions}" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
