<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Invoklet.Windows.SplashWindow"
        Icon="/Assets/icon.ico"
        Title="Invoklet"
        Width="420" Height="230"
        CanResize="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Foreground="{DynamicResource Invoklet.Text.PrimaryBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Invoklet.Avalonia.Themes/Metrics.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="DialogSurface" Background="{DynamicResource Invoklet.Panel.BackgroundBrush}"
            BorderBrush="{DynamicResource Invoklet.Border.BackgroundBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Invoklet.Radius.Overlay}"
            Padding="28">
        <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="14">
            <Grid Grid.Row="0" ColumnDefinitions="56,*" ColumnSpacing="14">
                <Image Grid.Column="0" Source="/Assets/icon.ico" Width="48" Height="48"
                       VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Invoklet" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="C# and Visual Basic scratchpad"
                               FontSize="{DynamicResource Invoklet.Type.Caption}"
                               Foreground="{DynamicResource Invoklet.Text.SecondaryBrush}"/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="StatusText" Grid.Row="2" Text="Starting Invoklet…"
                       FontSize="{DynamicResource Invoklet.Type.Caption}"
                       Foreground="{DynamicResource Invoklet.Text.SecondaryBrush}"/>
            <ProgressBar x:Name="StartupProgress" Grid.Row="3" Height="4"
                         IsIndeterminate="True"/>

            <StackPanel x:Name="StartupError" Grid.Row="2" Grid.RowSpan="2" Spacing="12"
                        IsVisible="False">
                <TextBlock x:Name="StartupErrorText"
                           TextWrapping="Wrap"/>
                <Button Content="Close" HorizontalAlignment="Right" MinWidth="88"
                        x:Name="CloseStartupErrorButton" Click="CloseButton_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
