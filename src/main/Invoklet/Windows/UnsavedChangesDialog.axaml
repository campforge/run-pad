<local:InvokletDialogWindow xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:local="using:Invoklet.Windows"
                         x:Class="Invoklet.Windows.UnsavedChangesDialog"
                         Icon="/Assets/icon.ico" Title="Unsaved Changes"
                         Background="{DynamicResource Invoklet.Panel.BackgroundBrush}"
                         Foreground="{DynamicResource Invoklet.Text.PrimaryBrush}">
    <local:DialogLayout x:Name="Layout" Heading="Save changes before closing?"
                        Message="Your changes will be lost if you don’t save.">
        <local:DialogLayout.LeadingActions>
            <Button Classes="secondary" x:Name="DontSaveButton" Content="Don’t Save" MinWidth="88" TabIndex="1"
                    Click="DontSaveButton_Click"/>
        </local:DialogLayout.LeadingActions>
        <local:DialogLayout.Actions>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Invoklet.Space.Control}">
                <Button Classes="secondary" x:Name="CancelButton" Content="Cancel" MinWidth="72" TabIndex="2"
                        Click="CancelButton_Click" IsCancel="True"/>
                <Button x:Name="SaveButton" Content="Save" MinWidth="72" TabIndex="0"
                        Click="SaveButton_Click" IsDefault="True"/>
            </StackPanel>
        </local:DialogLayout.Actions>
    </local:DialogLayout>
</local:InvokletDialogWindow>
