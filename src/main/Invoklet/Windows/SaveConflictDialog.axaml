<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Invoklet.Windows.SaveConflictDialog"
        Icon="/Assets/icon.ico"
        Title="File Changed on Disk"
        Width="420"
        MinWidth="340" MinHeight="140"
        CanResize="False"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Invoklet.Panel.BackgroundBrush}"
        Foreground="{DynamicResource Invoklet.Text.PrimaryBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Invoklet.Avalonia.Themes/Metrics.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid RowDefinitions="Auto,Auto" Margin="16">

        <TextBlock x:Name="MessageBlock"
                   Grid.Row="0"
                   FontSize="{DynamicResource Invoklet.Type.Body}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <!-- Enter saves under another name, which keeps both versions; replacing the file on disk
             is never the default. Escape and closing the window cancel. -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="{DynamicResource Invoklet.Space.Control}">
            <Button Classes="primary" x:Name="SaveAsButton"
                    Content="Save As…"
                    MinWidth="88"
                    Click="SaveAsButton_Click"
                    IsDefault="True"/>
            <Button Classes="secondary" x:Name="OverwriteButton"
                    Content="Overwrite"
                    MinWidth="88"
                    Click="OverwriteButton_Click"/>
            <Button Classes="secondary" x:Name="CancelButton"
                    Content="Cancel"
                    MinWidth="80"
                    Click="CancelButton_Click"
                    IsCancel="True"/>
        </StackPanel>

    </Grid>

</Window>
