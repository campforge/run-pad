<local:InvokletDialogWindow xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:local="using:Invoklet.Windows"
                         x:Class="Invoklet.Windows.ExitUnsavedDialog"
                         Icon="/Assets/icon.ico" Title="Unsaved Changes"
                         Background="{DynamicResource Invoklet.Panel.BackgroundBrush}"
                         Foreground="{DynamicResource Invoklet.Text.PrimaryBrush}">
    <local:DialogLayout x:Name="Layout" Heading="Save changes before closing Invoklet?">
        <local:DialogLayout.LeadingActions>
            <Button Classes="secondary" x:Name="KeepInStashButton" Content="Keep in Stash" MinWidth="88" Height="{DynamicResource Invoklet.Size.Control}" TabIndex="1"
                    Click="KeepInStashButton_Click"
                    ToolTip.Tip="Close without writing the files; the changes reopen next time"/>
        </local:DialogLayout.LeadingActions>
        <local:DialogLayout.Actions>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Invoklet.Space.Control}">
                <Button Classes="secondary" x:Name="CancelButton" Content="Cancel" MinWidth="72" Height="{DynamicResource Invoklet.Size.Control}" TabIndex="2"
                        Click="CancelButton_Click" IsCancel="True"/>
                <Button x:Name="SaveAllButton" Content="Save All" MinWidth="72" Height="{DynamicResource Invoklet.Size.Control}" TabIndex="0"
                        Click="SaveAllButton_Click" IsDefault="True"/>
            </StackPanel>
        </local:DialogLayout.Actions>
    </local:DialogLayout>
</local:InvokletDialogWindow>
