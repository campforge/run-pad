<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Invoklet.Windows.NewFileKindDialog"
        Icon="/Assets/icon.ico"
        Title="New File"
        Width="320" Height="150"
        MinWidth="280" MinHeight="140"
        CanResize="False"
        SizeToContent="Manual"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Invoklet.Panel.BackgroundBrush}"
        Foreground="{DynamicResource Invoklet.Text.PrimaryBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Invoklet.Avalonia.Themes/Metrics.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>


    <Grid RowDefinitions="Auto,Auto,Auto" Margin="16">

        <TextBlock Grid.Row="0"
                   Text="Kind:"
                   FontSize="{DynamicResource Invoklet.Type.Caption}"
                   Foreground="{DynamicResource Invoklet.Text.SecondaryBrush}"
                   Margin="0,0,0,6"/>

        <ComboBox x:Name="KindBox"
                  Grid.Row="1"
                  HorizontalAlignment="Stretch"
                  Margin="0,0,0,12"/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="{DynamicResource Invoklet.Space.Control}">
            <Button Classes="primary" Content="OK"
                    MinWidth="{DynamicResource Invoklet.Size.DialogButton}"
                    Click="OkButton_Click"
                    IsDefault="True"/>
            <Button Classes="secondary" Content="Cancel"
                    MinWidth="{DynamicResource Invoklet.Size.DialogButton}"
                    Click="CancelButton_Click"
                    IsCancel="True"/>
        </StackPanel>

    </Grid>

</Window>
