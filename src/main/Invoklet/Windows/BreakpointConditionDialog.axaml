<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Invoklet.Windows.BreakpointConditionDialog"
        Icon="/Assets/icon.ico"
        Title="Line breakpoint"
        MinWidth="480" MaxWidth="520"
        MinHeight="0" MaxHeight="420"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Foreground="{DynamicResource Invoklet.Text.PrimaryBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Invoklet.Avalonia.Themes/Metrics.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border x:Name="DialogSurface" Background="{DynamicResource Invoklet.Panel.BackgroundBrush}"
            BorderBrush="{DynamicResource Invoklet.Border.BackgroundBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Invoklet.Radius.Overlay}"
            Padding="16">
        <ContentControl x:Name="EditorHost"/>
    </Border>
</Window>
