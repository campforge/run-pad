<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Invoklet.Windows.GoToLineDialog"
        Icon="/Assets/icon.ico"
        Title="Go to Line"
        Width="320" Height="150"
        MinWidth="280" MinHeight="140"
        CanResize="False"
        SizeToContent="Manual"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Foreground="{DynamicResource Invoklet.Text.PrimaryBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Invoklet.Avalonia.Themes/Metrics.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="DialogSurface" Background="{DynamicResource Invoklet.Panel.BackgroundBrush}"
            BorderBrush="{DynamicResource Invoklet.Border.BackgroundBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Invoklet.Radius.Overlay}"
            Padding="16">
        <Grid RowDefinitions="Auto,Auto,Auto">

            <TextBlock x:Name="PromptText"
                       Grid.Row="0"
                       FontSize="{DynamicResource Invoklet.Type.Caption}"
                       Foreground="{DynamicResource Invoklet.Text.SecondaryBrush}"
                       Margin="0,0,0,6"/>

            <NumericUpDown x:Name="LineBox"
                           Grid.Row="1"
                           Minimum="1"
                           FormatString="0"
                           Margin="0,0,0,12"/>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="{DynamicResource Invoklet.Space.Control}">
                <Button Classes="primary" Content="OK"
                        MinWidth="{DynamicResource Invoklet.Size.DialogButton}"
                        Click="OkButton_Click"
                        IsDefault="True"/>
                <Button Classes="secondary" Content="Cancel"
                        MinWidth="{DynamicResource Invoklet.Size.DialogButton}"
                        Click="CancelButton_Click"
                        IsCancel="True"/>
            </StackPanel>

        </Grid>
    </Border>

</Window>
