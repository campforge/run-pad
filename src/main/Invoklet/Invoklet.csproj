<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Product>Invoklet</Product>
    <Version>0.10.2</Version>
    <Authors>hobobyte</Authors>
    <Company>hobobyte</Company>
    <Copyright>© 2026 Vadim S (hobobyte)</Copyright>
    <!-- AVLN3001: XAML controls using constructor DI have no public ctor — expected pattern -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <!-- Desktop integration: the contract on every OS, and the implementation for the OS this build is
       for only — a matching RID, or no RID on that host. Its native dependencies (Avalonia.Wayland on
       Linux) stay out of the other systems' builds. -->
  <PropertyGroup>
    <InvokletDesktopOS Condition="$(RuntimeIdentifier.StartsWith('linux')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Linux')))">Linux</InvokletDesktopOS>
    <InvokletDesktopOS Condition="$(RuntimeIdentifier.StartsWith('osx')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('OSX')))">MacOS</InvokletDesktopOS>
    <InvokletDesktopOS Condition="$(RuntimeIdentifier.StartsWith('win')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows')))">Windows</InvokletDesktopOS>
    <DefineConstants Condition="'$(InvokletDesktopOS)' != ''">$(DefineConstants);INVOKLET_$(InvokletDesktopOS.ToUpperInvariant())</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\desktop\Invoklet.Desktop\Invoklet.Desktop.csproj" />
    <ProjectReference Condition="'$(InvokletDesktopOS)' != ''" Include="..\..\desktop\Invoklet.Desktop.$(InvokletDesktopOS)\Invoklet.Desktop.$(InvokletDesktopOS).csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**"/>
    <!-- The sidebar's Samples (Services/Examples/ExampleScripts): read from the assembly, never from disk.
         A subfolder is a folder of the Samples tree, kept in the resource name. -->
    <EmbeddedResource Include="Examples\**\*.inv" LogicalName="Invoklet.Examples.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shipped next to the executable by every installer (they all package the publish folder):
         the GPL-3.0 text, the end-user agreement shown by the MSI (installer/windows/License.rtf) and
         the MIT license of Invoklet.Runtime.dll, which is also shipped here, and the notices of every
         third-party component (generated by scripts/make-third-party-notices.py). -->
    <None Include="..\..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    <None Include="..\..\..\installer\EULA.txt" Link="EULA.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    <None Include="..\..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    <None Include="..\..\runtime\Invoklet.Runtime\LICENSE">
      <Link>LICENSE</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Invoklet.Runtime.UI.Tests"/>
    <InternalsVisibleTo Include="Invoklet.IntegrationTests"/>
    <InternalsVisibleTo Include="Invoklet.NonUI.Tests"/>
    <!-- Moq builds its proxies of internal interfaces in this assembly. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia"/>
    <PackageReference Include="Avalonia.Controls.DataGrid"/>
    <PackageReference Include="TextMateSharp.Grammars"/>

    <PackageReference Include="Avalonia.Desktop"/>
    <PackageReference Include="Avalonia.Themes.Fluent"/>
    <PackageReference Include="Avalonia.Fonts.Inter"/>
    <PackageReference Include="Avalonia.ReactiveUI"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
    <PackageReference Include="Microsoft.Extensions.Logging"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Console"/>
    <PackageReference Include="System.Composition.AttributedModel"/>
    <PackageReference Include="System.Configuration.ConfigurationManager"/>
    <PackageReference Include="System.Security.Cryptography.ProtectedData"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Local fork — was Avalonia.AvaloniaEdit/AvaloniaEdit.TextMate NuGet packages;
         Invoklet's own code (EditorTabItemControl/SquiggleRenderer/SemanticHighlighter) uses AvaloniaEdit
         types directly, not just through Invoklet.Avalonia.CodeTextEditor, hence the direct reference. -->
    <ProjectReference Include="..\..\controls\AvaloniaEdit\AvaloniaEdit.csproj"/>
    <ProjectReference Include="..\..\controls\AvaloniaEdit.TextMate\AvaloniaEdit.TextMate.csproj"/>
    <ProjectReference Include="..\..\controls\Invoklet.Avalonia.CodeTextEditor\Invoklet.Avalonia.CodeTextEditor.csproj" />
    <ProjectReference Include="..\..\controls\Invoklet.Avalonia.Themes\Invoklet.Avalonia.Themes.csproj" />
    <ProjectReference Include="..\..\controls\Invoklet.Avalonia.HtmlRenderer\Invoklet.Avalonia.HtmlRenderer.csproj" />
    <ProjectReference Include="..\..\controls\MarkView.Avalonia\MarkView.Avalonia.csproj"/>
    <ProjectReference Include="..\..\controls\MarkView.Avalonia.SyntaxHighlighting\MarkView.Avalonia.SyntaxHighlighting.csproj"/>
    <ProjectReference Include="..\..\core\Invoklet.Format.MdRun\Invoklet.Format.MdRun.csproj" />
    <ProjectReference Include="..\..\core\Invoklet.Build.Core\Invoklet.Build.Core.csproj" />
    <ProjectReference Include="..\..\connectors\Invoklet.Connectors.Http\Invoklet.Connectors.Http.csproj" />
    <ProjectReference Include="..\..\connectors\Invoklet.Connectors.Grpc\Invoklet.Connectors.Grpc.csproj" />
    <ProjectReference Include="..\..\connectors\Invoklet.Connectors.Sqlite\Invoklet.Connectors.Sqlite.csproj" />
    <ProjectReference Include="..\..\languages\Invoklet.Languages.CSharp\Invoklet.Languages.CSharp.csproj" />
    <ProjectReference Include="..\..\languages\Invoklet.Languages.VB\Invoklet.Languages.VB.csproj" />
    <ProjectReference Include="..\..\languages\Invoklet.Languages.DotnetCommon\Invoklet.Languages.DotnetCommon.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="UserControls\EditorTabControl.cs">
      <DependentUpon>EditorTabControl.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="UserControls\EditorTabsControl.cs">
      <DependentUpon>EditorTabsControl.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="UserControls\DebugPanel.cs">
      <DependentUpon>DebugPanel.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Windows\DependenciesWindow.axaml.cs">
      <DependentUpon>DependenciesWindow.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Windows\PreferencesWindow.axaml.cs">
      <DependentUpon>PreferencesWindow.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Windows\MainWindow.axaml.cs">
      <DependentUpon>MainWindow.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="UserControls\EditorTabItemControl.cs">
      <DependentUpon>EditorTabItemControl.axaml</DependentUpon>
    </Compile>
    <Compile Update="TemplatedControls\IconButton.cs">
      <DependentUpon>IconButton.axaml</DependentUpon>
    </Compile>
    <Compile Update="TemplatedControls\IconToggleButton.cs">
      <DependentUpon>IconToggleButton.axaml</DependentUpon>
    </Compile>
    <Compile Update="TemplatedControls\ToolbarComboBox.cs">
      <DependentUpon>ToolbarComboBox.axaml</DependentUpon>
    </Compile>
    <Compile Update="UserControls\FileTreeView.cs">
      <DependentUpon>FileTreeView.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="UserControls\EditorTabItemControl.Preview.cs">
      <DependentUpon>EditorTabItemControl.axaml</DependentUpon>
    </Compile>
    <Compile Update="UserControls\EditorTabItemControl.PreviewScroll.cs">
      <DependentUpon>EditorTabItemControl.axaml</DependentUpon>
    </Compile>
    <Compile Update="UserControls\ConnectionNavigationView.cs">
      <DependentUpon>ConnectionNavigationView.axaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="TemplatedControls\IconButton.axaml"/>
  </ItemGroup>
</Project>
