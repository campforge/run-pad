<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:edit="using:AvaloniaEdit"
             xmlns:cte="using:Invoklet.Avalonia.CodeTextEditor"
             xmlns:build="using:Invoklet.Contracts.Models"
             xmlns:vm="clr-namespace:Invoklet.UserControls.Models"
             xmlns:tc="clr-namespace:Invoklet.TemplatedControls"
             xmlns:uc="clr-namespace:Invoklet.UserControls"
             x:Class="Invoklet.UserControls.EditorsTabItemControl"
             x:DataType="vm:EditorTabItemViewModel">

    <UserControl.Resources>
        <DataTemplate x:Key="TabHeaderTemplate" x:DataType="vm:EditorTabItemViewModel">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <StackPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Save As..." Command="{Binding SaveAsCommand}">
                            <MenuItem.Icon>
                                <PathIcon Data="{StaticResource Icon.Save}" Width="16" Height="16"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Duplicate" Command="{Binding DuplicateCommand}" IsEnabled="{Binding HasFilePath}">
                            <MenuItem.Icon>
                                <PathIcon Data="{StaticResource Icon.Duplicate}" Width="16" Height="16"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Open Containing Folder" Command="{Binding OpenContainingFolderCommand}" IsEnabled="{Binding HasFilePath}">
                            <MenuItem.Icon>
                                <PathIcon Data="{StaticResource Icon.FolderOpen}" Width="16" Height="16"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </StackPanel.ContextMenu>
                <TextBlock Text="{Binding FileName}"
                           Classes.dirty="{Binding IsDirty}"
                           VerticalAlignment="Center"
                           FontSize="12"/>
                <Button Classes="TabClose"
                        Command="{Binding CloseCommand}"
                        VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource Icon.Close}"
                              Width="10" Height="10"/>
                </Button>
            </StackPanel>
        </DataTemplate>

        <!-- Referenced via ContentTemplate on the "Debugger" TabItem's ContentControl below.
             DataTemplate.Build() sets the built control's DataContext to the content object before
             it's attached to the tree, so DebugPanel's own compiled bindings never see this tab's
             EditorTabItemViewModel as an intermediate (wrong-typed) DataContext. -->
        <DataTemplate x:Key="DebugPanelTemplate" x:DataType="vm:DebugPanelViewModel">
            <uc:DebugPanel/>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Tab look: TabControl.panel in InvokletTheme. -->
        <Style Selector="TabControl.OutputTabs">
            <Setter Property="Background" Value="{DynamicResource Invoklet.Output.BackgroundBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="{Binding OutputPanel.Size, Mode=TwoWay}" MinHeight="0" MaxHeight="600"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="22"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Toolbar -->
        <Border Grid.Row="0"
                Background="{DynamicResource Invoklet.Toolbar.BackgroundBrush}"
                BorderBrush="{DynamicResource Invoklet.Toolbar.BorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Invoklet.Radius.Overlay}"
                ClipToBounds="True"
                Margin="6,4">
            <Panel>
                <StackPanel Orientation="Horizontal" Spacing="1" Margin="4,0"
                            Classes="Toolbar"
                            VerticalAlignment="Center">
                    <tc:IconButton
                        IconData="{StaticResource Icon.Play}"
                        Foreground="{DynamicResource Invoklet.Icon.PlayBrush}"
                        IsEnabled="{Binding EnableRunOrContinueButton}"
                        Click="RunOrContinueButton_Click"
                        ToolTip.Tip="{Binding TooltipRunOrContinue}"/>
                    <tc:IconButton
                        IconData="{StaticResource Icon.Stop}"
                        Foreground="{DynamicResource Invoklet.Icon.StopBrush}"
                        IsEnabled="{Binding EnableCancelButton}"
                        Click="CancelButton_Click"
                        ToolTip.Tip="{Binding TooltipCancel}"/>
                    <tc:ToolbarComboBox
                        Margin="4,0,0,0"
                        Height="24"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        ItemsSource="{Binding SdkChoices}"
                        SelectedItem="{Binding SelectedSdk}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="build:DotnetSdk">
                                <TextBlock Text="{Binding Description}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </tc:ToolbarComboBox>

                    <tc:ToolbarComboBox
                        Margin="4,0,0,0"
                        Height="24"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        ItemsSource="{Binding Kinds}"
                        SelectedItem="{Binding SelectedKind}">
                    </tc:ToolbarComboBox>

                    <tc:ToolbarComboBox
                        Margin="4,0,0,0"
                        Height="24"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        ItemsSource="{Binding ArgumentSetChoices}"
                        x:Name="ArgumentSetSelector"
                        SelectedItem="{Binding SelectedArgumentSet}"
                        ToolTip.Tip="Argument set"/>

                    <Border Width="1" Height="16"
                            Background="{DynamicResource Invoklet.Separator.BackgroundBrush}"
                            Margin="4,0"/>

                    <tc:IconToggleButton
                        IconData="{StaticResource Icon.Bug}"
                        CheckedBrush="{DynamicResource Invoklet.Icon.PlayBrush}"
                        IsChecked="{Binding DebugModeEnabled}"
                        ToolTip.Tip="Toggle debug mode"
                       />

                    <tc:IconToggleButton
                        x:Name="PreviewButton"
                        IconData="{StaticResource Icon.PreviewSide}"
                        CheckedBrush="{DynamicResource Invoklet.Icon.PlayBrush}"
                        IsChecked="{Binding PreviewShown}"
                        ToolTip.Tip="Show or hide the Markdown preview"
                        AutomationProperties.Name="Markdown preview"
                        />

                    <tc:IconButton
                        IconData="{StaticResource Icon.PanelBottom}"
                        Command="{Binding OutputPanel.ToggleCommand}"
                        ToolTip.Tip="Toggle output panel"
                        />

                    <!-- Debug-only controls: shown, not merely enabled, only while debugging
 — an idle toolbar shouldn't be cluttered with
                         inactive step/pause icons. -->
                    <Border Width="1" Height="16"
                            Background="{DynamicResource Invoklet.Separator.BackgroundBrush}"
                            Margin="4,0"
                            IsVisible="{Binding IsDebugging}"/>
                    <tc:IconButton
                        IconData="{StaticResource Icon.DebugStepOver}"
                        Foreground="{DynamicResource Invoklet.Icon.StepBrush}"
                        IsEnabled="{Binding IsPaused}"
                        IsVisible="{Binding IsDebugging}"
                        Click="DbgStepOver_Click"
                        ToolTip.Tip="{Binding TooltipStepOver}"
                        Width="24" Height="24"/>
                    <tc:IconButton
                        IconData="{StaticResource Icon.DebugStepInto}"
                        Foreground="{DynamicResource Invoklet.Icon.StepBrush}"
                        IsEnabled="{Binding IsPaused}"
                        IsVisible="{Binding IsDebugging}"
                        Click="DbgStepIn_Click"
                        ToolTip.Tip="{Binding TooltipStepIn}"
                        Width="24" Height="24"/>
                    <tc:IconButton
                        IconData="{StaticResource Icon.DebugStepOut}"
                        Foreground="{DynamicResource Invoklet.Icon.StepBrush}"
                        IsEnabled="{Binding IsPaused}"
                        IsVisible="{Binding IsDebugging}"
                        Click="DbgStepOut_Click"
                        ToolTip.Tip="{Binding TooltipStepOut}"
                        Width="24" Height="24"/>
                    <tc:IconButton
                        IconData="{StaticResource Icon.Pause}"
                        Foreground="{DynamicResource Invoklet.Icon.DebugBrush}"
                        IsVisible="{Binding IsDebugging}"
                        Click="DbgPause_Click"
                        ToolTip.Tip="Pause"
                        Width="24" Height="24"/>
                    <tc:IconButton
                        IconData="{StaticResource Icon.RunToCursor}"
                        Foreground="{DynamicResource Invoklet.Icon.StepBrush}"
                        IsEnabled="{Binding IsPaused}"
                        IsVisible="{Binding IsDebugging}"
                        Click="DbgRunToCursor_Click"
                        ToolTip.Tip="Run to Cursor"
                        Width="24" Height="24"/>
                </StackPanel>
                <ProgressBar VerticalAlignment="Bottom"
                             Height="1"
                             MinHeight="0"
                             IsIndeterminate="True"
                             IsVisible="{Binding IsRunningProgress}"
                             Foreground="{DynamicResource Invoklet.Tab.AccentBrush}"
                             Background="Transparent"
                             BorderThickness="0">
                    <ProgressBar.Effect>
                        <DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="8" Opacity="0.85"
                                          Color="{DynamicResource Invoklet.Tab.AccentColor}"/>
                    </ProgressBar.Effect>
                </ProgressBar>
            </Panel>
        </Border>

        <!-- Row 1: CodeTextEditor, and the Markdown preview beside it or in its place — the
             columns are set by ApplyPreviewMode. -->
        <Grid x:Name="EditorArea" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding Layout.EditorWidth, Mode=TwoWay}"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="{Binding Layout.PreviewWidth, Mode=TwoWay}"/>
            </Grid.ColumnDefinitions>
            <ContentPresenter x:Name="EditorHost" Grid.Column="0"/>
            <GridSplitter x:Name="PreviewSplitter"
                          Grid.Column="1"
                          Classes="seam"
                          ResizeDirection="Columns"
                          IsVisible="False"/>
            <ContentPresenter x:Name="PreviewHost" Grid.Column="2" IsVisible="False"/>
        </Grid>

        <!-- Row 2: GridSplitter -->
        <GridSplitter Grid.Row="2"
                      Classes="seam"
                      ResizeDirection="Rows"
                      HorizontalAlignment="Stretch"/>

        <!-- Row 3: Output tabs -->
        <TabControl x:Name="OutputTabsControl" Grid.Row="3" Classes="OutputTabs panel tool">
            <TabControl.Tag>
                            <tc:IconButton x:Name="OutputSettingsButton" Width="24" Height="24" Padding="6" Margin="0,0,8,0" IconData="{StaticResource Icon.Settings}"
                                    Foreground="{DynamicResource Invoklet.Text.SecondaryBrush}" ToolTip.Tip="Output settings" AutomationProperties.Name="Output settings">
                                <tc:IconButton.Resources>
                                    <x:Double x:Key="Invoklet.Size.ToolbarIcon">12</x:Double>
                                </tc:IconButton.Resources>
                                <tc:IconButton.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <StackPanel x:Name="OutputSettingsPanel" Spacing="6" MaxWidth="320">
                                            <TextBlock Text="Output settings" FontWeight="SemiBold"/>
                                            <CheckBox x:Name="ResultsWrapCheckBox" Content="Wrap long lines in results"/>
                                            <Separator Margin="0,2"/>
                                            <TextBlock Text="When debugging" Foreground="{DynamicResource Invoklet.Text.SecondaryBrush}"/>
                                            <CheckBox IsChecked="{Binding DebugPanel.BreakOnUncaughtExceptions, Mode=TwoWay}"
                                                      Content="Break on unhandled exceptions"/>
                                            <CheckBox IsChecked="{Binding DebugPanel.BreakOnAllExceptions, Mode=TwoWay}"
                                                      Content="Break on all exceptions (including caught)"/>
                                        </StackPanel>
                                    </Flyout>
                                </tc:IconButton.Flyout>
                            </tc:IconButton>
            </TabControl.Tag>

            <TabItem Header="Results">
                <uc:OutputHtmlView x:Name="ResultsOutput"/>
            </TabItem>

            <TabItem Header="Debugger">
                <ContentControl Content="{Binding DebugPanel}" ContentTemplate="{StaticResource DebugPanelTemplate}"/>
            </TabItem>

            <!-- Virtualized lines keep large disassemblies from laying out as one TextBox. -->
            <TabItem Header="IL">
                <edit:TextEditor x:Name="IlOutput"
                                 IsReadOnly="True" WordWrap="False" ShowLineNumbers="True"
                                 Background="{DynamicResource Invoklet.Output.BackgroundBrush}"
                                 Foreground="{DynamicResource Invoklet.Text.PrimaryBrush}"
                                 FontFamily="{x:Static cte:MonospaceFont.Default}" FontSize="12"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
            </TabItem>

        </TabControl>

        <!-- Row 4: interactive input (Util.ReadLine/GetPassword) — hidden until the
             running script actually asks for input; ShowInputPrompt/HideInputPrompt toggle it. -->
        <Border x:Name="InputPromptBar"
                Grid.Row="4"
                IsVisible="False"
                Background="{DynamicResource Invoklet.Toolbar.BackgroundBrush}"
                BorderBrush="{DynamicResource Invoklet.Toolbar.BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="8,6">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="InputPromptLabel"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           FontWeight="SemiBold"/>
                <TextBox x:Name="InputPromptBox" KeyDown="InputPromptBox_KeyDown"/>
            </DockPanel>
        </Border>

        <!-- Row 5: Status strip — status/elapsed on the left, caret position on the right -->
        <Grid Grid.Row="5"
              ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto"
              Background="{DynamicResource Invoklet.StatusBar.BackgroundBrush}">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" Margin="8,0,12,0" VerticalAlignment="Center">
                <Ellipse Fill="{DynamicResource Invoklet.Text.SecondaryBrush}" x:Name="ExecStatusIndicator" Width="6" Height="6" VerticalAlignment="Center"/>
                <TextBlock x:Name="ExecStatusBlock"
                       Foreground="{DynamicResource Invoklet.Text.SecondaryBrush}"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Text="Ready"/>
            </StackPanel>
            <TextBlock x:Name="ElapsedBlock"
                       Grid.Column="1"
                       Foreground="{DynamicResource Invoklet.StatusBar.ForegroundBrush}"
                       VerticalAlignment="Center"
                       FontSize="12"/>

            <!-- "{Kind} · {TargetSdk}" for the currently open .inv — set in SetDocumentContent. -->
            <TextBlock x:Name="ProjectInfoBlock"
                       Grid.Column="2"
                       Foreground="{DynamicResource Invoklet.StatusBar.ForegroundBrush}"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="12"/>

            <!-- Code zoom, shared by every editor (Ctrl/Cmd+wheel and View → Zoom change it too) —
                 percent on top of the interface scale, kept in sync by UpdateZoomButton. Presets
                 carry their percent in Tag. -->
            <Button x:Name="ZoomButton"
                    Grid.Column="4"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="6,0"
                    Margin="0,0,8,0"
                    MinHeight="0"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    Foreground="{DynamicResource Invoklet.StatusBar.ForegroundBrush}"
                    FontSize="12"
                    ToolTip.Tip="Code zoom in all editors, on top of the interface scale"
                    Content="100%">
                <Button.Flyout>
                    <MenuFlyout Placement="TopEdgeAlignedRight">
                        <MenuItem Header="Zoom In" Click="ZoomIn_Click"/>
                        <MenuItem Header="Zoom Out" Click="ZoomOut_Click"/>
                        <MenuItem Header="Reset (100%)" Tag="100" Click="ZoomPreset_Click"/>
                        <Separator/>
                        <MenuItem Header="50%" Tag="50" Click="ZoomPreset_Click"/>
                        <MenuItem Header="75%" Tag="75" Click="ZoomPreset_Click"/>
                        <MenuItem Header="100%" Tag="100" Click="ZoomPreset_Click"/>
                        <MenuItem Header="125%" Tag="125" Click="ZoomPreset_Click"/>
                        <MenuItem Header="150%" Tag="150" Click="ZoomPreset_Click"/>
                        <MenuItem Header="200%" Tag="200" Click="ZoomPreset_Click"/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <!-- "Line 0  Col 0" until the caret first moves (a tab that was never focused has no
                 known position yet) — kept rather than left blank so the strip doesn't jump. -->
            <TextBlock x:Name="StatusLine"
                       Grid.Column="5"
                       Foreground="{DynamicResource Invoklet.StatusBar.ForegroundBrush}"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Text="Line 0  Col 0"/>
        </Grid>

    </Grid>

</UserControl>
