<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:search="using:AvaloniaEdit.Search" x:Class="RunPad.Resources.PopupStyles">
    <Style Selector="FlyoutPresenter, MenuFlyoutPresenter, ContextMenu, ToolTip">
        <Setter Property="Background" Value="{DynamicResource RunPad.Panel.BackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource RunPad.Text.PrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource RunPad.Border.BackgroundBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource RunPad.Type.Body}"/>
    </Style>
    <!-- Items of menus and popup menus only: a MenuItem placed anywhere else keeps its own look. -->
    <Style Selector="Menu MenuItem, ContextMenu MenuItem, MenuFlyoutPresenter MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource RunPad.Text.PrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}"/>
    </Style>
    <Style Selector="MenuFlyoutPresenter Separator, ContextMenu Separator, Menu Separator">
        <Setter Property="Background" Value="{DynamicResource RunPad.Separator.BackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource RunPad.Separator.BackgroundBrush}"/>
    </Style>
    <Style Selector="FlyoutPresenter CheckBox /template/ ContentPresenter#PART_ContentPresenter, FlyoutPresenter CheckBox /template/ TextBlock">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource RunPad.Text.PrimaryBrush}"/>
    </Style>
    <Style Selector="FlyoutPresenter CheckBox:disabled /template/ TextBlock">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource RunPad.Text.SecondaryBrush}"/>
    </Style>
    <Style Selector="Menu MenuItem:pointerover /template/ Border#PART_LayoutRoot, Menu MenuItem:selected /template/ Border#PART_LayoutRoot, ContextMenu MenuItem:pointerover /template/ Border#PART_LayoutRoot, ContextMenu MenuItem:selected /template/ Border#PART_LayoutRoot, MenuFlyoutPresenter MenuItem:pointerover /template/ Border#PART_LayoutRoot, MenuFlyoutPresenter MenuItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource RunPad.Toolbar.Button.HoverBrush}"/>
    </Style>
    <Style Selector="search|SearchPanel">
        <Setter Property="Margin" Value="6,0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource RunPad.Panel.BackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource RunPad.Text.PrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource RunPad.Border.BackgroundBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}"/>
    </Style>
    <Style Selector="search|SearchPanel /template/ TextBox">
        <Setter Property="Background" Value="{DynamicResource RunPad.Editor.BackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource RunPad.Text.PrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource RunPad.Border.BackgroundBrush}"/>
    </Style>
    <Style Selector="search|SearchPanel /template/ Button, search|SearchPanel /template/ ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource RunPad.Text.SecondaryBrush}"/>
    </Style>
    <Style Selector="search|SearchPanel /template/ Button:pointerover, search|SearchPanel /template/ ToggleButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource RunPad.Toolbar.Button.HoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource RunPad.Text.PrimaryBrush}"/>
    </Style>
    <Style Selector="ToggleButton.searchOption">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource RunPad.Text.SecondaryBrush}"/>
    </Style>
    <Style Selector="ToggleButton.searchOption:pointerover">
        <Setter Property="Background" Value="{DynamicResource RunPad.Toolbar.Button.HoverBrush}"/>
    </Style>
    <Style Selector="ToggleButton.searchOption:checked, ToggleButton.searchOption:checked:pointerover">
        <Setter Property="Background" Value="{DynamicResource RunPad.ToolTab.SelectedBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource RunPad.Text.PrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource RunPad.Tab.AccentBrush}"/>
    </Style>
    <Style Selector="search|SearchPanel /template/ TextBox:focus-within">
        <Setter Property="BorderBrush" Value="{DynamicResource RunPad.Focus.BorderBrush}"/>
    </Style>
    <Style Selector="search|SearchPanel /template/ Button.replaceAction">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource RunPad.Border.BackgroundBrush}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
</Styles>
