<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="using:RunPad.Avalonia.Themes"
             x:Class="RunPad.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://RunPad/Resources/Icons.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <themes:RunPadTheme />
        <StyleInclude Source="avares://RunPad/TemplatedControls/IconButton.axaml"/>
        <StyleInclude Source="avares://RunPad/TemplatedControls/IconToggleButton.axaml"/>
        <StyleInclude Source="avares://RunPad/TemplatedControls/ToolbarComboBox.axaml"/>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    </Application.Styles>
</Application>
