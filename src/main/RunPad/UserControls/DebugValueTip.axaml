<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:RunPad.UserControls.Models"
             x:Class="RunPad.UserControls.DebugValueTip"
             x:DataType="models:DebugLocal">

    <!-- The debugger's value tip: one variable as a lazily expanded tree, in the sidebar trees' row
         template (TreeView.navigation), with denser rows and the value coloured like .Dump() output. -->
    <UserControl.Styles>
        <Style Selector="TreeView.debug-value TreeViewItem" x:DataType="models:DebugLocal">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Padding" Value="4,0,8,0"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="(DragDrop.AllowDrop)" Value="False"/>
        </Style>
        <Style Selector="TreeView.debug-value TreeViewItem TextBlock">
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="Foreground" Value="{DynamicResource RunPad.Text.PrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.value.string">
            <Setter Property="Foreground" Value="{DynamicResource RunPad.Dump.StringBrush}"/>
        </Style>
        <Style Selector="TextBlock.value.number">
            <Setter Property="Foreground" Value="{DynamicResource RunPad.Dump.NumberBrush}"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource RunPad.Panel.BackgroundBrush}"
            BorderBrush="{DynamicResource RunPad.Toolbar.BorderBrush}"
            BorderThickness="1" CornerRadius="4" Padding="2">
        <TreeView x:Name="Tree"
                  Classes="navigation transient-selection debug-value"
                  MinWidth="220" MaxWidth="640" MaxHeight="360"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <TreeView.ItemTemplate>
                <TreeDataTemplate x:DataType="models:DebugLocal" ItemsSource="{Binding Children}">
                    <!-- Rider's "name = {Type} value"; a long value is cut, the whole of it is in the tip. -->
                    <DockPanel ToolTip.Tip="{Binding Value}">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource RunPad.Text.PrimaryBrush}"/>
                        <TextBlock DockPanel.Dock="Left" Text=" = " IsVisible="{Binding Name, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"/>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding TypeName, StringFormat='{}{{{0}}} '}"
                                   IsVisible="{Binding TypeName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"/>
                        <TextBlock Classes="value" Classes.string="{Binding IsStringValue}"
                                   Classes.number="{Binding IsNumberValue}"
                                   Text="{Binding Value}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Border>
</UserControl>
