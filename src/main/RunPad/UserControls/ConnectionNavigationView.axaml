<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:RunPad.UserControls.Models"
             xmlns:conv="clr-namespace:RunPad.Converters"
             x:Class="RunPad.UserControls.ConnectionNavigationView"
             x:DataType="models:ConnectionNavigationViewModel">

    <!-- The Connections bundle of the sidebar. Rows share the file tree's geometry (FileTreeView):
         27 px rows, 14 px icons, the same hover and selection brushes and corner radius. -->
    <StackPanel>
        <TextBlock x:Name="ErrorText" Text="{Binding Error}" IsVisible="{Binding HasError}"
                   TextWrapping="Wrap" Margin="12,4,8,4" FontSize="12"
                   Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"/>

        <Border x:Name="NoticeBar" IsVisible="{Binding HasNotice}" Margin="8,2,8,4" Padding="6,4"
                CornerRadius="5" Background="{DynamicResource RunPad.Toolbar.Button.HoverBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="DismissNoticeButton" Padding="4,0" MinHeight="0"
                        Background="Transparent" BorderThickness="0" VerticalAlignment="Top"
                        AutomationProperties.Name="Dismiss" ToolTip.Tip="Dismiss" Click="DismissNotice_Click">
                    <PathIcon Data="{StaticResource Icon.Close}" Width="10" Height="10"/>
                </Button>
                <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="12"/>
            </DockPanel>
        </Border>

        <StackPanel x:Name="EmptyState" IsVisible="{Binding IsEmpty}" Margin="12,4,8,8" Spacing="4">
            <TextBlock Text="No connections yet." FontSize="12" Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"/>
            <Button x:Name="AddConnectionButton" Content="Add Connection…" Padding="8,2" FontSize="12"
                    AutomationProperties.Name="Add connection" Click="ManageConnections_Click"/>
        </StackPanel>

        <TreeView x:Name="ConnectionTree"
                  ItemsSource="{Binding Nodes}"
                  IsVisible="{Binding !IsEmpty}"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="4,0,4,8"
                  SelectionMode="Single"
                  AutomationProperties.Name="Connections"
                  KeyDown="ConnectionTree_KeyDown"
                  DoubleTapped="ConnectionTree_DoubleTapped">

            <TreeView.Styles>
                <Style Selector="TreeViewItem" x:DataType="models:ConnectionNavigationNode">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <Setter Property="(AutomationProperties.Name)" Value="{Binding AccessibleName}"/>
                    <Setter Property="(ToolTip.Tip)" Value="{Binding ToolTip}"/>
                    <Setter Property="Padding" Value="6,0,6,0"/>
                    <Setter Property="MinHeight" Value="27"/>
                    <Setter Property="Margin" Value="0,0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="(DragDrop.AllowDrop)" Value="True"/>
                </Style>
                <Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
                    <Setter Property="Background" Value="{DynamicResource RunPad.Toolbar.Button.HoverBrush}"/>
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
                <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
                    <Setter Property="Background" Value="{DynamicResource RunPad.Accent.BackgroundBrush}"/>
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
                <Style Selector="TreeViewItem:selected /template/ Border#SelectionIndicator">
                    <Setter Property="IsVisible" Value="False"/>
                </Style>
                <Style Selector="TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
                    <Setter Property="Foreground" Value="{DynamicResource RunPad.Text.PrimaryBrush}"/>
                </Style>
                <Style Selector="TreeViewItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
                    <Setter Property="Foreground" Value="{DynamicResource RunPad.Accent.ForegroundBrush}"/>
                </Style>
                <Style Selector="TreeViewItem TextBlock">
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
                <Style Selector="TreeViewItem TextBlock.count">
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Opacity" Value="0.6"/>
                </Style>
                <Style Selector="TreeViewItem:focus /template/ Border#PART_LayoutRoot">
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </TreeView.Styles>

            <TreeView.ItemTemplate>
                <TreeDataTemplate DataType="models:ConnectionNavigationNode" ItemsSource="{Binding Children}">
                    <Panel VerticalAlignment="Center" Margin="0,1">
                        <Border IsVisible="{Binding IsDropTarget}"
                                Background="{DynamicResource RunPad.Accent.BackgroundBrush}"
                                CornerRadius="5" Margin="-6,-3"/>

                        <DockPanel IsVisible="{Binding !IsRenaming}" VerticalAlignment="Center">
                            <!-- Badges: an icon plus the tooltip and the row's accessible name, never color alone. -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" Margin="6,0,0,0">
                                <PathIcon x:Name="AttachedBadge" Data="{StaticResource Icon.ConnectionAttached}"
                                          Width="12" Height="12" IsVisible="{Binding IsAttached}"
                                          ToolTip.Tip="Used by this script"
                                          Foreground="{DynamicResource RunPad.Text.PrimaryBrush}"/>
                                <PathIcon Data="{StaticResource Icon.Warning}" Width="12" Height="12"
                                          IsVisible="{Binding IsDriverMissing}" ToolTip.Tip="Driver not available in this RunPad"
                                          Foreground="{DynamicResource RunPad.Text.PrimaryBrush}"/>
                                <TextBlock Classes="count" Text="{Binding ConnectionCount}" IsVisible="{Binding HasChildrenCount}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <Path Width="14" Height="14" Stretch="Uniform" Opacity="0.55" VerticalAlignment="Center"
                                      Data="{Binding IconKey, Converter={x:Static conv:ResourceKeyToGeometryConverter.Instance}}"
                                      Fill="{DynamicResource RunPad.Text.PrimaryBrush}"/>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>

                        <TextBox Text="{Binding EditingName, Mode=TwoWay}"
                                 IsVisible="{Binding IsRenaming}"
                                 FontSize="13" Padding="3,1" MinHeight="0" BorderThickness="1"
                                 VerticalAlignment="Center"
                                 AutomationProperties.Name="Group name"
                                 KeyDown="RenameBox_KeyDown"
                                 LostFocus="RenameBox_LostFocus"/>
                    </Panel>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </StackPanel>
</UserControl>
