<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:RunPad.UserControls.Models"
             xmlns:conv="clr-namespace:RunPad.Converters"
             x:Class="RunPad.UserControls.FileTreeView"
             x:DataType="models:FileTreeViewModel">

    <!-- The sidebar's Queries tab names this panel (MainWindow), so it has no heading of its own. -->
    <Grid>
        <TreeView Name="FileTree"
                  ItemsSource="{Binding Nodes}"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="4,4,4,8"
                  SelectionMode="Single"
                  KeyDown="FileTree_KeyDown"
                  SelectionChanged="FileTree_SelectionChanged">

            <TreeView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Rename" Click="ContextRename_Click">
                        <MenuItem.Icon>
                            <PathIcon Data="{StaticResource Icon.Rename}" Width="16" Height="16" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Delete" Click="ContextDelete_Click">
                        <MenuItem.Icon>
                            <PathIcon Data="{StaticResource Icon.Delete}" Width="16" Height="16" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <!-- One item per registered language, added by FileTreeView.OnDataContextChanged. -->
                    <MenuItem Name="NewFileMenu" Header="New File">
                        <MenuItem.Icon>
                            <PathIcon Data="{StaticResource Icon.Plus}" Width="16" Height="16" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="New Folder" Click="ContextCreateFolder_Click">
                        <MenuItem.Icon>
                            <PathIcon Data="{StaticResource Icon.FolderOpen}" Width="16" Height="16" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Show in File Manager" Click="ContextOpenFolder_Click">
                        <MenuItem.Icon>
                            <PathIcon Data="{StaticResource Icon.FolderOpen}" Width="16" Height="16" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </TreeView.ContextMenu>

            <TreeView.Styles>
                <Style Selector="TreeViewItem">
                    <Setter Property="Padding" Value="6,0,6,0" />
                    <Setter Property="MinHeight" Value="27" />
                    <Setter Property="Margin" Value="0,0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Cursor" Value="Hand" />
                    <!-- AllowDrop on the outer TreeView alone wasn't enough for a real
                         drop to land on individual rows — needs to be set on each TreeViewItem
                         container too. -->
                    <Setter Property="(DragDrop.AllowDrop)" Value="True" />
                </Style>
                <Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
                    <Setter Property="Background" Value="{DynamicResource RunPad.Toolbar.Button.HoverBrush}" />
                    <Setter Property="CornerRadius" Value="5" />
                </Style>
                <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
                    <Setter Property="Background" Value="{DynamicResource RunPad.Accent.BackgroundBrush}" />
                    <Setter Property="CornerRadius" Value="5" />
                </Style>
                <Style Selector="TreeViewItem:selected /template/ Border#SelectionIndicator">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <!-- The text color is set on each item's own header, not on "TreeViewItem:selected TextBlock":
                     that selector also matched the text of the selected item's children, which turned white
                     on the light background. -->
                <Style Selector="TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
                    <Setter Property="Foreground" Value="{DynamicResource RunPad.Text.PrimaryBrush}" />
                </Style>
                <Style Selector="TreeViewItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
                    <Setter Property="Foreground" Value="{DynamicResource RunPad.Accent.ForegroundBrush}" />
                </Style>
                <Style Selector="TreeViewItem TextBlock">
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style Selector="TreeViewItem:focus /template/ Border#PART_LayoutRoot">
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </TreeView.Styles>

            <TreeView.ItemTemplate>
                <TreeDataTemplate DataType="models:FileTreeViewNode" ItemsSource="{Binding SubNodes}">
                    <Panel VerticalAlignment="Center" Margin="0,1">

                        <!-- Drop-target highlight, toggled by FileTreeView's drag
                             handlers on whatever node the pointer is currently over during a drag —
                             drawn first (behind the icon/text) so it reads as a row highlight. -->
                        <Border IsVisible="{Binding IsDropTarget}"
                                Background="{DynamicResource RunPad.Accent.BackgroundBrush}"
                                CornerRadius="5"
                                Margin="-6,-3" />

                        <StackPanel Orientation="Horizontal" Spacing="7"
                                    IsVisible="{Binding !IsRenaming}"
                                    VerticalAlignment="Center">
                            <Panel Width="14" Height="14" VerticalAlignment="Center">
                                <!-- Folder (existing icon, reused) vs. file — and for a file, its
                                     language's own Material Design icon if one exists, or the
                                     generic file icon otherwise. One brush throughout
                                     — the icon's own shape identifies the language, not its color. -->
                                <PathIcon IsVisible="{Binding IsFolder}"
                                          Data="{StaticResource Icon.FolderOpen}"
                                          Width="14" Height="14"
                                          Opacity="0.55"
                                          Foreground="{DynamicResource RunPad.Text.PrimaryBrush}" />
                                <Path IsVisible="{Binding LanguageIconKey, Converter={x:Static ObjectConverters.IsNotNull}}"
                                      Data="{Binding LanguageIconKey, Converter={x:Static conv:ResourceKeyToGeometryConverter.Instance}}"
                                      Stretch="Uniform"
                                      Opacity="0.55"
                                      Fill="{DynamicResource RunPad.Text.PrimaryBrush}" />
                                <Path IsVisible="{Binding ShowGenericFileIcon}"
                                      Width="12" Height="14"
                                      HorizontalAlignment="Left"
                                      Stretch="Fill"
                                      Opacity="0.55"
                                      Fill="{DynamicResource RunPad.Text.PrimaryBrush}"
                                      Data="M1,0 L7.5,0 L11,3.5 L11,14 L1,14 Z M7.5,0 L7.5,3.5 L11,3.5 Z" />
                            </Panel>
                            <TextBlock Text="{Binding DisplayName}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBox Text="{Binding EditingName, Mode=TwoWay}"
                                 IsVisible="{Binding IsRenaming}"
                                 FontSize="13"
                                 Padding="3,1"
                                 MinHeight="0"
                                 BorderThickness="1"
                                 VerticalAlignment="Center"
                                 KeyDown="RenameBox_KeyDown"
                                 LostFocus="RenameBox_LostFocus" />
                    </Panel>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</UserControl>
