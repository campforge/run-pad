<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cte="using:RunPad.Avalonia.CodeTextEditor"
             xmlns:models="clr-namespace:RunPad.UserControls.Models"
             x:Class="RunPad.UserControls.DebugPanel"
             x:DataType="models:DebugPanelViewModel">

    <UserControl.Styles>

        <!-- Tab look: TabControl.panel.nested in RunPadTheme. -->
        <Style Selector="TabControl.panel">
            <Setter Property="Background" Value="{DynamicResource RunPad.Output.BackgroundBrush}"/>
        </Style>

        <Style Selector="DataGrid">
            <Setter Property="Background"               Value="{DynamicResource RunPad.Output.BackgroundBrush}"/>
            <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource RunPad.Separator.BackgroundBrush}"/>
            <Setter Property="RowHeight"                Value="22"/>
            <Setter Property="CanUserResizeColumns"     Value="True"/>
            <Setter Property="CanUserReorderColumns"    Value="False"/>
            <Setter Property="CanUserSortColumns"       Value="False"/>
            <Setter Property="SelectionMode"            Value="Single"/>
            <Setter Property="BorderThickness"          Value="0"/>
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource RunPad.Panel.BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource RunPad.Text.SecondaryBrush}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Padding"    Value="8,0"/>
            <Setter Property="Height"     Value="22"/>
        </Style>
        <Style Selector="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource RunPad.Output.BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource RunPad.Text.PrimaryBrush}"/>
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Watch toolbar buttons -->
        <Style Selector="Button.WatchBtn">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Height"          Value="24"/>
            <Setter Property="Padding"         Value="8,0"/>
            <Setter Property="Foreground"      Value="{DynamicResource RunPad.Text.SecondaryBrush}"/>
        </Style>
        <Style Selector="Button.WatchBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource RunPad.Toolbar.Button.HoverBrush}"/>
        </Style>

        <Style Selector="TabControl.debug-variables">
            <Setter Property="Template">
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Background="{DynamicResource RunPad.Panel.BackgroundBrush}">
                            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
                            <Button x:Name="ExceptionsButton" Content="Exceptions…"
                                    Classes="WatchBtn" ToolTip.Tip="Exception break settings">
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <StackPanel Spacing="6" MaxWidth="320">
                                            <CheckBox IsChecked="{Binding BreakOnUncaughtExceptions, Mode=TwoWay}"
                                                      Content="Break on unhandled exceptions"/>
                                            <CheckBox IsChecked="{Binding BreakOnAllExceptions, Mode=TwoWay}"
                                                      Content="Break on all exceptions (including caught)"/>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </WrapPanel>
                        <ContentPresenter Name="PART_SelectedContentHost"
                                          Content="{TemplateBinding SelectedContent}"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                    </DockPanel>
                </ControlTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>

    <DockPanel>

    <!-- What the debugger reported about the current stop: the exception it stopped on and/or a
         rejected step. Hidden for an ordinary breakpoint/step/pause stop and while running. -->
    <Border DockPanel.Dock="Top"
            Name="StopInfoBorder"
            Background="{DynamicResource RunPad.Panel.BackgroundBrush}"
            BorderBrush="{DynamicResource RunPad.Separator.BackgroundBrush}"
            BorderThickness="0,0,0,1"
            Padding="8,6"
            IsVisible="{Binding StoppedException, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Spacing="4">
            <SelectableTextBlock Name="StoppedExceptionText"
                                 Text="{Binding StoppedException}"
                                 FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                 Foreground="{DynamicResource RunPad.Status.ErrorBrush}"/>
            <ScrollViewer MaxHeight="120"
                          HorizontalScrollBarVisibility="Auto"
                          IsVisible="{Binding StoppedExceptionDetails, Converter={x:Static ObjectConverters.IsNotNull}}">
                <SelectableTextBlock Name="StoppedExceptionDetailsText"
                                     Text="{Binding StoppedExceptionDetails}"
                                     FontSize="11" FontFamily="{x:Static cte:MonospaceFont.Default}"
                                     Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"/>
            </ScrollViewer>
        </StackPanel>
    </Border>
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource RunPad.Panel.BackgroundBrush}"
            BorderBrush="{DynamicResource RunPad.Separator.BackgroundBrush}"
            BorderThickness="0,0,0,1"
            Padding="8,4"
            IsVisible="{Binding StopNotice, Converter={x:Static ObjectConverters.IsNotNull}}">
        <SelectableTextBlock Name="StopNoticeText"
                             Text="{Binding StopNotice}"
                             FontSize="12" TextWrapping="Wrap"
                             Foreground="{DynamicResource RunPad.Text.PrimaryBrush}"/>
    </Border>

    <Grid x:Name="DebugWorkspace" ColumnDefinitions="2*,1,3*">
        <DockPanel Grid.Column="0" MinWidth="0">
            <Expander x:Name="ThreadsExpander" DockPanel.Dock="Top" Header="Threads"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      ToolTip.Tip="Threads reported at the current stop">
                <DataGrid MaxHeight="110" ItemsSource="{Binding DebugThreads}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="ID" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Id}"
                                           Padding="8,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource RunPad.Text.PrimaryBrush}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Name" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           Padding="8,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource RunPad.Text.PrimaryBrush}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            </Expander>
            <TextBlock DockPanel.Dock="Top" Text="Call Stack" Padding="8,5" FontSize="12"
                       Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"/>
            <DataGrid x:Name="CallStackGrid" ItemsSource="{Binding DebugCallStack}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Method" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MethodName}"
                                           Padding="8,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource RunPad.Text.PrimaryBrush}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="File" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FileName}"
                                           Padding="8,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource RunPad.Text.PrimaryBrush}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Line" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}"
                                           Padding="8,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <GridSplitter Grid.Column="1" Classes="seam vertical" ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"/>
        <TabControl x:Name="VariableTabs" Grid.Column="2" Classes="panel nested tool debug-variables" MinWidth="0">
            <TabItem Header="Locals"><Grid RowDefinitions="22,*">

                <!-- Column header row -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,2*,*"
                      Background="{DynamicResource RunPad.Panel.BackgroundBrush}">
                    <TextBlock Grid.Column="0" Text="Name"
                               Padding="24,0,4,0" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="Value"
                               Padding="4,0" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"/>
                    <TextBlock Grid.Column="2" Text="Type"
                               Padding="4,0" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"/>
                </Grid>

                <!-- Variable tree -->
                <TreeView Grid.Row="1"
                          ItemsSource="{Binding DebugLocals}"
                          Background="{DynamicResource RunPad.Output.BackgroundBrush}">
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem" x:DataType="models:DebugLocal">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="Padding"    Value="0"/>
                            <Setter Property="MinHeight"  Value="22"/>
                        </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}">
                            <Grid ColumnDefinitions="*,2*,*" MinHeight="22">
                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                           Padding="4,0" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource RunPad.Text.PrimaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value}"
                                           Padding="4,0" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource RunPad.Text.PrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding TypeName}"
                                           Padding="4,0" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

            </Grid></TabItem>
            <TabItem Header="Watch"><Grid RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Orientation="Horizontal"
                            Background="{DynamicResource RunPad.Panel.BackgroundBrush}">
                    <Button Classes="WatchBtn" Command="{Binding AddWatchCommand}"    Content="+ Add"/>
                    <Button Classes="WatchBtn" Command="{Binding RemoveWatchCommand}" Content="− Remove"/>
                </StackPanel>
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding WatchExpressions}"
                          SelectedItem="{Binding SelectedWatchExpression}"
                          AutoGenerateColumns="False"
                          IsReadOnly="False">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Expression" Width="*" IsReadOnly="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Expression}"
                                               Padding="8,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource RunPad.Text.PrimaryBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Expression}" Padding="6,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Value" Width="2*" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Value}"
                                               Padding="8,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource RunPad.Text.PrimaryBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Type" Width="*" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TypeName}"
                                               Padding="8,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid></TabItem>
        </TabControl>
    </Grid>
    </DockPanel>
</UserControl>
