<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:RunPad.Windows.Models"
        x:Class="RunPad.Windows.DependenciesWindow"
        x:DataType="viewModels:DependenciesWindowViewModel"
        Title="NuGet Packages"
        Width="980" Height="620"
        MinWidth="700" MinHeight="420"
        CanResize="True"
        Background="{DynamicResource RunPad.Panel.BackgroundBrush}"
        Foreground="{DynamicResource RunPad.Text.PrimaryBrush}">

    <Grid RowDefinitions="*,Auto" Margin="12">

        <TabControl Grid.Row="0">

            <!-- ─── Packages ──────────────────────────────────────────────────── -->
            <TabItem Header="Packages">
                <Grid RowDefinitions="Auto,*" Margin="0,8,0,0">

                    <!-- Search box -->
                    <TextBox Grid.Row="0"
                             Text="{Binding SearchText}"
                             PlaceholderText="Search NuGet packages…"
                             Margin="0,0,0,8"/>

                    <!-- Three columns: search results | local cache | script packages -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,1,230,1,230">

                        <!-- ── Search results ───────────────────────────────── -->
                        <Grid Grid.Column="0" RowDefinitions="2,*">

                            <ProgressBar Grid.Row="0"
                                         IsIndeterminate="True"
                                         IsVisible="{Binding IsLoading}"
                                         Height="2"/>

                            <Panel Grid.Row="1">

                                <TextBlock Text="Enter a package name to search"
                                           IsVisible="{Binding ShowIdleMessage}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"
                                           FontSize="14"/>

                                <TextBlock Text="No packages found"
                                           IsVisible="{Binding ShowEmptyState}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"
                                           FontSize="14"/>

                                <TextBlock Text="{Binding ErrorMessage}"
                                           IsVisible="{Binding HasError}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#E05C5C"
                                           FontSize="13"/>

                                <ListBox ItemsSource="{Binding Results}"
                                         IsVisible="{Binding HasResults}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         Padding="0">
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="viewModels:PackageResultViewModel">
                                            <Border Padding="8,7"
                                                    BorderBrush="#20808080"
                                                    BorderThickness="0,0,0,1">
                                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                                    <!-- Id + version -->
                                                    <StackPanel Grid.Row="0" Grid.Column="0"
                                                                Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Id}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource RunPad.Text.PrimaryBrush}"/>
                                                        <TextBlock Text="{Binding Version}"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"/>
                                                        <TextBlock Text="{Binding Downloads}"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"/>
                                                    </StackPanel>
                                                    <!-- Add button -->
                                                    <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                                            Content="+"
                                                            Command="{Binding AddCommand}"
                                                            VerticalAlignment="Center"
                                                            Padding="10,4"
                                                            FontSize="16"
                                                            Margin="8,0,0,0"/>
                                                    <!-- Description -->
                                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                                               Text="{Binding Description}"
                                                               FontSize="11"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="2"
                                                               Margin="0,2,0,0"
                                                               Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                            </Panel>
                        </Grid>

                        <!-- Divider -->
                        <Rectangle Grid.Column="1" Fill="#20808080" Margin="8,0"/>

                        <!-- ── Local cache ──────────────────────────────────── -->
                        <Grid Grid.Column="2" RowDefinitions="Auto,*">

                            <TextBlock Grid.Row="0"
                                       Text="LOCAL CACHE"
                                       FontSize="10" FontWeight="SemiBold"
                                       LetterSpacing="1"
                                       Margin="8,0,0,8"
                                       Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"/>

                            <TextBlock Grid.Row="1"
                                       Text="No packages in local cache"
                                       IsVisible="{Binding !HasCacheItems}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"
                                       FontSize="12"/>

                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding CacheItems}"
                                     IsVisible="{Binding HasCacheItems}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     Padding="0">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="viewModels:CachedPackageItemViewModel">
                                        <Border Padding="6,4"
                                                BorderBrush="#20808080"
                                                BorderThickness="0,0,0,1"
                                                Classes.in-script="{Binding IsInScript}">
                                            <Border.Styles>
                                                <Style Selector="Border.in-script TextBlock.pkg-id">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}"/>
                                                </Style>
                                                <Style Selector="Border.in-script Button.cache-toggle">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}"/>
                                                    <Setter Property="Opacity" Value="1"/>
                                                </Style>
                                            </Border.Styles>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Spacing="1">
                                                    <TextBlock Classes="pkg-id"
                                                               Text="{Binding Id}"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource RunPad.Text.PrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Version}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Classes="cache-toggle"
                                                        Command="{Binding ToggleCommand}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="6,2"
                                                        FontSize="14"
                                                        Opacity="0.5"
                                                        VerticalAlignment="Center">
                                                    <Panel>
                                                        <TextBlock Text="+"
                                                                   IsVisible="{Binding !IsInScript}"
                                                                   FontSize="16"/>
                                                        <TextBlock Text="−"
                                                                   IsVisible="{Binding IsInScript}"
                                                                   FontSize="16"/>
                                                    </Panel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                        </Grid>

                        <!-- Divider -->
                        <Rectangle Grid.Column="3" Fill="#20808080" Margin="8,0"/>

                        <!-- ── Script packages ──────────────────────────────── -->
                        <Grid Grid.Column="4" RowDefinitions="Auto,*">

                            <TextBlock Grid.Row="0"
                                       Text="SCRIPT PACKAGES"
                                       FontSize="10" FontWeight="SemiBold"
                                       LetterSpacing="1"
                                       Margin="8,0,0,8"
                                       Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"/>

                            <Panel Grid.Row="1">

                                <TextBlock Text="Open a script to manage packages"
                                           IsVisible="{Binding !HasFrontMatter}"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"
                                           FontSize="12"
                                           MaxWidth="180"
                                           TextAlignment="Center"/>

                                <TextBlock Text="No packages added"
                                           IsVisible="{Binding ShowNoPackagesHint}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"
                                           FontSize="12"/>

                                <ListBox ItemsSource="{Binding ScriptPackages}"
                                         IsVisible="{Binding HasScriptPackages}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         Padding="0">
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="viewModels:ScriptPackageItemViewModel">
                                            <Border Padding="6,5"
                                                    BorderBrush="#20808080"
                                                    BorderThickness="0,0,0,1">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" Spacing="1">
                                                        <TextBlock Text="{Binding Id}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource SystemAccentColor}"/>
                                                        <TextBlock Text="{Binding Version}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Content="×"
                                                            Command="{Binding RemoveCommand}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="8,2"
                                                            FontSize="15"
                                                            Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"
                                                            VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                            </Panel>
                        </Grid>

                    </Grid>
                </Grid>
            </TabItem>

            <!-- ─── Imports ───────────────────────────────────────────────────── -->
            <TabItem Header="Imports">
                <Grid RowDefinitions="Auto,*" Margin="0,8,0,0">

                    <!-- Add new using (disabled when no script is open) -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8"
                          IsEnabled="{Binding HasFrontMatter}">
                        <TextBox Grid.Column="0"
                                 Text="{Binding NewUsing}"
                                 PlaceholderText="Namespace (e.g. System.Text.Json)"
                                 KeyDown="NewUsing_KeyDown"/>
                        <Button Grid.Column="1"
                                Content="Add"
                                Command="{Binding AddUsingCommand}"
                                Margin="8,0,0,0"/>
                    </Grid>

                    <!-- Usings list -->
                    <Panel Grid.Row="1">

                        <TextBlock Text="Open a .rpad script to manage global imports"
                                   IsVisible="{Binding !HasFrontMatter}"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"
                                   FontSize="13"
                                   MaxWidth="280"
                                   TextAlignment="Center"/>

                        <TextBlock Text="No global imports. Add a namespace above to include it as a global using when the script runs."
                                   IsVisible="{Binding ShowNoUsingsHint}"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"
                                   FontSize="13"
                                   MaxWidth="320"
                                   TextAlignment="Center"/>

                        <ListBox ItemsSource="{Binding Usings}"
                                 IsVisible="{Binding HasUsings}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Padding="0">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="viewModels:UsingItemViewModel">
                                    <Border Padding="8,7"
                                            BorderBrush="#20808080"
                                            BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       FontSize="13"
                                                       FontFamily="Consolas,Menlo,monospace"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource RunPad.Text.PrimaryBrush}"/>
                                            <Button Grid.Column="1"
                                                    Content="×"
                                                    Command="{Binding RemoveCommand}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="8,2"
                                                    FontSize="16"
                                                    Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                    </Panel>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Footer -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0" Spacing="8">
            <Button Content="Close" Click="Close_Click"/>
        </StackPanel>

    </Grid>
</Window>
