<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RunPad.Windows.AssemblyExplorerWindow"
        Title="Assembly Explorer"
        Width="1100" Height="720"
        MinWidth="600" MinHeight="400"
        CanResize="True"
        Background="{DynamicResource RunPad.Panel.BackgroundBrush}"
        Foreground="{DynamicResource RunPad.Text.PrimaryBrush}">

    <Grid RowDefinitions="Auto,Auto,*" Margin="12">

        <Button x:Name="BrowseButton" Grid.Row="0" Content="Browse..." HorizontalAlignment="Left"/>

        <TextBlock x:Name="AssemblyPathBlock" Grid.Row="1" Margin="0,8,0,8"
                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"/>

        <Grid Grid.Row="2" ColumnDefinitions="260,5,*">

            <TreeView x:Name="TypeTree" Grid.Column="0"/>

            <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns"
                          Background="{DynamicResource RunPad.Separator.BackgroundBrush}"/>

            <ContentPresenter x:Name="EditorHost" Grid.Column="2"/>

        </Grid>

    </Grid>

</Window>
