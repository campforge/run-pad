<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RunPad.Windows.GoToLineDialog"
        Icon="/Assets/icon.ico"
        Title="Go to Line"
        Width="320" Height="150"
        MinWidth="280" MinHeight="140"
        CanResize="False"
        SizeToContent="Manual"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource RunPad.Panel.BackgroundBrush}"
        Foreground="{DynamicResource RunPad.Text.PrimaryBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://RunPad.Avalonia.Themes/Metrics.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>


    <Grid RowDefinitions="Auto,Auto,Auto" Margin="16">

        <TextBlock x:Name="PromptText"
                   Grid.Row="0"
                   FontSize="{DynamicResource RunPad.Type.Caption}"
                   Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"
                   Margin="0,0,0,6"/>

        <NumericUpDown x:Name="LineBox"
                        Grid.Row="1"
                        Minimum="1"
                        FormatString="0"
                        Margin="0,0,0,12"/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="{DynamicResource RunPad.Space.Control}">
            <Button Content="OK"
                    Width="80"
                    Click="OkButton_Click"
                    IsDefault="True"/>
            <Button Content="Cancel"
                    Width="80"
                    Click="CancelButton_Click"
                    IsCancel="True"/>
        </StackPanel>

    </Grid>

</Window>
