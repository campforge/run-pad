<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:RunPad.TemplatedControls"
        xmlns:viewModels="clr-namespace:RunPad.Windows.Models"
        x:Class="RunPad.Windows.SecretStoreWindow"
        x:DataType="viewModels:SecretStoreWindowViewModel"
        Title="Secret Store"
        Icon="/Assets/icon.ico"
        Width="600" Height="480"
        MinWidth="480" MinHeight="400"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource RunPad.Panel.BackgroundBrush}"
        Foreground="{DynamicResource RunPad.Text.PrimaryBrush}">

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource RunPad.Text.SecondaryBrush}"/>
        </Style>
        <Style Selector="StackPanel.side > Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto,Auto,Auto" Margin="16">

        <!-- Secret names; values never appear in the list. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource RunPad.Separator.BackgroundBrush}"
                    BorderThickness="1" CornerRadius="4">
                <Panel>
                <ListBox x:Name="SecretList"
                         ItemsSource="{Binding Secrets}"
                         SelectedItem="{Binding SelectedSecret}"
                         Background="Transparent"
                         BorderThickness="0"
                         AutomationProperties.Name="Secrets"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="viewModels:SecretItemViewModel">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="No secrets yet. Use Add to create one." Classes="hint" Margin="16" VerticalAlignment="Center" IsVisible="{Binding IsEmpty}"/>
                </Panel>
            </Border>

            <StackPanel Grid.Column="1" Classes="side" Spacing="6" Margin="8,0,0,0" Width="110">
                <Button Classes="secondary" x:Name="AddButton" Content="Add" Command="{Binding AddCommand}"/>
                <Button Classes="secondary" x:Name="RemoveButton" Content="Remove" Command="{Binding RemoveCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Editor for the selected secret; edits apply to the list directly, OK saves the store. -->
        <Grid Grid.Row="1"
              Margin="0,12,0,0"
              ColumnDefinitions="Auto,*,Auto"
              RowDefinitions="Auto,Auto"
              RowSpacing="8"
              IsEnabled="{Binding HasSelection}">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Name:"/>
            <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                     Text="{Binding SelectedSecret.Name, FallbackValue=''}"
                     AutomationProperties.Name="Secret name"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Value:"/>
            <controls:SecretTextBox x:Name="ValueBox" Grid.Row="1" Grid.Column="1"
                     Text="{Binding SelectedSecret.Value, FallbackValue=''}"
                     PasswordChar="{Binding ValuePasswordChar}"
                     AutomationProperties.Name="Secret value"/>
            <CheckBox x:Name="ShowValueBox" Grid.Row="1" Grid.Column="2" Margin="8,0,0,0"
                      Content="Show"
                      IsChecked="{Binding IsValueRevealed}"
                      AutomationProperties.Name="Show the value"/>
        </Grid>

        <TextBlock x:Name="StoreError" Grid.Row="2"
                   Margin="0,10,0,0"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource RunPad.Status.ErrorBrush}"
                   Text="{Binding StoreError}"
                   IsVisible="{Binding HasStoreError}"/>

        <Grid Grid.Row="3" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource RunPad.Status.ErrorBrush}"
                       Text="{Binding ValidationError}"
                       IsVisible="{Binding HasValidationError}"/>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="8">
                <Expander Header="Storage and usage" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="hint" Text="Scripts read saved values with Util.GetSecret(&quot;name&quot;). Encrypted for your Windows account; owner-only storage on macOS and Linux."/>
                        <SelectableTextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding StorePath}"/>
                    </StackPanel>
                </Expander>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Classes="secondary" x:Name="CancelButton" Content="Cancel" MinWidth="80" IsCancel="True" Click="Cancel_Click"/>
                    <Button x:Name="OkButton" Classes="primary" Content="Save" MinWidth="80" IsEnabled="{Binding CanSave}" Click="Ok_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
