<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RunPad.Windows.DialogLayout"
             x:Name="Root" x:CompileBindings="False">
    <Grid Margin="{DynamicResource RunPad.Dialog.Padding}"
          RowDefinitions="Auto,Auto" ColumnDefinitions="24,12,*">
        <Border Width="24" Height="24" CornerRadius="12" VerticalAlignment="Top"
                Background="{DynamicResource RunPad.Button.Primary.BackgroundBrush}">
            <TextBlock Text="?" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontWeight="SemiBold" FontSize="{DynamicResource RunPad.Type.Body}"
                       Foreground="{DynamicResource RunPad.Button.Primary.ForegroundBrush}"/>
        </Border>
        <StackPanel Grid.Column="2" Spacing="{DynamicResource RunPad.Space.Control}">
            <TextBlock Text="{Binding #Root.Heading}" TextWrapping="Wrap" FontWeight="SemiBold"
                       FontSize="{DynamicResource RunPad.Type.Body}"/>
            <TextBlock Text="{Binding #Root.FileName}" IsVisible="{Binding #Root.ShowFileName}"
                       TextWrapping="Wrap" FontWeight="SemiBold"
                       FontSize="{DynamicResource RunPad.Type.Body}"/>
            <TextBlock Text="{Binding #Root.Message}" TextWrapping="Wrap"
                       Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"
                       FontSize="{DynamicResource RunPad.Type.Body}"/>
            <ContentControl Content="{Binding #Root.Body}"/>
        </StackPanel>
        <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnDefinitions="Auto,*,Auto"
              Margin="{DynamicResource RunPad.Dialog.ActionsMargin}">
            <ContentControl Content="{Binding #Root.LeadingActions}" VerticalAlignment="Center"/>
            <ContentControl Grid.Column="2" Content="{Binding #Root.Actions}" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
