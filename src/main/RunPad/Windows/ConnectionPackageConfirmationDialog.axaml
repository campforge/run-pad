<local:RunPadDialogWindow xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:local="using:RunPad.Windows"
                         x:Class="RunPad.Windows.ConnectionPackageConfirmationDialog"
                         Icon="/Assets/icon.ico" Title="Add Connection"
                         Background="{DynamicResource RunPad.Panel.BackgroundBrush}"
                         Foreground="{DynamicResource RunPad.Text.PrimaryBrush}">
    <local:DialogLayout x:Name="Layout" Heading="Add connection to script?">
        <local:DialogLayout.Actions>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource RunPad.Space.Control}">
                <Button Content="Cancel" MinWidth="72" Click="Cancel_Click" IsCancel="True"/>
                <Button Content="Add Connection and Packages" MinWidth="190" Click="Add_Click" IsDefault="True"/>
            </StackPanel>
        </local:DialogLayout.Actions>
    </local:DialogLayout>
</local:RunPadDialogWindow>
