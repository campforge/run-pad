<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:RunPad.Windows.Models"
    xmlns:chrome="using:Avalonia.Controls.Chrome"
    xmlns:uc="clr-namespace:RunPad.UserControls"
    xmlns:ucm="clr-namespace:RunPad.UserControls.Models"
    xmlns:conv="clr-namespace:RunPad.Converters" mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450" x:Class="RunPad.Windows.MainWindow" x:DataType="vm:MainWindowViewModel" Icon="/Assets/icon.ico" Title="RunPad" WindowDecorations="BorderOnly" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="32">

    <Window.Resources>
        <!-- Referenced via ContentTemplate on the sidebar's ContentControl below. DataTemplate.Build()
             sets the built control's DataContext to the content object before it's attached to the
             tree, so FileTreeView's own compiled bindings never see this window's MainWindowViewModel
             as an intermediate (wrong-typed) DataContext. -->
        <DataTemplate x:Key="FileTreeTemplate" x:DataType="ucm:FileTreeViewModel">
            <uc:FileTreeView Open="FileTree_Open" Delete="FileTree_Delete" Rename="FileTree_Rename" OpenFolder="FileTree_OpenFolder" CreateFolder="FileTree_CreateFolder" CreateFile="FileTree_CreateFile" Move="FileTree_Move"/>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <!-- The sidebar's sections and trees. Included by the window itself, not the app, so the
             sidebar looks and lays out the same wherever the window is shown (tests included). -->
        <StyleInclude Source="avares://RunPad/Resources/NavigationStyles.axaml"/>

        <!-- Window control buttons -->
        <Style Selector="Button.wc-btn">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource RunPad.Text.SecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Name="root" Background="{TemplateBinding Background}" CornerRadius="0">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.wc-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource RunPad.Toolbar.Button.HoverBrush}"/>
        </Style>
        <Style Selector="Button.wc-close:pointerover">
            <Setter Property="Background" Value="#C42B1C"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.mac-window-btn">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.mac-window-btn:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.mac-window-btn:pressed">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.mac-window-btn:focus">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.mac-window-btn Path">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Window.Styles>

    <Grid x:Name="RootLayout" RowDefinitions="32,*">

        <!-- ── Title bar ─────────────────────────────────────────────────── -->
        <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource RunPad.Sidebar.BackgroundBrush}" chrome:WindowDecorationProperties.ElementRole="TitleBar">

            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Left: app icon + menu -->
                <StackPanel x:Name="TitleBarActions" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="0" chrome:WindowDecorationProperties.ElementRole="User">

                    <Image x:Name="AppIconImage" Source="/Assets/icon.ico" Width="16" Height="16" Margin="10,0,4,0" IsHitTestVisible="False" VerticalAlignment="Center"/>

                    <!-- Items come from MainWindow.CreateMainMenu (shared with the macOS NativeMenu). -->
                    <Menu x:Name="MainMenu" Background="Transparent" VerticalAlignment="Center">
                        <Menu.Styles>
                            <Style Selector="MenuItem">
                                <Setter Property="Padding" Value="4,4"/>
                                <Setter Property="FontSize" Value="14"/>
                            </Style>
                        </Menu.Styles>
                    </Menu>

                    <StackPanel x:Name="MacWindowButtons" Orientation="Horizontal" Spacing="2" Margin="4,0,4,0" VerticalAlignment="Center" IsVisible="False" PointerExited="MacWindowButtons_PointerExited">
                        <Button Classes="mac-window-btn" Click="Close_Click" PointerEntered="MacWindowButton_PointerEntered" AutomationProperties.Name="Close">
                            <Grid>
                                <Ellipse x:Name="MacCloseDot" Width="14" Height="14" Fill="#FF5F57"/>
                                <Path Classes="mac-close-glyph" x:Name="MacCloseGlyph"
                                      IsVisible="False" Width="13" Height="13" Stretch="None" Data="M 3.5,3.5 L 9.5,9.5 M 9.5,3.5 L 3.5,9.5"
                                      Stroke="#7A0000" StrokeThickness="2" StrokeLineCap="Round"/>
                            </Grid>
                        </Button>
                        <Button Classes="mac-window-btn" Click="Minimize_Click" PointerEntered="MacWindowButton_PointerEntered" AutomationProperties.Name="Minimize">
                            <Grid>
                                <Ellipse x:Name="MacMinimizeDot" Width="14" Height="14" Fill="#FEBC2E"/>
                                <Path x:Name="MacMinimizeGlyph" IsVisible="False" Width="13" Height="13"
                                      Stretch="None" Data="M 3.5,6.5 H 9.5" Stroke="#7A5700" StrokeThickness="2" StrokeLineCap="Round"/>
                            </Grid>
                        </Button>
                        <Button Classes="mac-window-btn" Click="Maximize_Click" PointerEntered="MacWindowButton_PointerEntered" AutomationProperties.Name="Zoom">
                            <Grid>
                                <Ellipse x:Name="MacMaximizeDot" Width="14" Height="14" Fill="#28C840"/>
                                <Path x:Name="MacMaximizeGlyph"
                                      IsVisible="False" Width="13" Height="13" Stretch="None" Data="M 3.5,6 V 3.5 H 6 M 9.5,7 V 9.5 H 7"
                                      Stroke="#006A1B" StrokeThickness="2" StrokeLineCap="Round"/>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <Button x:Name="SidebarToggleButton" Classes="wc-btn" Width="30" Command="{Binding Sidebar.ToggleCommand}" ToolTip.Tip="Toggle file tree">
                        <PathIcon x:Name="SidebarToggleIcon" Data="{StaticResource Icon.SidebarLeft}" Width="14" Height="14"/>
                    </Button>

                </StackPanel>

                <!-- Middle: drag region (empty) -->
                <Border Grid.Column="1" Background="Transparent"/>

                <!-- Right: window control buttons -->
                <StackPanel x:Name="WindowControlButtons" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch" chrome:WindowDecorationProperties.ElementRole="User">

                    <Button Classes="wc-btn" Click="Minimize_Click">
                        <Path HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0,0 H 10" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" StrokeLineCap="Square"/>
                    </Button>

                    <Button Classes="wc-btn" Click="Maximize_Click">
                        <Path HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" Fill="Transparent"/>
                    </Button>

                    <Button Classes="wc-btn wc-close" Click="Close_Click">
                        <Path HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" StrokeLineCap="Round"/>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Body ──────────────────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding Sidebar.Size, Mode=TwoWay}" MinWidth="0" MaxWidth="600"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Sidebar ───────────────────────────────────────────────── -->
            <DockPanel Grid.Column="0" ClipToBounds="True" Background="{DynamicResource RunPad.Sidebar.BackgroundBrush}">

                <!-- Three sections that open and close independently (Resources/NavigationStyles.axaml):
                     Connections first, then the scripts folder, then the bundled samples. Open sections
                     share the height and each scrolls its own tree; folded ones take only their header
                     (rows set by MainWindow.UpdateSidebarRows). Which are open is kept between runs. -->
                <Grid x:Name="SidebarSections" RowDefinitions="Auto,Auto,Auto,*">
                        <Expander x:Name="ConnectionsBundle" Grid.Row="0" Classes="bundle"
                                  IsExpanded="{Binding IsConnectionsSectionExpanded, Mode=TwoWay}"
                                  IsVisible="{Binding HasConnectionNavigation}"
                                  AutomationProperties.Name="Connections navigation bundle">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Classes="bundle-icon" Data="{StaticResource Icon.NavigationConnections}"/>
                                    <TextBlock Text="Connections"/>
                                </StackPanel>
                            </Expander.Header>
                            <uc:ConnectionNavigationView x:Name="ConnectionNavigationView" DataContext="{Binding ConnectionNavigation}"
                                                         OpenConnections="ConnectionNavigation_OpenConnections"
                                                         AddToScript="ConnectionNavigation_AddToScript"/>
                        </Expander>
                        <Expander x:Name="ScriptsBundle" Grid.Row="1" Classes="bundle"
                                  IsExpanded="{Binding IsScriptsSectionExpanded, Mode=TwoWay}"
                                  AutomationProperties.Name="Scripts navigation bundle">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Classes="bundle-icon" Data="{StaticResource Icon.NavigationScripts}"/>
                                    <TextBlock Text="Scripts"/>
                                </StackPanel>
                            </Expander.Header>
                            <ContentControl Content="{Binding FileTree}" ContentTemplate="{StaticResource FileTreeTemplate}"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                        </Expander>
                        <Expander x:Name="SamplesBundle" Grid.Row="2" Classes="bundle"
                                  IsExpanded="{Binding IsSamplesSectionExpanded, Mode=TwoWay}"
                                  AutomationProperties.Name="Samples navigation bundle">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Classes="bundle-icon" Data="{StaticResource Icon.NavigationSamples}"/>
                                    <TextBlock Text="Samples"/>
                                </StackPanel>
                            </Expander.Header>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="No samples available." Margin="26,4,8,4"
                                           FontSize="{DynamicResource RunPad.Type.Caption}"
                                           Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"
                                           IsVisible="{Binding ShowNoExamplesHint}"/>
                                <!-- Read-only: a sample opens as an untitled copy (MainWindowViewModel.OpenExample). -->
                                <TreeView x:Name="SampleTree" Classes="navigation transient-selection" ItemsSource="{Binding SampleTree}"
                                          Background="Transparent" BorderThickness="0" Padding="4,0,4,0"
                                          SelectionMode="Single" AutomationProperties.Name="Samples"
                                          Tapped="SampleTree_Tapped" KeyDown="SampleTree_KeyDown">
                                    <TreeView.Styles>
                                        <Style Selector="TreeViewItem" x:DataType="ucm:SampleTreeNode">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                            <Setter Property="(AutomationProperties.Name)" Value="{Binding AccessibleName}"/>
                                        </Style>
                                    </TreeView.Styles>
                                    <TreeView.ItemTemplate>
                                        <TreeDataTemplate DataType="ucm:SampleTreeNode" ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="0,1">
                                                <Panel Width="14" Height="14" VerticalAlignment="Center">
                                                    <PathIcon IsVisible="{Binding IsFolder}" Data="{StaticResource Icon.FolderOpen}"
                                                              Width="14" Height="14" Opacity="0.55"/>
                                                    <Path IsVisible="{Binding !IsFolder}" Stretch="Uniform" Opacity="0.55"
                                                          Data="{Binding IconKey, Converter={x:Static conv:ResourceKeyToGeometryConverter.Instance}}"
                                                          Fill="{DynamicResource RunPad.Text.PrimaryBrush}"/>
                                                </Panel>
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </TreeDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </DockPanel>
                        </Expander>
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Classes="seam" ResizeDirection="Columns"/>

            <!-- ── Editor area ───────────────────────────────────────────── -->
            <DockPanel Grid.Column="2">
                <!-- Startup draft recovery notice: informs without blocking, and stays until dismissed.
                     The text is selectable so the recovery folders it names can be copied. -->
                <Border x:Name="RecoveryNoticeBar" DockPanel.Dock="Top"
                        IsVisible="{Binding RecoveryNotice, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Background="{DynamicResource RunPad.Sidebar.BackgroundBrush}"
                        BorderBrush="{DynamicResource RunPad.Accent.BackgroundBrush}" BorderThickness="0,0,0,1"
                        Padding="10,6">
                    <DockPanel>
                        <Button x:Name="DismissRecoveryNoticeButton" DockPanel.Dock="Right" Margin="8,0,0,0"
                                VerticalAlignment="Center" Content="Dismiss" Command="{Binding DismissRecoveryNotice}"
                                AutomationProperties.Name="Dismiss draft recovery notice"/>
                        <SelectableTextBlock x:Name="RecoveryNoticeText" Text="{Binding RecoveryNotice}"
                                             TextWrapping="Wrap" VerticalAlignment="Center"
                                             AutomationProperties.Name="Draft recovery notice"/>
                    </DockPanel>
                </Border>
                <ContentControl x:Name="EditorTabsHost"/>
            </DockPanel>

        </Grid>
    </Grid>
</Window>
