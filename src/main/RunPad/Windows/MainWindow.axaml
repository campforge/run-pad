<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:RunPad.Windows.Models"
    xmlns:chrome="using:Avalonia.Controls.Chrome"
    xmlns:uc="clr-namespace:RunPad.UserControls"
    xmlns:ucm="clr-namespace:RunPad.UserControls.Models"
    xmlns:ex="clr-namespace:RunPad.Services.Examples" mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450" x:Class="RunPad.Windows.MainWindow" x:DataType="vm:MainWindowViewModel" Icon="/Assets/icon.ico" Title="RunPad" WindowDecorations="BorderOnly" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="32">

    <Window.Resources>
        <!-- Referenced via ContentTemplate on the sidebar's ContentControl below. DataTemplate.Build()
             sets the built control's DataContext to the content object before it's attached to the
             tree, so FileTreeView's own compiled bindings never see this window's MainWindowViewModel
             as an intermediate (wrong-typed) DataContext. -->
        <DataTemplate x:Key="FileTreeTemplate" x:DataType="ucm:FileTreeViewModel">
            <uc:FileTreeView Open="FileTree_Open" Delete="FileTree_Delete" Rename="FileTree_Rename" OpenFolder="FileTree_OpenFolder" CreateFolder="FileTree_CreateFolder" CreateFile="FileTree_CreateFile" Move="FileTree_Move"/>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>

        <!-- Sidebar tabs (Queries / Examples), styled like the code-document tabs (EditorTabsControl):
             the strip and inactive tabs in the editor background, the selected tab in the colour of
             what it opens onto (here the side panel, as a document tab takes the editor's), a 1 px
             separator after each tab, the hover brush on hover. No accent line; keyboard focus gets a
             thin accent frame. -->
        <Style Selector="TabStrip.sidebar">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource RunPad.Editor.BackgroundBrush}"/>
        </Style>
        <Style Selector="TabStrip.sidebar > TabStripItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource RunPad.Editor.BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource RunPad.Text.SecondaryBrush}"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="TabStripItem">
                    <!-- Transparent: the whole tab takes clicks whatever brush the theme supplies. -->
                    <Panel Background="Transparent">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource RunPad.Separator.BackgroundBrush}"
                                BorderThickness="0,0,1,0">
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              Padding="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <Border x:Name="FocusFrame" BorderThickness="1" BorderBrush="Transparent" IsHitTestVisible="False"/>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TabStrip.sidebar > TabStripItem:selected">
            <Setter Property="Background" Value="{DynamicResource RunPad.Sidebar.BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource RunPad.Text.PrimaryBrush}"/>
        </Style>
        <Style Selector="TabStrip.sidebar > TabStripItem:pointerover /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource RunPad.Toolbar.Button.HoverBrush}"/>
        </Style>
        <Style Selector="TabStrip.sidebar > TabStripItem:focus-visible /template/ Border#FocusFrame">
            <Setter Property="BorderBrush" Value="{DynamicResource RunPad.Tab.AccentBrush}"/>
        </Style>
        <Style Selector="ListBox.examples > ListBoxItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="MinHeight" Value="27"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Window control buttons -->
        <Style Selector="Button.wc-btn">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource RunPad.Text.SecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Name="root" Background="{TemplateBinding Background}" CornerRadius="0">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.wc-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource RunPad.Toolbar.Button.HoverBrush}"/>
        </Style>
        <Style Selector="Button.wc-close:pointerover">
            <Setter Property="Background" Value="#C42B1C"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

    </Window.Styles>

    <Grid x:Name="RootLayout" RowDefinitions="32,*">

        <!-- ── Title bar ─────────────────────────────────────────────────── -->
        <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource RunPad.Sidebar.BackgroundBrush}" chrome:WindowDecorationProperties.ElementRole="TitleBar">

            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Left: app icon + menu -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="0" chrome:WindowDecorationProperties.ElementRole="User">

                    <Image x:Name="AppIconImage" Source="/Assets/icon.ico" Width="16" Height="16" Margin="10,0,4,0" IsHitTestVisible="False" VerticalAlignment="Center"/>

                    <!-- Items come from MainWindow.CreateMainMenu (shared with the macOS NativeMenu). -->
                    <Menu x:Name="MainMenu" Background="Transparent" VerticalAlignment="Center">
                        <Menu.Styles>
                            <Style Selector="MenuItem">
                                <Setter Property="Padding" Value="7,4"/>
                                <Setter Property="FontSize" Value="13"/>
                            </Style>
                        </Menu.Styles>
                    </Menu>

                    <Button Classes="wc-btn" Width="30" Command="{Binding Sidebar.ToggleCommand}" ToolTip.Tip="Toggle file tree">
                        <PathIcon Data="{StaticResource Icon.SidebarLeft}" Width="14" Height="14"/>
                    </Button>

                </StackPanel>

                <!-- Middle: drag region (empty) -->
                <Border Grid.Column="1" Background="Transparent"/>

                <!-- Right: window control buttons -->
                <StackPanel x:Name="WindowControlButtons" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch" chrome:WindowDecorationProperties.ElementRole="User">

                    <Button Classes="wc-btn" Click="Minimize_Click">
                        <Path HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0,0 H 10" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" StrokeLineCap="Square"/>
                    </Button>

                    <Button Classes="wc-btn" Click="Maximize_Click">
                        <Path HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" Fill="Transparent"/>
                    </Button>

                    <Button Classes="wc-btn wc-close" Click="Close_Click">
                        <Path HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" StrokeLineCap="Round"/>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Body ──────────────────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding Sidebar.Size, Mode=TwoWay}" MinWidth="0" MaxWidth="600"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Sidebar ───────────────────────────────────────────────── -->
            <DockPanel Grid.Column="0" ClipToBounds="True" Background="{DynamicResource RunPad.Sidebar.BackgroundBrush}">

                <!-- Queries / Examples, as compact as the editor's own tab strip (30 px) and styled
                     like it (see TabStrip.sidebar above): the selected tab joins the panel below. -->
                <Border DockPanel.Dock="Top" Height="30" Background="{DynamicResource RunPad.Editor.BackgroundBrush}">
                    <TabStrip x:Name="SidebarTabs" Classes="sidebar" SelectedIndex="{Binding SidebarTab}">
                        <TabStripItem Content="Queries"/>
                        <TabStripItem Content="Examples"/>
                    </TabStrip>
                </Border>

                <Panel>
                    <ContentControl Content="{Binding FileTree}" ContentTemplate="{StaticResource FileTreeTemplate}"
                                    IsVisible="{Binding IsQueriesTabShown}"/>
                    <ListBox x:Name="ExampleList" Classes="examples" ItemsSource="{Binding Examples}"
                             IsVisible="{Binding IsExamplesTabShown}"
                             Background="Transparent" BorderThickness="0" Padding="4,4,4,8"
                             SelectionMode="Single"
                             Tapped="ExampleList_Tapped" KeyDown="ExampleList_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="ex:ExampleScript">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="No examples available" Margin="12,8" Opacity="0.6"
                               Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"
                               IsVisible="{Binding ShowNoExamplesHint}"/>
                </Panel>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" Background="{DynamicResource RunPad.Separator.BackgroundBrush}" ResizeDirection="Columns"/>

            <!-- ── Editor area ───────────────────────────────────────────── -->
            <ContentControl x:Name="EditorTabsHost" Grid.Column="2"/>

        </Grid>
    </Grid>
</Window>
