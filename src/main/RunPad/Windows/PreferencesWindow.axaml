<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:RunPad.Avalonia.Themes;assembly=RunPad.Avalonia.Themes"
        xmlns:viewModels="clr-namespace:RunPad.Windows.Models"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="480"
        x:Class="RunPad.Windows.PreferencesWindow"
        Title="Preferences"
        Width="760" Height="480"
        MinWidth="640" MinHeight="420"
        CanResize="True"
        x:DataType="viewModels:PreferencesWindowViewModel"
        Background="{DynamicResource RunPad.Panel.BackgroundBrush}"
        Foreground="{DynamicResource RunPad.Text.PrimaryBrush}"
        >

    <Window.Styles>
        <Style Selector="TreeViewItem">
            <Setter Property="Padding" Value="6,0,6,0"/>
            <Setter Property="MinHeight" Value="27"/>
            <Setter Property="Margin" Value="0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource RunPad.Toolbar.Button.HoverBrush}"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
        <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource RunPad.Accent.BackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
        <Style Selector="TreeViewItem:selected /template/ Border#SelectionIndicator">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="TreeViewItem:selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource RunPad.Accent.ForegroundBrush}"/>
        </Style>
        <Style Selector="TreeViewItem TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource RunPad.Text.PrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TreeViewItem:focus /template/ Border#PART_LayoutRoot">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="220,Auto,*">

        <!-- ── Settings navigator ────────────────────────────────────────── -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="6">
            <TextBox Grid.Row="0"
                     Margin="0,0,0,6"
                     PlaceholderText="Search settings..."
                     Text="{Binding FilterText}"/>

            <TreeView Grid.Row="1"
                      ItemsSource="{Binding Nodes}"
                      SelectedItem="{Binding SelectedNode}"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="0"
                      SelectionMode="Single">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate DataType="viewModels:SettingsNode" ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Name}" Margin="0,1"/>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>

        <GridSplitter Grid.Column="1" Width="1" Background="{DynamicResource RunPad.Separator.BackgroundBrush}"/>

        <!-- ── Settings pages ────────────────────────────────────────────── -->
        <ScrollViewer Grid.Column="2">
            <Panel Margin="16">

                <StackPanel IsVisible="{Binding IsInterfaceSelected}" Spacing="6">

                    <!-- Appearance mode -->
                    <TextBlock Text="Appearance:" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <RadioButton Content="System"
                                     IsChecked="{Binding IsSystemMode}"
                                     GroupName="ThemeMode"/>
                        <RadioButton Content="Dark"
                                     IsChecked="{Binding IsDarkMode}"
                                     GroupName="ThemeMode"/>
                        <RadioButton Content="Light"
                                     IsChecked="{Binding IsLightMode}"
                                     GroupName="ThemeMode"/>
                    </StackPanel>

                    <!-- Interface theme -->
                    <TextBlock Text="Interface theme:" Margin="0,8,0,2" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding AvailableInterfaceThemes}"
                              SelectedItem="{Binding SelectedInterfaceTheme}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:InterfaceTheme">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Editor theme -->
                    <TextBlock Text="Editor theme:" Margin="0,8,0,2" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding AvailableEditorThemes}"
                              SelectedItem="{Binding SelectedEditorTheme}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:EditorTheme">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                </StackPanel>

                <StackPanel IsVisible="{Binding IsEditorSelected}" Spacing="4">
                    <CheckBox IsChecked="{Binding ShowLineNumbers}" Content="Show line numbers"/>
                    <CheckBox IsChecked="{Binding ShowFolding}"     Content="Show code folding"/>
                    <CheckBox IsChecked="{Binding ShowTabs}"        Content="Show tabs"/>
                    <CheckBox IsChecked="{Binding ShowSpaces}"      Content="Show spaces"/>
                    <CheckBox IsChecked="{Binding ShowEndOfLine}"   Content="Show end of line"/>
                    <CheckBox IsChecked="{Binding ShowColumnRuler}" Content="Show column ruler (col 80)"/>
                    <CheckBox IsChecked="{Binding WordWrap}"        Content="Word wrap"/>
                    <CheckBox IsChecked="{Binding CommitCharactersEnabled}"
                              Content="Accept completion when typing punctuation"/>
                    <Grid ColumnDefinitions="Auto,*" Margin="0,6,0,0">
                        <TextBlock Grid.Column="0" Text="Font size:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <NumericUpDown Grid.Column="1"
                                       Value="{Binding FontSize}"
                                       Minimum="8" Maximum="32" Increment="1"
                                       FormatString="0"/>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" Margin="0,6,0,0">
                        <TextBlock Grid.Column="0" Text="Font family:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding FontFamily, UpdateSourceTrigger=LostFocus}"
                                 PlaceholderText="monospace"/>
                    </Grid>

                    <TextBlock Text="New file defaults (Ctrl+N):" Margin="0,10,0,2" FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,4">
                        <TextBlock Grid.Column="0" Text="Language:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableNewFileLanguages}"
                                  SelectedItem="{Binding NewFileLanguage}"
                                  HorizontalAlignment="Stretch"/>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="Kind:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableNewFileKinds}"
                                  SelectedItem="{Binding NewFileKind}"
                                  HorizontalAlignment="Stretch"/>
                    </Grid>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsDotnetSelected}" Spacing="4">
                    <TextBlock Text="Dotnet path:"/>
                    <TextBox PlaceholderText="Path to dotnet.exe" Text="{Binding DotnetPath}"/>
                    <TextBlock Text="Debugger path:" Margin="0,8,0,0"/>
                    <TextBox PlaceholderText="Path to netcoredbg.exe" Text="{Binding DebuggerPath}"/>
                </StackPanel>

                <Grid IsVisible="{Binding IsKeyboardSelected}"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="140,*">
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                               Text="Key Bindings:" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Run / Continue:"
                               VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" Margin="0,0,0,6"
                               Text="{Binding HotkeyRun, UpdateSourceTrigger=LostFocus}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Cancel:"
                               VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" Margin="0,0,0,6"
                               Text="{Binding HotkeyCancel, UpdateSourceTrigger=LostFocus}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Step Over:"
                               VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <TextBox   Grid.Row="3" Grid.Column="1" Margin="0,0,0,6"
                               Text="{Binding HotkeyStepOver, UpdateSourceTrigger=LostFocus}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Step In:"
                               VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <TextBox   Grid.Row="4" Grid.Column="1" Margin="0,0,0,6"
                               Text="{Binding HotkeyStepIn, UpdateSourceTrigger=LostFocus}"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Step Out:"
                               VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <TextBox   Grid.Row="5" Grid.Column="1" Margin="0,0,0,6"
                               Text="{Binding HotkeyStepOut, UpdateSourceTrigger=LostFocus}"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Format Document:"
                               VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <TextBox   Grid.Row="6" Grid.Column="1" Margin="0,0,0,6"
                               Text="{Binding HotkeyFormat, UpdateSourceTrigger=LostFocus}"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Go to Line:"
                               VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <TextBox   Grid.Row="7" Grid.Column="1" Margin="0,0,0,6"
                               Text="{Binding HotkeyGoToLine, UpdateSourceTrigger=LostFocus}"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Open Dependencies:"
                               VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <TextBox   Grid.Row="8" Grid.Column="1" Margin="0,0,0,6"
                               Text="{Binding HotkeyOpenDependencies, UpdateSourceTrigger=LostFocus}"/>

                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Close Tab:"
                               VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <TextBox   Grid.Row="9" Grid.Column="1" Margin="0,0,0,6"
                               Text="{Binding HotkeyCloseTab, UpdateSourceTrigger=LostFocus}"/>

                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Rename File:"
                               VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <TextBox   Grid.Row="10" Grid.Column="1" Margin="0,0,0,6"
                               Text="{Binding HotkeyRenameFile, UpdateSourceTrigger=LostFocus}"/>

                    <TextBlock Grid.Row="11" Grid.Column="0" Text="Delete File:"
                               VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <TextBox   Grid.Row="11" Grid.Column="1" Margin="0,0,0,6"
                               Text="{Binding HotkeyDeleteFile, UpdateSourceTrigger=LostFocus}"/>

                    <TextBlock Grid.Row="12" Grid.Column="0" Text="New File:"
                               VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <TextBox   Grid.Row="12" Grid.Column="1" Margin="0,0,0,6"
                               Text="{Binding HotkeyNewFile, UpdateSourceTrigger=LostFocus}"/>
                </Grid>

                <StackPanel IsVisible="{Binding IsLanguagesSelected}">
                    <TextBlock Text="Select a language from the list to configure its settings."
                               Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsGenericLanguagePlaceholderVisible}">
                    <TextBlock Text="{Binding SelectedLanguageSettingsPlaceholder}"
                               Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsCSharpNodeSelected}" Spacing="4">
                    <CheckBox IsChecked="{Binding InlayHintsEnabled}"
                              Content="Inlay hints (inferred var/foreach types)"/>

                    <CheckBox IsChecked="{Binding CodeFixesEnabled}"
                              Content="Code fixes and refactorings (lightbulb)"
                              Margin="0,8,0,0"/>

                    <TextBlock Text="Excluded diagnostic IDs (one per line, e.g. CS0184, IDE0007)"
                               Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"
                               FontSize="11"
                               Margin="0,8,0,4"
                               IsEnabled="{Binding CodeFixesEnabled}"/>
                    <TextBox Text="{Binding ExcludedDiagnosticIdsText, UpdateSourceTrigger=LostFocus}"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             Height="90"
                             FontFamily="Consolas,Menlo,Courier New,monospace"
                             IsEnabled="{Binding CodeFixesEnabled}"
                             PlaceholderText="CS0184&#10;IDE0007"/>
                </StackPanel>

            </Panel>
        </ScrollViewer>

    </Grid>
</Window>
