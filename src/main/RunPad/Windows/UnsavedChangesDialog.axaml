<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RunPad.Windows.UnsavedChangesDialog"
        Title="Unsaved Changes"
        Width="380"
        MinWidth="320" MinHeight="140"
        CanResize="False"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource RunPad.Panel.BackgroundBrush}"
        Foreground="{DynamicResource RunPad.Text.PrimaryBrush}">

    <Grid RowDefinitions="Auto,Auto" Margin="16">

        <TextBlock x:Name="MessageBlock"
                   Grid.Row="0"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Content="Save"
                    Width="80"
                    Click="SaveButton_Click"
                    IsDefault="True"/>
            <Button Content="Don't Save"
                    Width="96"
                    Click="DontSaveButton_Click"/>
            <Button Content="Cancel"
                    Width="80"
                    Click="CancelButton_Click"
                    IsCancel="True"/>
        </StackPanel>

    </Grid>

</Window>
