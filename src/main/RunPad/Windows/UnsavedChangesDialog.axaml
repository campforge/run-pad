<local:RunPadDialogWindow xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:local="using:RunPad.Windows"
                         x:Class="RunPad.Windows.UnsavedChangesDialog"
                         Icon="/Assets/icon.ico" Title="Unsaved Changes"
                         Background="{DynamicResource RunPad.Panel.BackgroundBrush}"
                         Foreground="{DynamicResource RunPad.Text.PrimaryBrush}">
    <local:DialogLayout x:Name="Layout" Heading="Save changes before closing?"
                        Message="Your changes will be lost if you don’t save.">
        <local:DialogLayout.LeadingActions>
            <Button x:Name="DontSaveButton" Content="Don’t Save" MinWidth="88"
                    Click="DontSaveButton_Click"/>
        </local:DialogLayout.LeadingActions>
        <local:DialogLayout.Actions>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource RunPad.Space.Control}">
                <Button x:Name="CancelButton" Content="Cancel" MinWidth="72"
                        Click="CancelButton_Click" IsCancel="True"/>
                <Button x:Name="SaveButton" Content="Save" MinWidth="72"
                        Click="SaveButton_Click" IsDefault="True"/>
            </StackPanel>
        </local:DialogLayout.Actions>
    </local:DialogLayout>
</local:RunPadDialogWindow>
