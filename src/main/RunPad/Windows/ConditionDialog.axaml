<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cte="using:RunPad.Avalonia.CodeTextEditor"
        x:Class="RunPad.Windows.ConditionDialog"
        Icon="/Assets/icon.ico"
        Title="Conditional Breakpoint"
        Width="440"
        MinWidth="320" MinHeight="230"
        CanResize="False"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource RunPad.Panel.BackgroundBrush}"
        Foreground="{DynamicResource RunPad.Text.PrimaryBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://RunPad.Avalonia.Themes/Metrics.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>


    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="16">

        <CheckBox x:Name="EnabledBox"
                  Grid.Row="0"
                  Content="Enabled"
                  Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1"
                   Text="Break when this condition is true:"
                   FontSize="{DynamicResource RunPad.Type.Caption}"
                   Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"
                   Margin="0,0,0,6"/>

        <TextBox x:Name="ConditionBox"
                 Grid.Row="2"
                 FontSize="{DynamicResource RunPad.Type.Body}"
                 FontFamily="{x:Static cte:MonospaceFont.Default}"
                 Padding="6,4"
                 Margin="0,0,0,12"/>

        <TextBlock Grid.Row="3"
                   Text="Break only when the hit count matches (optional, e.g. &quot;= 5&quot;, &quot;&gt;= 3&quot;, &quot;% 2&quot;):"
                   TextWrapping="Wrap"
                   FontSize="{DynamicResource RunPad.Type.Caption}"
                   Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"
                   Margin="0,0,0,6"/>

        <TextBox x:Name="HitConditionBox"
                 Grid.Row="4"
                 FontSize="{DynamicResource RunPad.Type.Body}"
                 FontFamily="{x:Static cte:MonospaceFont.Default}"
                 Padding="6,4"
                 Margin="0,0,0,12"/>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="{DynamicResource RunPad.Space.Control}">
            <Button Content="OK"
                    Width="80"
                    Click="OkButton_Click"
                    IsDefault="True"/>
            <Button Content="Cancel"
                    Width="80"
                    Click="CancelButton_Click"
                    IsCancel="True"/>
        </StackPanel>

    </Grid>

</Window>
