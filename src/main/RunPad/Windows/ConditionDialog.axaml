<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cte="using:RunPad.Avalonia.CodeTextEditor"
        x:Class="RunPad.Windows.ConditionDialog"
        Icon="/Assets/icon.ico" Title="Line breakpoint"
        Width="480" MinWidth="360" CanResize="False" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource RunPad.Panel.BackgroundBrush}"
        Foreground="{DynamicResource RunPad.Text.PrimaryBrush}">
    <StackPanel Margin="16" Spacing="10">
        <CheckBox x:Name="EnabledBox" Content="Enabled"/>
        <TextBlock Text="Condition:"/>
        <TextBox x:Name="ConditionBox" AcceptsReturn="False" TextWrapping="NoWrap"
                 PlaceholderText="e.g. count &gt; 5"
                 FontFamily="{x:Static cte:MonospaceFont.Default}"
                 AutomationProperties.Name="Breakpoint condition"/>
        <Expander Header="Hit count" IsExpanded="False" x:Name="HitCountOptions">
            <StackPanel Spacing="6">
                <TextBlock Text="Optional hit-count expression, e.g. = 5, &gt;= 3, % 2"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"/>
                <TextBox x:Name="HitConditionBox" AcceptsReturn="False"
                         FontFamily="{x:Static cte:MonospaceFont.Default}"
                         AutomationProperties.Name="Breakpoint hit count"/>
            </StackPanel>
        </Expander>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" MinWidth="80" Click="CancelButton_Click" IsCancel="True"/>
            <Button Content="Done" MinWidth="80" Click="OkButton_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
