<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RunPad.Windows.WindowTitleBar"
             x:CompileBindings="False">
    <!-- The title bar every window but MainWindow gets (Resources/WindowChrome.axaml), drawn like
         MainWindow's own title row: same height, background and window buttons. -->
    <Border x:Name="Bar" Height="32" Background="{DynamicResource RunPad.Sidebar.BackgroundBrush}"
            WindowDecorationProperties.ElementRole="TitleBar">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="TitleText" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"
                       Text="{Binding $parent[Window].Title}" IsHitTestVisible="False"
                       Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"/>
            <StackPanel x:Name="Buttons" Grid.Column="1" Orientation="Horizontal"
                        WindowDecorationProperties.ElementRole="User">
                <Button x:Name="MinimizeButton" Theme="{StaticResource RunPadCaptionButton}" Click="Minimize_Click"
                        IsVisible="{Binding $parent[Window].CanResize}">
                    <Path Data="M 0,0 H 10" Stroke="{Binding $parent[Button].Foreground}"
                          StrokeThickness="1" StrokeLineCap="Square"/>
                </Button>
                <Button x:Name="MaximizeButton" Theme="{StaticResource RunPadCaptionButton}" Click="Maximize_Click"
                        IsVisible="{Binding $parent[Window].CanResize}">
                    <Path Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z" Stroke="{Binding $parent[Button].Foreground}"
                          StrokeThickness="1" Fill="Transparent"/>
                </Button>
                <Button x:Name="CloseButton" Classes="close" Theme="{StaticResource RunPadCaptionButton}" Click="Close_Click">
                    <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{Binding $parent[Button].Foreground}"
                          StrokeThickness="1" StrokeLineCap="Round"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
