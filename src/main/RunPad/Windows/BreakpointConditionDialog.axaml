<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RunPad.Windows.BreakpointConditionDialog"
        Icon="/Assets/icon.ico"
        Title="Line breakpoint"
        MinWidth="480" MaxWidth="520"
        MinHeight="0" MaxHeight="420"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Foreground="{DynamicResource RunPad.Text.PrimaryBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://RunPad.Avalonia.Themes/Metrics.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border x:Name="DialogSurface" Background="{DynamicResource RunPad.Panel.BackgroundBrush}"
            BorderBrush="{DynamicResource RunPad.Border.BackgroundBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16">
        <ContentControl x:Name="EditorHost"/>
    </Border>
</Window>
