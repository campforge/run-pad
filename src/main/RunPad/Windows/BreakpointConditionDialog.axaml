<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RunPad.Windows.BreakpointConditionDialog"
        Icon="/Assets/icon.ico"
        Title="Line breakpoint"
        Width="480" Height="280"
        MinWidth="480" MaxWidth="480"
        MinHeight="220" MaxHeight="420"
        CanResize="False"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource RunPad.Panel.BackgroundBrush}"
        Foreground="{DynamicResource RunPad.Text.PrimaryBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://RunPad.Avalonia.Themes/Metrics.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <ContentControl x:Name="EditorHost"/>
    </Grid>
</Window>
