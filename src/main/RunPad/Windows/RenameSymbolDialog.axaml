<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RunPad.Windows.RenameSymbolDialog"
        Title="Rename"
        Width="360" Height="150"
        MinWidth="300" MinHeight="140"
        CanResize="False"
        SizeToContent="Manual"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource RunPad.Panel.BackgroundBrush}"
        Foreground="{DynamicResource RunPad.Text.PrimaryBrush}">

    <Grid RowDefinitions="Auto,Auto,Auto" Margin="16">

        <TextBlock Grid.Row="0"
                   Text="New name:"
                   FontSize="12"
                   Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"
                   Margin="0,0,0,6"/>

        <TextBox x:Name="NameBox"
                 Grid.Row="1"
                 FontSize="13"
                 FontFamily="Consolas,Menlo,Courier New,monospace"
                 Padding="6,4"
                 Margin="0,0,0,12"
                 TextChanged="NameBox_TextChanged"/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button x:Name="OkButton"
                    Content="Rename"
                    Width="80"
                    Click="OkButton_Click"
                    IsDefault="True"/>
            <Button Content="Cancel"
                    Width="80"
                    Click="CancelButton_Click"
                    IsCancel="True"/>
        </StackPanel>

    </Grid>

</Window>
