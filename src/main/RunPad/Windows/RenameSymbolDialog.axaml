<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cte="using:RunPad.Avalonia.CodeTextEditor"
        x:Class="RunPad.Windows.RenameSymbolDialog"
        Icon="/Assets/icon.ico"
        Title="Rename"
        Width="360" Height="150"
        MinWidth="300" MinHeight="140"
        CanResize="False"
        SizeToContent="Manual"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource RunPad.Panel.BackgroundBrush}"
        Foreground="{DynamicResource RunPad.Text.PrimaryBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://RunPad.Avalonia.Themes/Metrics.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>


    <Grid RowDefinitions="Auto,Auto,Auto" Margin="16">

        <TextBlock Grid.Row="0"
                   Text="New name:"
                   FontSize="{DynamicResource RunPad.Type.Caption}"
                   Foreground="{DynamicResource RunPad.Text.SecondaryBrush}"
                   Margin="0,0,0,6"/>

        <TextBox x:Name="NameBox"
                 Grid.Row="1"
                 FontSize="{DynamicResource RunPad.Type.Body}"
                 FontFamily="{x:Static cte:MonospaceFont.Default}"
                 Padding="6,4"
                 Margin="0,0,0,12"
                 TextChanged="NameBox_TextChanged"/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="{DynamicResource RunPad.Space.Control}">
            <Button Classes="primary" x:Name="OkButton"
                    Content="Rename"
                    Width="80"
                    Click="OkButton_Click"
                    IsDefault="True"/>
            <Button Classes="secondary" Content="Cancel"
                    Width="80"
                    Click="CancelButton_Click"
                    IsCancel="True"/>
        </StackPanel>

    </Grid>

</Window>
