<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconButton="clr-namespace:RunPad.TemplatedControls">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://RunPad.Avalonia.Themes/Metrics.axaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ControlTheme x:Key="{x:Type iconButton:IconButton}" TargetType="iconButton:IconButton">
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding"         Value="{DynamicResource RunPad.Padding.IconButton}"/>
                <Setter Property="Width"           Value="{DynamicResource RunPad.Size.IconButton}"/>
                <Setter Property="Height"          Value="{DynamicResource RunPad.Size.IconButton}"/>
                <Setter Property="Template">
                    <ControlTemplate TargetType="iconButton:IconButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RunPad.Radius.Control}"
                                Padding="{TemplateBinding Padding}">
                            <PathIcon Data="{TemplateBinding IconData}"
                                      Width="{DynamicResource RunPad.Size.ToolbarIcon}" Height="{DynamicResource RunPad.Size.ToolbarIcon}"
                                      Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter>

                <Style Selector="^:pointerover /template/ Border#Root">
                    <Setter Property="Background" Value="{DynamicResource RunPad.Toolbar.Button.HoverBrush}"/>
                </Style>
                <Style Selector="^:pressed /template/ Border#Root">
                    <Setter Property="Opacity" Value="0.6"/>
                </Style>
                <Style Selector="^:disabled /template/ PathIcon">
                    <Setter Property="Foreground" Value="{DynamicResource RunPad.Icon.DisabledBrush}"/>
                </Style>
            </ControlTheme>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
