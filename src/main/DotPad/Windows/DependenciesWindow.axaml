<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:DotPad.Windows.Models"
        x:Class="DotPad.Windows.DependenciesWindow"
        Title="Dependencies"
        Width="640" Height="480"
        MinWidth="480" MinHeight="360"
        CanResize="True"
        Background="{DynamicResource DotPad.Panel.BackgroundBrush}"
        Foreground="{DynamicResource DotPad.Text.PrimaryBrush}"
        x:DataType="viewModels:DependenciesWindowViewModel"
        >
    <Grid RowDefinitions="Auto,*,Auto" Margin="12">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBox Grid.Column="0"
                     PlaceholderText="Search packages…"
                     IsEnabled="False"/>
            <Button Grid.Column="1"
                    Content="Add"
                    Margin="8,0,0,0"
                    IsEnabled="False"/>
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource DotPad.Output.BackgroundBrush}"
                CornerRadius="4">
            <TextBlock Text="Package management — coming soon"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource DotPad.Text.SecondaryBrush}"
                       FontSize="14"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0" Spacing="8">
            <Button Content="Close" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
