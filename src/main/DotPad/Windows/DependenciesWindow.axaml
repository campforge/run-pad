<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:DotPad.Windows.Models"
        x:Class="DotPad.Windows.DependenciesWindow"
        x:DataType="viewModels:DependenciesWindowViewModel"
        Title="NuGet Packages"
        Width="640" Height="520"
        MinWidth="480" MinHeight="360"
        CanResize="True"
        Background="{DynamicResource DotPad.Panel.BackgroundBrush}"
        Foreground="{DynamicResource DotPad.Text.PrimaryBrush}">

    <Grid RowDefinitions="Auto,*,Auto" Margin="12">

        <!-- Search -->
        <TextBox Grid.Row="0"
                 Text="{Binding SearchText}"
                 PlaceholderText="Search NuGet packages…"
                 Margin="0,0,0,8"/>

        <!-- Results area -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*">

            <ProgressBar Grid.Row="0"
                         IsIndeterminate="True"
                         IsVisible="{Binding IsLoading}"
                         Height="2"
                         Margin="0,0,0,4"/>

            <Panel Grid.Row="1">

                <TextBlock Text="Enter a package name to search"
                           IsVisible="{Binding ShowIdleMessage}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource DotPad.Text.SecondaryBrush}"
                           FontSize="14"/>

                <TextBlock Text="No packages found"
                           IsVisible="{Binding ShowEmptyState}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource DotPad.Text.SecondaryBrush}"
                           FontSize="14"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           IsVisible="{Binding HasError}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#E05C5C"
                           FontSize="13"/>

                <ListBox ItemsSource="{Binding Results}"
                         IsVisible="{Binding HasResults}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Padding="0">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="viewModels:PackageResultViewModel">
                            <Border Padding="8,7"
                                    BorderBrush="#20808080"
                                    BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">

                                    <StackPanel Grid.Row="0" Grid.Column="0"
                                                Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Id}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource DotPad.Text.PrimaryBrush}"/>
                                        <TextBlock Text="{Binding Version}"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource DotPad.Text.SecondaryBrush}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{Binding Downloads}"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{DynamicResource DotPad.Text.SecondaryBrush}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                               Text="{Binding Description}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="2"
                                               Margin="0,2,0,0"
                                               Foreground="{DynamicResource DotPad.Text.SecondaryBrush}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </Panel>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0" Spacing="8">
            <Button Content="Close" Click="Close_Click"/>
        </StackPanel>

    </Grid>
</Window>
