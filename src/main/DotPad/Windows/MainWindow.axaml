<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:DotPad.Windows.Models"
    xmlns:chrome="using:Avalonia.Controls.Chrome"
    xmlns:uc="clr-namespace:DotPad.UserControls"
    xmlns:ucm="clr-namespace:DotPad.UserControls.Models" mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450" x:Class="DotPad.Windows.MainWindow" x:DataType="vm:MainWindowViewModel" Icon="/Assets/icon.ico" Title="DotPad" WindowDecorations="BorderOnly" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="32">

    <Window.Resources>
        <!-- Referenced via ContentTemplate on the sidebar's ContentControl below. DataTemplate.Build()
             sets the built control's DataContext to the content object before it's attached to the
             tree, so FileTreeView's own compiled bindings never see this window's MainWindowViewModel
             as an intermediate (wrong-typed) DataContext. -->
        <DataTemplate x:Key="FileTreeTemplate" x:DataType="ucm:FileTreeViewModel">
            <uc:FileTreeView Open="FileTree_Open" Delete="FileTree_Delete" Rename="FileTree_Rename" OpenFolder="FileTree_OpenFolder" CreateFolder="FileTree_CreateFolder"/>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>

        <!-- Window control buttons -->
        <Style Selector="Button.wc-btn">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DotPad.Text.SecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Name="root" Background="{TemplateBinding Background}" CornerRadius="0">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.wc-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource DotPad.Toolbar.Button.HoverBrush}"/>
        </Style>
        <Style Selector="Button.wc-close:pointerover">
            <Setter Property="Background" Value="#C42B1C"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

    </Window.Styles>

    <Grid RowDefinitions="32,*">

        <!-- ── Title bar ─────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="{DynamicResource DotPad.Sidebar.BackgroundBrush}" chrome:WindowDecorationProperties.ElementRole="TitleBar">

            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Left: app icon + menu -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="0" chrome:WindowDecorationProperties.ElementRole="User">

                    <Image x:Name="AppIconImage" Source="/Assets/icon.ico" Width="16" Height="16" Margin="10,0,4,0" IsHitTestVisible="False" VerticalAlignment="Center"/>

                    <Menu Background="Transparent" VerticalAlignment="Center">
                        <Menu.Styles>
                            <Style Selector="MenuItem">
                                <Setter Property="Padding" Value="7,4"/>
                                <Setter Property="FontSize" Value="13"/>
                            </Style>
                        </Menu.Styles>
                        <MenuItem Header="File">
                            <MenuItem Header="New _RPad File">
                                <MenuItem Header="C#" Click="NewRpadFileCSharp_Click"/>
                                <MenuItem Header="Visual Basic" Click="NewRpadFileVb_Click"/>
                            </MenuItem>
                        </MenuItem>
                        <MenuItem Header="Edit">
                            <MenuItem Header="_Dependencies" Command="{Binding OpenDependenciesCommand}"/>
                            <Separator/>
                            <MenuItem Header="_Preferences" Command="{Binding OpenPreferencesCommand}"/>
                        </MenuItem>
                        <MenuItem Header="Help">
                            <MenuItem Header="_About DotPad" Command="{Binding OpenAboutCommand}"/>
                        </MenuItem>
                    </Menu>

                    <Button Classes="wc-btn" Width="30" Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="Toggle file tree">
                        <PathIcon Data="{StaticResource Icon.SidebarLeft}" Width="14" Height="14"/>
                    </Button>

                </StackPanel>

                <!-- Middle: drag region (empty) -->
                <Border Grid.Column="1" Background="Transparent"/>

                <!-- Right: window control buttons -->
                <StackPanel x:Name="WindowControlButtons" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch" chrome:WindowDecorationProperties.ElementRole="User">

                    <Button Classes="wc-btn" Click="Minimize_Click">
                        <Path HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0,0 H 10" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" StrokeLineCap="Square"/>
                    </Button>

                    <Button Classes="wc-btn" Click="Maximize_Click">
                        <Path HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" Fill="Transparent"/>
                    </Button>

                    <Button Classes="wc-btn wc-close" Click="Close_Click">
                        <Path HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" StrokeLineCap="Round"/>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Body ──────────────────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SidebarColumnWidth, Mode=TwoWay}" MinWidth="0" MaxWidth="600"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Sidebar ───────────────────────────────────────────────── -->
            <Grid Grid.Column="0" ClipToBounds="True" Background="{DynamicResource DotPad.Sidebar.BackgroundBrush}">

                <ContentControl Content="{Binding FileTree}" ContentTemplate="{StaticResource FileTreeTemplate}"/>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" Background="{DynamicResource DotPad.Separator.BackgroundBrush}" ResizeDirection="Columns"/>

            <!-- ── Editor area ───────────────────────────────────────────── -->
            <ContentControl x:Name="EditorTabsHost" Grid.Column="2"/>

        </Grid>
    </Grid>
</Window>
