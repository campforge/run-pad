<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:av="clr-namespace:Avalonia.HtmlRenderer;assembly=DotPad.Avalonia.HtmlRenderer"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DotPad.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:codeTextEditor="clr-namespace:DotPad.Avalonia.CodeTextEditor;assembly=DotPad.Avalonia.CodeTextEditor"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="DotPad.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    Icon="/Assets/avalonia-logo.ico"
    Title="DotPad">

    <Window.Resources>
        <DataTemplate x:Key="TabHeaderTemplate" x:DataType="vm:EditorTabViewModel">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding FileName}"
                           VerticalAlignment="Center"
                           FontSize="12"/>
                <Button Classes="TabClose"
                        Command="{Binding CloseCommand}"
                        VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource Icon.Close}"
                              Width="10" Height="10"/>
                </Button>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>

       <Style Selector="TabControl#FileTabControl">
            <Setter Property="Background" Value="{DynamicResource DotPad.Editor.BackgroundBrush}"/>
            <Setter Property="Padding"    Value="0"/>
        </Style>

           <!-- Restrict the entire header strip panel -->
        <Style Selector="TabControl#FileTabControl WrapPanel">
            <Setter Property="MaxHeight" Value="30"/>
        </Style>

        <Style Selector="TabControl#FileTabControl > TabItem">
            <Setter Property="Background"  Value="{DynamicResource DotPad.Panel.BackgroundBrush}"/>
            <Setter Property="Foreground"  Value="{DynamicResource DotPad.Text.SecondaryBrush}"/>
            <Setter Property="Margin"      Value="0"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="TabItem">
                    <Panel>
                        <!-- 1 px top accent вЂ” appears only on the selected tab -->
                        <Border x:Name="TopAccent"
                                Height="1"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                ZIndex="1"/>
                        <!-- Tab background + right separator border + content -->
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource DotPad.Separator.BackgroundBrush}"
                                BorderThickness="0,0,1,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- Selected: accent + editor background -->
        <Style Selector="TabControl#FileTabControl > TabItem:selected /template/ Border#TopAccent">
            <Setter Property="Background" Value="{DynamicResource DotPad.Tab.AccentBrush}"/>
        </Style>
        <Style Selector="TabControl#FileTabControl > TabItem:selected">
            <Setter Property="Background" Value="{DynamicResource DotPad.Editor.BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DotPad.Text.PrimaryBrush}"/>
        </Style>
        <!-- Hover: lighten background slightly -->
        <Style Selector="TabControl#FileTabControl > TabItem:pointerover /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource DotPad.Toolbar.Button.HoverBrush}"/>
        </Style>

        <!-- в”Ђв”Ђ File tab close button в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ -->
        <Style Selector="Button.TabClose">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Width"           Value="14"/>
            <Setter Property="Height"          Value="14"/>
            <Setter Property="CornerRadius"    Value="2"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Opacity"         Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.TabClose:pointerover">
            <Setter Property="Background" Value="{DynamicResource DotPad.Toolbar.Button.HoverBrush}"/>
        </Style>
        <Style Selector="TabControl#FileTabControl > TabItem:pointerover Button.TabClose">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="TabControl#FileTabControl > TabItem:selected Button.TabClose">
            <Setter Property="Opacity" Value="1"/>
        </Style>

    </Window.Styles>

    <Grid ColumnDefinitions="300, *">

        <!-- в”Ђв”Ђ Sidebar в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ -->
        <Grid Grid.Column="0" RowDefinitions="40, *"
              Background="{DynamicResource DotPad.Sidebar.BackgroundBrush}">
            <Menu Grid.Row="0">
                <MenuItem Header="Edit">
                    <MenuItem Header="_Preferences" Click="Preferences_Click" />
                </MenuItem>
            </Menu>
            <TreeView Grid.Row="1" Name="FileTree" ItemsSource="{Binding Nodes}">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding SubNodes}">
                        <TextBlock Text="{Binding Title}" />
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>

        <Grid Grid.Column="1" RowDefinitions="*, 1, 250, 25">

            <!-- File tabs + "+" new-file button overlaid at top-right -->
            <Panel Grid.Row="0">
                <TabControl Name="FileTabControl" Padding="0"/>
                <Button Name="NewFileButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Width="30" Height="30"
                        Padding="0"
                        Click="NewFile_Click"
                        ToolTip.Tip="New file"
                        Background="Transparent"
                        BorderThickness="0">
                    <PathIcon Data="{StaticResource Icon.Plus}" Width="18" Height="18"
                              Foreground="{DynamicResource DotPad.Text.SecondaryBrush}"/>
                </Button>
            </Panel>

            <!-- Separator -->
            <Border Grid.Row="1"
                    Background="{DynamicResource DotPad.Separator.BackgroundBrush}" />

            <!-- Output tabs -->
            <TabControl Grid.Row="2" Name="OutputTabs">
                <TabItem Header="Results" FontSize="14">
                    <av:HtmlPanel x:Name="HtmlPanel"
                                  Background="{DynamicResource DotPad.Output.BackgroundBrush}">
                        <ToolTip.Tip>
                            <ToolTip BorderBrush="Transparent" Padding="0" ShowDelay="5000">
                                <av:HtmlLabel x:Name="HtmlTooltipLabel" />
                            </ToolTip>
                        </ToolTip.Tip>
                    </av:HtmlPanel>
                </TabItem>
                <TabItem Header="Debugger" FontSize="14">
                    <Grid RowDefinitions="Auto,*">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="2" Margin="2,2,2,4">
                            <Button Name="DbgContinueButton"
                                    IsEnabled="{Binding IsPaused}"
                                    Click="DbgContinue_Click"
                                    ToolTip.Tip="Continue (F5)"
                                    Width="28" Height="24" Padding="0">
                                <PathIcon Data="{StaticResource Icon.Play}" Width="16" Height="16"
                                          Foreground="{DynamicResource DotPad.Icon.PlayBrush}"/>
                            </Button>
                            <Button Name="DbgStepOverButton"
                                    IsEnabled="{Binding IsPaused}"
                                    Click="DbgStepOver_Click"
                                    ToolTip.Tip="Step Over (F10)"
                                    Width="28" Height="24" Padding="0">
                                <PathIcon Data="{StaticResource Icon.DebugStepOver}" Width="16" Height="16"
                                          Foreground="{DynamicResource DotPad.Icon.StepBrush}"/>
                            </Button>
                            <Button Name="DbgStepInButton"
                                    IsEnabled="{Binding IsPaused}"
                                    Click="DbgStepIn_Click"
                                    ToolTip.Tip="Step In (F11)"
                                    Width="28" Height="24" Padding="0">
                                <PathIcon Data="{StaticResource Icon.DebugStepInto}" Width="16" Height="16"
                                          Foreground="{DynamicResource DotPad.Icon.StepBrush}"/>
                            </Button>
                            <Button Name="DbgStepOutButton"
                                    IsEnabled="{Binding IsPaused}"
                                    Click="DbgStepOut_Click"
                                    ToolTip.Tip="Step Out (Shift+F11)"
                                    Width="28" Height="24" Padding="0">
                                <PathIcon Data="{StaticResource Icon.DebugStepOut}" Width="16" Height="16"
                                          Foreground="{DynamicResource DotPad.Icon.StepBrush}"/>
                            </Button>
                            <Border Width="1" Height="20"
                                    Background="{DynamicResource DotPad.Separator.BackgroundBrush}"
                                    Margin="4,0"/>
                            <Button Name="DbgPauseButton"
                                    IsEnabled="{Binding IsDebugging}"
                                    Click="DbgPause_Click"
                                    ToolTip.Tip="Pause"
                                    Width="28" Height="24" Padding="0">
                                <PathIcon Data="{StaticResource Icon.Pause}" Width="16" Height="16"
                                          Foreground="{DynamicResource DotPad.Icon.DebugBrush}"/>
                            </Button>
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding DebugInfo}"
                                   FontFamily="Cascadia Code,Consolas,Monospace"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="6"
                                   VerticalAlignment="Top" />
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Status bar -->
            <Grid Grid.Row="3" Height="25"
                  Background="{DynamicResource DotPad.StatusBar.BackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="StatusText" Text="Ready"
                           Grid.Column="0"
                           Foreground="{DynamicResource DotPad.StatusBar.ForegroundBrush}"
                           Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" />
                <TextBlock Name="ExecutionStatusText"
                           Grid.Column="1"
                           FontWeight="SemiBold"
                           Margin="0,0,12,0" VerticalAlignment="Center" FontSize="11" />
                <TextBlock Name="ElapsedText"
                           Grid.Column="2"
                           Foreground="{DynamicResource DotPad.StatusBar.ForegroundBrush}"
                           Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12" />
            </Grid>

        </Grid>
    </Grid>
</Window>
