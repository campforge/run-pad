<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:templatedControls="clr-namespace:DotPad.TemplatedControls">
    <Styles.Resources>
        <ResourceDictionary>

            <ControlTheme x:Key="{x:Type templatedControls:IconToggleButton}" TargetType="templatedControls:IconToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Template">
                    <ControlTemplate TargetType="templatedControls:IconToggleButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <PathIcon Data="{TemplateBinding IconData}"
                                      Width="16" Height="16"
                                      Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter>

                <Style Selector="^:pointerover /template/ Border#Root">
                    <Setter Property="Background" Value="{DynamicResource DotPad.Toolbar.Button.HoverBrush}" />
                </Style>
                <Style Selector="^:pressed /template/ Border#Root">
                    <Setter Property="Opacity" Value="0.6" />
                </Style>
                <Style Selector="^:disabled /template/ PathIcon">
                    <Setter Property="Foreground" Value="{DynamicResource DotPad.Icon.DisabledBrush}" />
                </Style>

                <Style Selector="^:checked /template/ Border#Root">
                    <Setter Property="BorderThickness" Value="1" />
                    <!-- <Setter Property="Background" Value="{DynamicResource DotPad.Accent.BackgroundBrush}"/> -->
                </Style>

                <Style Selector="^:disabled">
                    <Setter Property="Opacity" Value="0.35"/>
                </Style>

                <Style Selector="^ /template/ PathIcon">
                    <Setter Property="Foreground" Value="{DynamicResource DotPad.Text.SecondaryBrush}"/>
                </Style>

                <Style Selector="^:checked /template/ PathIcon">
                    <Setter Property="Foreground" Value="{DynamicResource DotPad.Icon.PlayBrush}"/>
                </Style>

            </ControlTheme>

        </ResourceDictionary>
    </Styles.Resources>
</Styles>
