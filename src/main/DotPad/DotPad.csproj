<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Product>DotPad</Product>
    <Version>0.2.0</Version>
    <Authors>coddwrench</Authors>
    <Company>coddwrench</Company>
    <Copyright>© coddwrench</Copyright>
    <!-- NU1608: Avalonia.Diagnostics (Debug only) pulls Microsoft.CodeAnalysis.CSharp.Scripting 3.8.0
         which declares exact constraints on CodeAnalysis packages. We knowingly override to 4.x. -->
    <!-- AVLN3001: XAML controls using constructor DI have no public ctor — expected pattern -->
    <NoWarn>$(NoWarn);NU1608;AVLN3001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotPad.Runtime.UI.Tests"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia"/>
    <PackageReference Include="Avalonia.Controls.DataGrid"/>
    <PackageReference Include="TextMateSharp.Grammars"/>

    <PackageReference Include="Avalonia.Browser"/>
    <PackageReference Include="Avalonia.Desktop"/>
    <PackageReference Include="Avalonia.Themes.Fluent"/>
    <PackageReference Include="Avalonia.Fonts.Inter"/>
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics"/>
    <PackageReference Include="Avalonia.ReactiveUI"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
    <PackageReference Include="Microsoft.Extensions.Logging"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Console"/>
    <PackageReference Include="System.Composition.AttributedModel"/>
    <PackageReference Include="System.Configuration.ConfigurationManager"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Local fork (TODO.md #61) — was Avalonia.AvaloniaEdit/AvaloniaEdit.TextMate NuGet packages;
         DotPad's own code (EditorTabItemControl/SquiggleRenderer/SemanticHighlighter) uses AvaloniaEdit
         types directly, not just through DotPad.Avalonia.CodeTextEditor, hence the direct reference. -->
    <ProjectReference Include="..\..\controls\AvaloniaEdit\AvaloniaEdit.csproj"/>
    <ProjectReference Include="..\..\controls\AvaloniaEdit.TextMate\AvaloniaEdit.TextMate.csproj"/>
    <ProjectReference Include="..\..\controls\DotPad.Avalonia.CodeTextEditor\DotPad.Avalonia.CodeTextEditor.csproj"/>
    <ProjectReference Include="..\..\controls\DotPad.Avalonia.Themes\DotPad.Avalonia.Themes.csproj"/>
    <ProjectReference Include="..\..\controls\DotPad.Avalonia.HtmlRenderer\DotPad.Avalonia.HtmlRenderer.csproj"/>
    <ProjectReference Include="..\..\core\DotPad.Format.RPad\DotPad.Format.RPad.csproj"/>
    <ProjectReference Include="..\..\core\DotPad.Build.Core\DotPad.Build.Core.csproj"/>
    <ProjectReference Include="..\..\languages\DotPad.Languages.CSharp\DotPad.Languages.CSharp.csproj"/>
    <ProjectReference Include="..\..\languages\DotPad.Languages.VB\DotPad.Languages.VB.csproj"/>
    <ProjectReference Include="..\..\languages\DotPad.Languages.DotnetCommon\DotPad.Languages.DotnetCommon.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="UserControls\EditorTabControl.cs">
      <DependentUpon>EditorTabControl.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="UserControls\EditorTabsControl.cs">
      <DependentUpon>EditorTabsControl.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="UserControls\DebugPanel.cs">
      <DependentUpon>DebugPanel.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Windows\DependenciesWindow.axaml.cs">
      <DependentUpon>DependenciesWindow.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Windows\PreferencesWindow.axaml.cs">
      <DependentUpon>PreferencesWindow.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Windows\MainWindow.axaml.cs">
      <DependentUpon>MainWindow.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="UserControls\EditorTabItemControl.cs">
      <DependentUpon>EditorTabItemControl.axaml</DependentUpon>
    </Compile>
    <Compile Update="TemplatedControls\IconButton.cs">
      <DependentUpon>IconButton.axaml</DependentUpon>
    </Compile>
    <Compile Update="TemplatedControls\IconToggleButton.cs">
      <DependentUpon>IconToggleButton.axaml</DependentUpon>
    </Compile>
    <Compile Update="TemplatedControls\ToolbarComboBox.cs">
      <DependentUpon>ToolbarComboBox.axaml</DependentUpon>
    </Compile>
    <Compile Update="UserControls\FileTreeView.cs">
      <DependentUpon>FileTreeView.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="TemplatedControls\IconButton.axaml"/>
  </ItemGroup>
</Project>
