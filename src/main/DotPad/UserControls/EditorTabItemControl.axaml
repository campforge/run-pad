<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:build="using:DotPad.Contracts.Models"
             xmlns:controls="using:DotPad.Controls"
             xmlns:views="using:DotPad.Views"
             xmlns:vm="clr-namespace:DotPad.UserControls.Models"
             xmlns:templatedControls="clr-namespace:DotPad.TemplatedControls"
             xmlns:htmlRenderer="clr-namespace:DotPad.Avalonia.HtmlRenderer;assembly=DotPad.Avalonia.HtmlRenderer"
             xmlns:userControls="clr-namespace:DotPad.UserControls"
             x:Class="DotPad.UserControls.EditorsTabItemControl"
             x:DataType="vm:EditorTabItemViewModel">

    <UserControl.Resources>
        <DataTemplate x:Key="TabHeaderTemplate" x:DataType="vm:EditorTabItemViewModel">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding FileName}"
                           VerticalAlignment="Center"
                           FontSize="12"/>
                <Button Classes="TabClose"
                        Command="{Binding CloseCommand}"
                        VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource Icon.Close}"
                              Width="10" Height="10"/>
                </Button>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>

        <Style Selector="ToggleButton.TopBarButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="4"/>
            <Setter Property="Width"           Value="26"/>
            <Setter Property="Height"          Value="26"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="ToggleButton">
                    <Border Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.TopBarButton:pointerover /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource DotPad.Toolbar.Button.HoverBrush}"/>
        </Style>
        <Style Selector="ToggleButton.TopBarButton:pressed /template/ Border#Root">
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
        <Style Selector="ToggleButton.TopBarButton:checked /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource DotPad.Accent.BackgroundBrush}"/>
        </Style>
        <Style Selector="ToggleButton.TopBarButton:disabled">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>
        <Style Selector="ToggleButton.TopBarButton PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource DotPad.Text.SecondaryBrush}"/>
        </Style>
        <Style Selector="ToggleButton.TopBarButton:checked PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource DotPad.Icon.PlayBrush}"/>
        </Style>

        <Style Selector="StackPanel.Toolbar ComboBox">
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="CornerRadius"    Value="4"/>
        </Style>
        <Style Selector="StackPanel.Toolbar ComboBox /template/ Border#Background">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="StackPanel.Toolbar ComboBox:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource DotPad.Toolbar.Button.HoverBrush}"/>
        </Style>
        <Style Selector="StackPanel.Toolbar ComboBox:focus /template/ Border#Background">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="StackPanel.Toolbar ComboBox[IsDropDownOpen=true] /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource DotPad.Toolbar.Button.HoverBrush}"/>
        </Style>

        <Style Selector="TabControl.OutputTabs">
            <Setter Property="Background" Value="{DynamicResource DotPad.Output.BackgroundBrush}"/>
            <Setter Property="Padding"    Value="0"/>
        </Style>
        <Style Selector="TabControl.OutputTabs > TabItem">
            <Setter Property="FontSize"  Value="13"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Height"    Value="28"/>
            <Setter Property="Padding"   Value="12,0"/>
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="46,*,5,220,22">

        <!-- Row 0: Toolbar -->
        <Border Grid.Row="0"
                Background="{DynamicResource DotPad.Toolbar.BackgroundBrush}"
                BorderBrush="{DynamicResource DotPad.Toolbar.BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                ClipToBounds="True"
                Margin="6,4">
            <Panel>
                <StackPanel Orientation="Horizontal" Spacing="1" Margin="4,0"
                            Classes="Toolbar"
                            VerticalAlignment="Center">
                    <templatedControls:IconButton
                        IconData="{StaticResource Icon.Play}"
                        Foreground="{DynamicResource DotPad.Icon.PlayBrush}"
                        IsEnabled="{Binding EnableRunButton}"
                        Click="RunButton_Click"
                        ToolTip.Tip="Run (F5)"/>
                    <templatedControls:IconButton
                        IconData="{StaticResource Icon.Stop}"
                        Foreground="{DynamicResource DotPad.Icon.StopBrush}"
                        IsEnabled="{Binding EnableCancelButton}"
                        Click="CancelButton_Click"
                        ToolTip.Tip="Cancel"/>
                    <ComboBox
                        Margin="4,0,0,0"
                        Height="24"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        ItemsSource="{Binding DotnetPlatforms}"
                        SelectedItem="{Binding SelectedDotnetPlatform}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="build:ExecutionPlatform">
                                <TextBlock Text="{Binding Description}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Border Width="1" Height="16"
                            Background="{DynamicResource DotPad.Separator.BackgroundBrush}"
                            Margin="4,0"/>
                    <ToggleButton
                        Classes="TopBarButton"
                        IsChecked="{Binding DebugModeEnabled}"
                        ToolTip.Tip="Toggle debug mode">
                        <PathIcon Data="{StaticResource Icon.Bug}" Width="16" Height="16"/>
                    </ToggleButton>
                </StackPanel>
                <ProgressBar VerticalAlignment="Bottom"
                             Height="1"
                             MinHeight="0"
                             IsIndeterminate="True"
                             IsVisible="{Binding IsRunningProgress}"
                             Foreground="{DynamicResource DotPad.Tab.AccentBrush}"
                             Background="Transparent"
                             BorderThickness="0">
                    <ProgressBar.Effect>
                        <DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="8" Opacity="0.85"
                                          Color="{DynamicResource DotPad.Tab.AccentColor}"/>
                    </ProgressBar.Effect>
                </ProgressBar>
            </Panel>
        </Border>

        <!-- Row 1: CodeTextEditor -->
        <ContentPresenter x:Name="EditorHost" Grid.Row="1"/>

        <!-- Row 2: GridSplitter -->
        <GridSplitter Grid.Row="2"
                      ResizeDirection="Rows"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource DotPad.Separator.BackgroundBrush}"/>

        <!-- Row 3: Output tabs -->
        <TabControl x:Name="OutputTabsControl" Grid.Row="3" Classes="OutputTabs">

            <TabItem Header="Results">
                <htmlRenderer:HtmlPanel x:Name="OutputHtml"
                              Background="{DynamicResource DotPad.Output.BackgroundBrush}">
                    <ToolTip.Tip>
                        <ToolTip BorderBrush="Transparent" Padding="0" ShowDelay="5000">
                            <htmlRenderer:HtmlLabel x:Name="HtmlTooltipLabel"/>
                        </ToolTip>
                    </ToolTip.Tip>
                </htmlRenderer:HtmlPanel>
            </TabItem>

            <TabItem Header="Debugger">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="2" Margin="2,2,2,4">
                        <templatedControls:IconButton
                            IconData="{StaticResource Icon.Play}"
                            Foreground="{DynamicResource DotPad.Icon.PlayBrush}"
                            IsEnabled="{Binding IsPaused}"
                            Click="DbgContinue_Click"
                            ToolTip.Tip="Continue (F5)"
                            Width="28" Height="24"/>
                        <templatedControls:IconButton
                            IconData="{StaticResource Icon.DebugStepOver}"
                            Foreground="{DynamicResource DotPad.Icon.StepBrush}"
                            IsEnabled="{Binding IsPaused}"
                            Click="DbgStepOver_Click"
                            ToolTip.Tip="Step Over (F10)"
                            Width="28" Height="24"/>
                        <templatedControls:IconButton
                            IconData="{StaticResource Icon.DebugStepInto}"
                            Foreground="{DynamicResource DotPad.Icon.StepBrush}"
                            IsEnabled="{Binding IsPaused}"
                            Click="DbgStepIn_Click"
                            ToolTip.Tip="Step In (F11)"
                            Width="28" Height="24"/>
                        <templatedControls:IconButton
                            IconData="{StaticResource Icon.DebugStepOut}"
                            Foreground="{DynamicResource DotPad.Icon.StepBrush}"
                            IsEnabled="{Binding IsPaused}"
                            Click="DbgStepOut_Click"
                            ToolTip.Tip="Step Out (Shift+F11)"
                            Width="28" Height="24"/>
                        <Border Width="1" Height="20"
                                Background="{DynamicResource DotPad.Separator.BackgroundBrush}"
                                Margin="4,0"/>
                        <templatedControls:IconButton
                            IconData="{StaticResource Icon.Pause}"
                            Foreground="{DynamicResource DotPad.Icon.DebugBrush}"
                            IsEnabled="{Binding IsDebugging}"
                            Click="DbgPause_Click"
                            ToolTip.Tip="Pause"
                            Width="28" Height="24"/>
                    </StackPanel>
                    <userControls:DebugPanel x:Name="DebugPanelCtrl" Grid.Row="1"/>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Row 4: Status strip -->
        <Grid Grid.Row="4"
              ColumnDefinitions="*,Auto,Auto"
              Background="{DynamicResource DotPad.StatusBar.BackgroundBrush}">
            <TextBlock x:Name="StatusLine"
                       Grid.Column="0"
                       Foreground="{DynamicResource DotPad.StatusBar.ForegroundBrush}"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Text="Ready"/>
            <TextBlock x:Name="ExecStatusBlock"
                       Grid.Column="1"
                       FontWeight="SemiBold"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       FontSize="11"/>
            <TextBlock x:Name="ElapsedBlock"
                       Grid.Column="2"
                       Foreground="{DynamicResource DotPad.StatusBar.ForegroundBrush}"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       FontSize="12"/>
        </Grid>

    </Grid>

</UserControl>
