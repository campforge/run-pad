<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:build="using:DotPad.Contracts.Models"
             xmlns:vm="clr-namespace:DotPad.UserControls.Models"
             xmlns:tc="clr-namespace:DotPad.TemplatedControls"
             xmlns:uc="clr-namespace:DotPad.UserControls"
             x:Class="DotPad.UserControls.EditorsTabItemControl"
             x:DataType="vm:EditorTabItemViewModel">

    <UserControl.Resources>
        <DataTemplate x:Key="TabHeaderTemplate" x:DataType="vm:EditorTabItemViewModel">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <StackPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Save As..." Command="{Binding SaveAsCommand}">
                            <MenuItem.Icon>
                                <PathIcon Data="{StaticResource Icon.Save}" Width="16" Height="16"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Duplicate" Command="{Binding DuplicateCommand}" IsEnabled="{Binding HasFilePath}">
                            <MenuItem.Icon>
                                <PathIcon Data="{StaticResource Icon.Duplicate}" Width="16" Height="16"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Open Containing Folder" Command="{Binding OpenContainingFolderCommand}" IsEnabled="{Binding HasFilePath}">
                            <MenuItem.Icon>
                                <PathIcon Data="{StaticResource Icon.FolderOpen}" Width="16" Height="16"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </StackPanel.ContextMenu>
                <TextBlock Text="{Binding FileName}"
                           Classes.dirty="{Binding IsDirty}"
                           VerticalAlignment="Center"
                           FontSize="12"/>
                <Button Classes="TabClose"
                        Command="{Binding CloseCommand}"
                        VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource Icon.Close}"
                              Width="10" Height="10"/>
                </Button>
            </StackPanel>
        </DataTemplate>

        <!-- Referenced via ContentTemplate on the "Debugger" TabItem's ContentControl below.
             DataTemplate.Build() sets the built control's DataContext to the content object before
             it's attached to the tree, so DebugPanel's own compiled bindings never see this tab's
             EditorTabItemViewModel as an intermediate (wrong-typed) DataContext. -->
        <DataTemplate x:Key="DebugPanelTemplate" x:DataType="vm:DebugPanelViewModel">
            <uc:DebugPanel/>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TabControl.OutputTabs">
            <Setter Property="Background" Value="{DynamicResource DotPad.Output.BackgroundBrush}"/>
            <Setter Property="Padding"    Value="0"/>
        </Style>
        <Style Selector="TabControl.OutputTabs > TabItem">
            <Setter Property="FontSize"  Value="13"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Height"    Value="28"/>
            <Setter Property="Padding"   Value="12,0"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="{Binding OutputPanelHeight, Mode=TwoWay}" MinHeight="0" MaxHeight="600"/>
            <RowDefinition Height="22"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Toolbar -->
        <Border Grid.Row="0"
                Background="{DynamicResource DotPad.Toolbar.BackgroundBrush}"
                BorderBrush="{DynamicResource DotPad.Toolbar.BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                ClipToBounds="True"
                Margin="6,4">
            <Panel>
                <StackPanel Orientation="Horizontal" Spacing="1" Margin="4,0"
                            Classes="Toolbar"
                            VerticalAlignment="Center">
                    <tc:IconButton
                        IconData="{StaticResource Icon.Play}"
                        Foreground="{DynamicResource DotPad.Icon.PlayBrush}"
                        IsEnabled="{Binding EnableRunOrContinueButton}"
                        Click="RunOrContinueButton_Click"
                        ToolTip.Tip="{Binding TooltipRunOrContinue}"/>
                    <tc:IconButton
                        IconData="{StaticResource Icon.Stop}"
                        Foreground="{DynamicResource DotPad.Icon.StopBrush}"
                        IsEnabled="{Binding EnableCancelButton}"
                        Click="CancelButton_Click"
                        ToolTip.Tip="{Binding TooltipCancel}"/>
                    <tc:ToolbarComboBox
                        Margin="4,0,0,0"
                        Height="24"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        ItemsSource="{Binding AvailableSdks}"
                        SelectedItem="{Binding SelectedSdk}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="build:DotnetSdk">
                                <TextBlock Text="{Binding Description}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </tc:ToolbarComboBox>

                    <tc:ToolbarComboBox
                        Margin="4,0,0,0"
                        Height="24"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        ItemsSource="{Binding Kinds}"
                        SelectedItem="{Binding SelectedKind}">
                    </tc:ToolbarComboBox>

                    <Border Width="1" Height="16"
                            Background="{DynamicResource DotPad.Separator.BackgroundBrush}"
                            Margin="4,0"/>

                    <tc:IconToggleButton
                        IconData="{StaticResource Icon.Bug}"
                        CheckedBrush="{DynamicResource DotPad.Icon.PlayBrush}"
                        IsChecked="{Binding DebugModeEnabled}"
                        ToolTip.Tip="Toggle debug mode"
                       />

                    <tc:IconButton
                        IconData="{StaticResource Icon.PanelBottom}"
                        Command="{Binding ToggleOutputPanelCommand}"
                        ToolTip.Tip="Toggle output panel"
                        />

                    <!-- Debug-only controls: shown, not merely enabled, only while debugging
                         (ANALYSIS.md feature #14) — an idle toolbar shouldn't be cluttered with
                         inactive step/pause icons. -->
                    <Border Width="1" Height="16"
                            Background="{DynamicResource DotPad.Separator.BackgroundBrush}"
                            Margin="4,0"
                            IsVisible="{Binding IsDebugging}"/>
                    <tc:IconButton
                        IconData="{StaticResource Icon.DebugStepOver}"
                        Foreground="{DynamicResource DotPad.Icon.StepBrush}"
                        IsEnabled="{Binding IsPaused}"
                        IsVisible="{Binding IsDebugging}"
                        Click="DbgStepOver_Click"
                        ToolTip.Tip="{Binding TooltipStepOver}"
                        Width="24" Height="24"/>
                    <tc:IconButton
                        IconData="{StaticResource Icon.DebugStepInto}"
                        Foreground="{DynamicResource DotPad.Icon.StepBrush}"
                        IsEnabled="{Binding IsPaused}"
                        IsVisible="{Binding IsDebugging}"
                        Click="DbgStepIn_Click"
                        ToolTip.Tip="{Binding TooltipStepIn}"
                        Width="24" Height="24"/>
                    <tc:IconButton
                        IconData="{StaticResource Icon.DebugStepOut}"
                        Foreground="{DynamicResource DotPad.Icon.StepBrush}"
                        IsEnabled="{Binding IsPaused}"
                        IsVisible="{Binding IsDebugging}"
                        Click="DbgStepOut_Click"
                        ToolTip.Tip="{Binding TooltipStepOut}"
                        Width="24" Height="24"/>
                    <tc:IconButton
                        IconData="{StaticResource Icon.Pause}"
                        Foreground="{DynamicResource DotPad.Icon.DebugBrush}"
                        IsVisible="{Binding IsDebugging}"
                        Click="DbgPause_Click"
                        ToolTip.Tip="Pause"
                        Width="24" Height="24"/>
                    <tc:IconButton
                        IconData="{StaticResource Icon.RunToCursor}"
                        Foreground="{DynamicResource DotPad.Icon.StepBrush}"
                        IsEnabled="{Binding IsPaused}"
                        IsVisible="{Binding IsDebugging}"
                        Click="DbgRunToCursor_Click"
                        ToolTip.Tip="Run to Cursor"
                        Width="24" Height="24"/>
                </StackPanel>
                <ProgressBar VerticalAlignment="Bottom"
                             Height="1"
                             MinHeight="0"
                             IsIndeterminate="True"
                             IsVisible="{Binding IsRunningProgress}"
                             Foreground="{DynamicResource DotPad.Tab.AccentBrush}"
                             Background="Transparent"
                             BorderThickness="0">
                    <ProgressBar.Effect>
                        <DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="8" Opacity="0.85"
                                          Color="{DynamicResource DotPad.Tab.AccentColor}"/>
                    </ProgressBar.Effect>
                </ProgressBar>
            </Panel>
        </Border>

        <!-- Row 1: CodeTextEditor -->
        <ContentPresenter x:Name="EditorHost" Grid.Row="1"/>

        <!-- Row 2: GridSplitter -->
        <GridSplitter Grid.Row="2"
                      ResizeDirection="Rows"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource DotPad.Separator.BackgroundBrush}"/>

        <!-- Row 3: Output tabs -->
        <TabControl x:Name="OutputTabsControl" Grid.Row="3" Classes="OutputTabs">

            <TabItem Header="Results">
                <uc:OutputHtmlView x:Name="ResultsOutput"/>
            </TabItem>

            <TabItem Header="Debugger">
                <ContentControl Content="{Binding DebugPanel}" ContentTemplate="{StaticResource DebugPanelTemplate}"/>
            </TabItem>

            <!-- LINQPad-style "IL" tab (TODO.md #62) — raw IL disassembly of the last successful
                 compile, refreshed via ILanguageHost.Compiled. Plain read-only TextBox rather than a
                 full CodeTextEditor: no IntelliSense/breakpoints/folding are meaningful here, this is
                 just monospace text with its own scrollbars. -->
            <TabItem Header="IL">
                <TextBox x:Name="IlOutput"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="NoWrap"
                         BorderThickness="0"
                         FontFamily="Consolas,Menlo,Courier New,monospace"
                         FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </TabItem>

        </TabControl>

        <!-- Row 4: Status strip — status/elapsed on the left, caret position on the right (LINQPad-style) -->
        <Grid Grid.Row="4"
              ColumnDefinitions="Auto,Auto,Auto,*,Auto"
              Background="{DynamicResource DotPad.StatusBar.BackgroundBrush}">
            <TextBlock x:Name="ExecStatusBlock"
                       Grid.Column="0"
                       FontWeight="SemiBold"
                       Margin="8,0,12,0"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Text="Ready"/>
            <TextBlock x:Name="ElapsedBlock"
                       Grid.Column="1"
                       Foreground="{DynamicResource DotPad.StatusBar.ForegroundBrush}"
                       VerticalAlignment="Center"
                       FontSize="12"/>

            <!-- "{Kind} · {TargetSdk}" for the currently open .rpad — set in SetDocumentContent. -->
            <TextBlock x:Name="ProjectInfoBlock"
                       Grid.Column="2"
                       Foreground="{DynamicResource DotPad.StatusBar.ForegroundBrush}"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="12"/>

            <TextBlock x:Name="StatusLine"
                       Grid.Column="4"
                       Foreground="{DynamicResource DotPad.StatusBar.ForegroundBrush}"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       FontSize="12"/>
        </Grid>

    </Grid>

</UserControl>
