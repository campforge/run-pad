<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DotPad.UserControls.Models"
             x:Class="DotPad.UserControls.FileTreeView"
             x:DataType="models:FileTreeViewModel">

    <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0"
                   Text="FILES"
                   FontSize="11"
                   FontWeight="Medium"
                   LetterSpacing="1.0"
                   Margin="12,6,8,2"
                   Foreground="{DynamicResource DotPad.Text.SecondaryBrush}"
                   Opacity="0.6" />

        <TreeView Grid.Row="1"
                  Name="FileTree"
                  ItemsSource="{Binding Nodes}"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="4,2,4,8"
                  SelectionMode="Single"
                  PointerPressed="FileTree_PointerPressed"
                  KeyDown="FileTree_KeyDown"
                  SelectionChanged="FileTree_SelectionChanged">

            <TreeView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Rename" Click="ContextRename_Click">
                        <MenuItem.Icon>
                            <PathIcon Data="{StaticResource Icon.Rename}" Width="16" Height="16" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Delete" Click="ContextDelete_Click">
                        <MenuItem.Icon>
                            <PathIcon Data="{StaticResource Icon.Delete}" Width="16" Height="16" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Show in File Manager" Click="ContextOpenFolder_Click">
                        <MenuItem.Icon>
                            <PathIcon Data="{StaticResource Icon.FolderOpen}" Width="16" Height="16" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </TreeView.ContextMenu>

            <TreeView.Styles>
                <Style Selector="TreeViewItem">
                    <Setter Property="Padding" Value="6,0,6,0" />
                    <Setter Property="MinHeight" Value="27" />
                    <Setter Property="Margin" Value="0,0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Cursor" Value="Hand" />
                </Style>
                <Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
                    <Setter Property="Background" Value="{DynamicResource DotPad.Toolbar.Button.HoverBrush}" />
                    <Setter Property="CornerRadius" Value="5" />
                </Style>
                <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
                    <Setter Property="Background" Value="{DynamicResource DotPad.Accent.BackgroundBrush}" />
                    <Setter Property="CornerRadius" Value="5" />
                </Style>
                <Style Selector="TreeViewItem:selected /template/ Border#SelectionIndicator">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="TreeViewItem:selected TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource DotPad.Accent.ForegroundBrush}" />
                </Style>
                <Style Selector="TreeViewItem TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource DotPad.Text.PrimaryBrush}" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style Selector="TreeViewItem:focus /template/ Border#PART_LayoutRoot">
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </TreeView.Styles>

            <TreeView.ItemTemplate>
                <TreeDataTemplate DataType="models:FileTreeViewNode" ItemsSource="{Binding SubNodes}">
                    <Panel VerticalAlignment="Center" Margin="0,1">

                        <StackPanel Orientation="Horizontal" Spacing="7"
                                    IsVisible="{Binding !IsRenaming}"
                                    VerticalAlignment="Center">
                            <Path Width="12" Height="14"
                                  VerticalAlignment="Center"
                                  Stretch="Fill"
                                  Opacity="0.55"
                                  Fill="{DynamicResource DotPad.Text.PrimaryBrush}"
                                  Data="M1,0 L7.5,0 L11,3.5 L11,14 L1,14 Z M7.5,0 L7.5,3.5 L11,3.5 Z" />
                            <TextBlock Text="{Binding DisplayName}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBox Text="{Binding EditingName, Mode=TwoWay}"
                                 IsVisible="{Binding IsRenaming}"
                                 FontSize="13"
                                 Padding="3,1"
                                 MinHeight="0"
                                 BorderThickness="1"
                                 VerticalAlignment="Center"
                                 KeyDown="RenameBox_KeyDown"
                                 LostFocus="RenameBox_LostFocus" />
                    </Panel>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</UserControl>
