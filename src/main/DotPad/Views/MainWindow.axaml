<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:av="clr-namespace:Avalonia.HtmlRenderer;assembly=DotPad.Avalonia.HtmlRenderer"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DotPad.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:codeTextEditor="clr-namespace:DotPad.Avalonia.CodeTextEditor;assembly=DotPad.Avalonia.CodeTextEditor"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="DotPad.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    Icon="/Assets/avalonia-logo.ico"
    Title="DotPad">

    <Window.Styles>

        <!-- ── Button.TopBarButton ───────────────────────────────────────────── -->
        <Style Selector="Button.TopBarButton">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"      Value="4"/>
            <Setter Property="Width"        Value="26"/>
            <Setter Property="Height"       Value="26"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.TopBarButton:pointerover /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource DotPad.Toolbar.Button.HoverBrush}"/>
        </Style>
        <Style Selector="Button.TopBarButton:pressed /template/ Border#Root">
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
        <Style Selector="Button.TopBarButton:disabled">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>
        <Style Selector="Button.TopBarButton Image">
            <Setter Property="Width"  Value="16"/>
            <Setter Property="Height" Value="16"/>
        </Style>

        <!-- ── ToggleButton.TopBarButton ─────────────────────────────────────── -->
        <Style Selector="ToggleButton.TopBarButton">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"      Value="4"/>
            <Setter Property="Width"        Value="26"/>
            <Setter Property="Height"       Value="26"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="ToggleButton">
                    <Border Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.TopBarButton:pointerover /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource DotPad.Toolbar.Button.HoverBrush}"/>
        </Style>
        <Style Selector="ToggleButton.TopBarButton:pressed /template/ Border#Root">
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
        <Style Selector="ToggleButton.TopBarButton:checked /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource DotPad.Accent.BackgroundBrush}"/>
        </Style>
        <Style Selector="ToggleButton.TopBarButton:disabled">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>
        <Style Selector="ToggleButton.TopBarButton Image">
            <Setter Property="Width"  Value="16"/>
            <Setter Property="Height" Value="16"/>
        </Style>

        <!-- ── ComboBox inside toolbar ───────────────────────────────────────── -->
        <Style Selector="StackPanel.Toolbar ComboBox">
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="CornerRadius"    Value="4"/>
        </Style>
        <Style Selector="StackPanel.Toolbar ComboBox /template/ Border#Background">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="StackPanel.Toolbar ComboBox:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource DotPad.Toolbar.Button.HoverBrush}"/>
        </Style>
        <Style Selector="StackPanel.Toolbar ComboBox:focus /template/ Border#Background">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="StackPanel.Toolbar ComboBox[IsDropDownOpen=true] /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource DotPad.Toolbar.Button.HoverBrush}"/>
        </Style>

    </Window.Styles>

    <Grid ColumnDefinitions="300, *">

        <!-- ── Sidebar ──────────────────────────────────────────────────── -->
        <Grid Grid.Column="0" RowDefinitions="40, *"
              Background="{DynamicResource DotPad.Sidebar.BackgroundBrush}">
            <Menu Grid.Row="0">
                <MenuItem Header="Edit">
                    <MenuItem Header="_Preferences" Click="Preferences_Click" />
                </MenuItem>
            </Menu>
            <TreeView Grid.Row="1" ItemsSource="{Binding Nodes}">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding SubNodes}">
                        <TextBlock Text="{Binding Title}" />
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>

        <!-- ── Editor + output ──────────────────────────────────────────── -->
        <Grid Grid.Column="1" RowDefinitions="*, 1, 250, 25">

            <!-- Editor area -->
            <Grid Grid.Row="0" RowDefinitions="40, *">

                <!-- Progress bar — thin strip at the bottom of the toolbar -->
                <ProgressBar Grid.Row="0"
                             VerticalAlignment="Bottom"
                             Height="2"
                             ZIndex="10"
                             IsIndeterminate="True"
                             IsVisible="{Binding IsRunningProgress}"
                             Foreground="{DynamicResource DotPad.Accent.BackgroundBrush}"
                             Background="Transparent"
                             BorderThickness="0"/>

                <!-- Toolbar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource DotPad.Toolbar.BackgroundBrush}"
                        BorderBrush="{DynamicResource DotPad.Toolbar.BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="1" Margin="4,0"
                                Classes="Toolbar"
                                VerticalAlignment="Center">
                        <Button
                            Classes="TopBarButton"
                            Name="RunButton"
                            IsEnabled="{Binding EnableRunButton}"
                            Click="RunButton_Click"
                            ToolTip.Tip="Run (F5)">
                            <Image Source="{StaticResource Run}"/>
                        </Button>
                        <ToggleButton
                            Classes="TopBarButton"
                            IsChecked="{Binding DebugModeEnabled}"
                            ToolTip.Tip="Toggle debug mode">
                            <Image Source="{StaticResource Bug}"/>
                        </ToggleButton>
                        <Button
                            Classes="TopBarButton"
                            Name="CancelButton"
                            Click="CancelButton_Click"
                            IsEnabled="{Binding EnableCancelButton}"
                            ToolTip.Tip="Cancel">
                            <Image Source="{StaticResource Stop}" />
                        </Button>
                        <ComboBox
                            Margin="4,0,0,0"
                            Height="24"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            ItemsSource="{Binding DotnetPlatforms}"
                            SelectedItem="{Binding SelectedDotnetPlatform}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Description}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Code editor -->
                <codeTextEditor:CodeTextEditor
                    Grid.Row="1"
                    Name="Editor"
                    Background="{DynamicResource DotPad.Editor.BackgroundBrush}"
                    FontFamily="Cascadia Code,Consolas,Menlo,Monospace"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Visible"
                    FontWeight="Light"
                    FontSize="14" />
            </Grid>

            <!-- Separator -->
            <Border Grid.Row="1"
                    Background="{DynamicResource DotPad.Separator.BackgroundBrush}" />

            <!-- Output tabs -->
            <TabControl Grid.Row="2" Name="OutputTabs">
                <TabItem Header="Results" FontSize="14">
                    <av:HtmlPanel x:Name="HtmlPanel"
                                  Background="{DynamicResource DotPad.Output.BackgroundBrush}">
                        <ToolTip.Tip>
                            <ToolTip BorderBrush="Transparent" Padding="0" ShowDelay="5000">
                                <av:HtmlLabel x:Name="HtmlTooltipLabel" />
                            </ToolTip>
                        </ToolTip.Tip>
                    </av:HtmlPanel>
                </TabItem>
                <TabItem Header="Debugger" FontSize="14">
                    <Grid RowDefinitions="Auto,*">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="2" Margin="2,2,2,4">
                            <Button Name="DbgContinueButton"
                                    IsEnabled="{Binding IsPaused}"
                                    Click="DbgContinue_Click"
                                    ToolTip.Tip="Continue (F5)"
                                    FontSize="14" Width="28" Height="24" Padding="0">▶</Button>
                            <Button Name="DbgStepOverButton"
                                    IsEnabled="{Binding IsPaused}"
                                    Click="DbgStepOver_Click"
                                    ToolTip.Tip="Step Over (F10)"
                                    FontSize="14" Width="28" Height="24" Padding="0">⤵</Button>
                            <Button Name="DbgStepInButton"
                                    IsEnabled="{Binding IsPaused}"
                                    Click="DbgStepIn_Click"
                                    ToolTip.Tip="Step In (F11)"
                                    FontSize="14" Width="28" Height="24" Padding="0">↓</Button>
                            <Button Name="DbgStepOutButton"
                                    IsEnabled="{Binding IsPaused}"
                                    Click="DbgStepOut_Click"
                                    ToolTip.Tip="Step Out (Shift+F11)"
                                    FontSize="14" Width="28" Height="24" Padding="0">↑</Button>
                            <Border Width="1" Height="20"
                                    Background="{DynamicResource DotPad.Separator.BackgroundBrush}"
                                    Margin="4,0"/>
                            <Button Name="DbgPauseButton"
                                    IsEnabled="{Binding IsDebugging}"
                                    Click="DbgPause_Click"
                                    ToolTip.Tip="Pause"
                                    FontSize="14" Width="28" Height="24" Padding="0">⏸</Button>
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding DebugInfo}"
                                   FontFamily="Cascadia Code,Consolas,Monospace"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="6"
                                   VerticalAlignment="Top" />
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Status bar -->
            <Grid Grid.Row="3" Height="25"
                  Background="{DynamicResource DotPad.StatusBar.BackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="StatusText" Text="Ready"
                           Grid.Column="0"
                           Foreground="{DynamicResource DotPad.StatusBar.ForegroundBrush}"
                           Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" />
                <TextBlock Name="ExecutionStatusText"
                           Grid.Column="1"
                           FontWeight="SemiBold"
                           Margin="0,0,12,0" VerticalAlignment="Center" FontSize="11" />
                <TextBlock Name="ElapsedText"
                           Grid.Column="2"
                           Foreground="{DynamicResource DotPad.StatusBar.ForegroundBrush}"
                           Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12" />
            </Grid>

        </Grid>
    </Grid>
</Window>
