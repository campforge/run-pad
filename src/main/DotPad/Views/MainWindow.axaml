<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:av="clr-namespace:Avalonia.HtmlRenderer;assembly=DotPad.Avalonia.HtmlRenderer"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DotPad.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:codeTextEditor="clr-namespace:DotPad.Avalonia.CodeTextEditor;assembly=DotPad.Avalonia.CodeTextEditor"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="DotPad.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    Icon="/Assets/avalonia-logo.ico"
    Title="DotPad">

    <Window.Styles>
        <Style Selector="Button.TopBarButton">
        </Style>
        
        <Style Selector="Button.TopBarButton Image">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
        </Style>

        <Style Selector="ToggleButton.TopBarButton Image">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
        </Style>

        <Style Selector="ToggleButton.TopBarButton:checked">
            <Setter Property="Background" Value="#3300A0FF"/>
        </Style>
        
        <Style Selector="Button.TopBarComboBox">
            <Setter Property="Padding" Value="0,10,0,0"/>
        </Style>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    </Window.Styles>
    
    <Grid ColumnDefinitions="300, *">

        <!-- Pane -->
        <Grid Grid.Column="0" RowDefinitions="40, *">
            <Menu Grid.Row="0">
                <MenuItem Header="Edit">
                    <MenuItem Header="_Preferences" Click="Preferences_Click" />
                </MenuItem>
            </Menu>
            <TreeView Grid.Row="1" ItemsSource="{Binding Nodes}">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding SubNodes}">
                        <TextBlock Text="{Binding Title}" />
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>

        <!-- Editor + output -->
        <Grid Grid.Column="1" RowDefinitions="*, 2, 250, 25">
            <Grid Grid.Row="0" RowDefinitions="40, *">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="1" Margin="1">
                    <Button
                        Classes="TopBarButton"
                        Name="RunButton"
                        IsEnabled="{Binding EnableRunButton}"
                        Click="RunButton_Click"
                        ToolTip.Tip="Run (F5)">
                        <Image Source="{StaticResource Run}"/>
                    </Button>
                    <ToggleButton
                        Classes="TopBarButton"
                        IsChecked="{Binding DebugModeEnabled}"
                        ToolTip.Tip="Toggle debug mode">
                        <Image Source="{StaticResource Bug}"/>
                    </ToggleButton>
                    <Button
                        Classes="TopBarButton"
                        Name="CancelButton"
                        Click="CancelButton_Click"
                        IsEnabled="{Binding EnableCancelButton}"
                        ToolTip.Tip="Cancel">
                        <Image Source="{StaticResource Stop}" />
                    </Button>
                    <ComboBox
                        Classes="TopBarComboBox"
                        ItemsSource="{Binding DotnetPlatforms}"
                        SelectedItem="{Binding SelectedDotnetPlatform}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Description}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <codeTextEditor:CodeTextEditor
                    Grid.Row="1"
                    Name="Editor"
                    FontFamily="Cascadia Code,Consolas,Menlo,Monospace"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Visible"
                    FontWeight="Light"
                    FontSize="14" />
            </Grid>
            <Border Grid.Row="1" Background="Gray" />
            <TabControl Grid.Row="2" Name="OutputTabs">
                <TabItem Header="Results" FontSize="14">
                    <av:HtmlPanel x:Name="HtmlPanel" Background="MintCream">
                        <ToolTip.Tip>
                            <ToolTip BorderBrush="Transparent" Padding="0" ShowDelay="5000">
                                <av:HtmlLabel x:Name="HtmlTooltipLabel" />
                            </ToolTip>
                        </ToolTip.Tip>
                    </av:HtmlPanel>
                </TabItem>
                <TabItem Header="Debugger" FontSize="14">
                    <Grid RowDefinitions="Auto,*">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="2" Margin="2,2,2,4">
                            <Button Name="DbgContinueButton"
                                    IsEnabled="{Binding IsPaused}"
                                    Click="DbgContinue_Click"
                                    ToolTip.Tip="Continue (F5)"
                                    FontSize="14" Width="28" Height="24" Padding="0">▶</Button>
                            <Button Name="DbgStepOverButton"
                                    IsEnabled="{Binding IsPaused}"
                                    Click="DbgStepOver_Click"
                                    ToolTip.Tip="Step Over (F10)"
                                    FontSize="14" Width="28" Height="24" Padding="0">⤵</Button>
                            <Button Name="DbgStepInButton"
                                    IsEnabled="{Binding IsPaused}"
                                    Click="DbgStepIn_Click"
                                    ToolTip.Tip="Step In (F11)"
                                    FontSize="14" Width="28" Height="24" Padding="0">↓</Button>
                            <Button Name="DbgStepOutButton"
                                    IsEnabled="{Binding IsPaused}"
                                    Click="DbgStepOut_Click"
                                    ToolTip.Tip="Step Out (Shift+F11)"
                                    FontSize="14" Width="28" Height="24" Padding="0">↑</Button>
                            <Border Width="1" Height="20" Background="Gray" Margin="4,0"/>
                            <Button Name="DbgPauseButton"
                                    IsEnabled="{Binding IsDebugging}"
                                    Click="DbgPause_Click"
                                    ToolTip.Tip="Pause"
                                    FontSize="14" Width="28" Height="24" Padding="0">⏸</Button>
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding DebugInfo}"
                                   FontFamily="Cascadia Code,Consolas,Monospace"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="6"
                                   VerticalAlignment="Top" />
                    </Grid>
                </TabItem>
            </TabControl>
            <StackPanel Grid.Row="3" Name="StatusBar" Background="Purple" Height="25"
                        Orientation="Horizontal">
                <TextBlock Foreground="White" Name="StatusText" Text="Ready"
                           Margin="5,0,0,0" VerticalAlignment="Center" FontSize="12" />
            </StackPanel>
        </Grid>

    </Grid>
</Window>