<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:DotPad.ViewModels"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="450"
        x:Class="DotPad.Views.PreferencesWindow"
        Title="Preferences"
        x:DataType="viewModels:PreferencesWindowViewModel"
        Background="{DynamicResource DotPad.Panel.BackgroundBrush}"
        Foreground="{DynamicResource DotPad.Text.PrimaryBrush}"
        >

            <TabControl Margin="2"
                        Background="{DynamicResource DotPad.Panel.BackgroundBrush}">
                <TabItem Header="Interface">
                    <StackPanel Margin="2">
                        <Grid ColumnDefinitions="*,*,*,*">
                            <TextBlock Grid.Column="0" Text="Theme:" Margin="0,8,0,0"/>
                            <ComboBox Grid.Column="1" Grid.ColumnSpan="3"
                                      ItemsSource="{Binding Themes}"
                                      SelectedItem="{Binding SelectedTheme}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <CheckBox IsChecked="{Binding ShowTabs}"
                                  Content="Show tabs" />
                        <CheckBox IsChecked="{Binding ShowSpaces}"
                                  Content="View spaces" />
                        <CheckBox IsChecked="{Binding ShowEndOfLine}"
                                  Content="View EOL" />
                        <CheckBox IsChecked="{Binding ShowColumnRulers}"
                                  Content="View columns rulers" /> 
                    </StackPanel>
                </TabItem>

                <TabItem Header="Debugger">
                    <StackPanel Margin="2">
                        <Panel ToolTip.Tip="Dotnet">
                            <TextBlock Margin="0 5 0 0" Text="Dotnet path:"  />
                            <TextBox Margin="0 25 0 0" Watermark="Dotnet path" Text="{Binding DotnetPath}"/>
                        </Panel>

                        <Panel ToolTip.Tip="Debugger" Margin="0 10 0 0">
                            <TextBlock Margin="0 5 0 0" Text="Debugger path:"  />
                            <TextBox  Margin="0 25 0 0" Watermark="Debugger path" Text="{Binding DebuggerPath}"/>
                        </Panel>
                    </StackPanel>
                </TabItem>
            </TabControl>
</Window>