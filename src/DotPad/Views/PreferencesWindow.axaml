<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:DotPad.ViewModels"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="450"
        x:Class="DotPad.Views.PreferencesWindow"
        Title="Preferences"
        x:DataType="viewModels:PreferencesWindowViewModel"
        >

            <StackPanel Margin="2">
                <Grid ColumnDefinitions="*,*,*,*">
                    <TextBlock Grid.Column="0" Text="Theme:" Margin="0,8,0,0"/>
                    <ComboBox Grid.Column="1" Grid.ColumnSpan="3"
                              ItemsSource="{Binding Themes}"
                        SelectedValue="{Binding Path=SelectedTheme}"
                        SelectedValueBinding="{Binding ThemeType}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ThemeType}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                
                <CheckBox IsChecked="{Binding ShowTabs}"
                          Content="Show tabs" />
                <CheckBox IsChecked="{Binding ShowSpaces}"
                          Content="View spaces" />
                <CheckBox IsChecked="{Binding ShowEndOfLine}"
                          Content="View EOL" />
                <CheckBox IsChecked="{Binding ShowColumnRulers}"
                          Content="View columns rulers" />

                
                <Panel ToolTip.Tip="Dotnet">
                    <TextBlock Margin="0 5" Text="Dotnet:"  />
                </Panel>
                
                <Panel ToolTip.Tip="Debugger">
                    <TextBlock Margin="0 5" Text="Debugger:"  />
                </Panel>
                
                <!-- <TextBox UseFloatingWatermark="True" -->
                <!--          Watermark="This is the floating watermark example." -->
                <!--          Text="If you enter some text, it will float to the top." /> -->
            </StackPanel>
</Window>