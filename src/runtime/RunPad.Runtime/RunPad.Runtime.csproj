<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- So CSharpIntelliSenseService's .Dump() completion/signature-help tooltips can show the real
         <summary> docs — MSBuild copies this .xml next to the .dll for
         every consumer, which is exactly where ReferenceDocumentation looks for it. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- MIT, unlike the rest of RunPad (GPL-3.0): this library is compiled into and shipped with users'
         own scripts, so it must not put them under the GPL. See LICENSE in this folder. The copyright
         string is embedded in RunPad.Runtime.dll, so the notice travels with every copy. -->
    <Authors>Vadim (hobobyte)</Authors>
    <Copyright>Copyright (c) 2026 Vadim (hobobyte). Licensed under the MIT License.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>
