<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Проход 134/135 (CI-cost pass) — this project is DotPad.Runtime.UI.Tests' non-Avalonia half:
         every test here exercises language hosts/IntelliSense/decompiler/DAP/view-model logic that
         never touches a live Avalonia Application, so it doesn't reference Avalonia.Headless(.XUnit)
         at all and — unlike DotPad.Runtime.UI.Tests, where [assembly: AvaloniaTestFramework] disables
         collection parallelism for the WHOLE assembly regardless of whether a given test uses Avalonia
         (confirmed empirically — see TODO.md проход 135) — gets ordinary xunit parallel test-collection
         execution "for free". Still xunit.v3 (not the classic xunit 2.x the other simple projects use)
         because several of these files use xunit v3's TestContext.Current.CancellationToken.
    -->
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" VersionOverride="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Moq" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\main\DotPad\DotPad.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
