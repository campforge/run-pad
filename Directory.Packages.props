<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Let NuGet transparently use .NET 8/9 assets on .NET 10 -->
    <AssetTargetFallback>$(AssetTargetFallback);net9.0;net8.0</AssetTargetFallback>
  </PropertyGroup>
  <ItemGroup>
    <!-- Avalonia -->
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Browser" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageVersion Include="Avalonia.ReactiveUI" Version="11.3.9" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Simple" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <!-- RunPad.Avalonia.HtmlRenderer.Tests: real Skia rasterization for render-scaling pixel tests
         (Avalonia.Desktop already brings it in transitively for the app itself). -->
    <PackageVersion Include="Avalonia.Skia" Version="12.1.4" />
    <!-- AvaloniaEdit.Tests (local AvaloniaEdit fork) uses NUnit — its upstream's own
         test framework, kept as-is rather than ported to xunit along with the rest of the solution. -->
    <PackageVersion Include="Avalonia.Headless.NUnit" Version="12.1.4" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.0" />
    <!-- TextMate -->
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="Spectre.Console.Testing" Version="0.57.2" />
    <PackageVersion Include="TextMateSharp" Version="2.0.4" />
    <PackageVersion Include="TextMateSharp.Grammars" Version="2.0.4" />
    <!-- Markdown parser of the MarkView.Avalonia fork (src/controls/MarkView.Avalonia), at the
         version its 12.3.0 release was built with. -->
    <PackageVersion Include="Markdig" Version="1.4.0" />
    <!-- gRPC connections: server reflection (RunPad.Connectors.Grpc) and the test server. -->
    <PackageVersion Include="Grpc.Net.Client" Version="2.84.0" />
    <PackageVersion Include="Grpc.Reflection" Version="2.84.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <PackageVersion Include="Grpc.AspNetCore" Version="2.84.0" />
    <PackageVersion Include="Grpc.AspNetCore.Server.Reflection" Version="2.84.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.84.0" />
    <!-- SQLite connections: RunPad reads the schema (RunPad.Connectors.Sqlite); scripts get EF Core. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <!-- Roslyn / Build (versions pinned to real preview/stable releases) -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <!-- Real Roslyn CodeFixProviders/analyzers (ReSharper/LINQPad-style lightbulb quick fixes) -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Features" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.9.0" />
    <!-- VB scripts compile in-process too (no MSBuild) -->
    <PackageVersion Include="Microsoft.CodeAnalysis.VisualBasic" Version="5.9.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
    <!-- In-process package restore for scripts (the engine `dotnet restore` uses), no MSBuild. -->
    <PackageVersion Include="NuGet.Commands" Version="7.9.0" />
    <PackageVersion Include="NuGet.Common" Version="7.9.0" />
    <PackageVersion Include="NuGet.Configuration" Version="7.9.0" />
    <PackageVersion Include="NuGet.Protocol" Version="7.9.0" />
    <PackageVersion Include="NuGet.Versioning" Version="7.9.0" />
    <!-- Not used directly: NuGet.Packaging 7.9.0 asks for 8.0.1, which has known denial-of-service
         vulnerabilities (CVE-2026-84008, CVE-2026-70162); 8.0.2 is the fixed release of the same line.
         Referenced by RunPad.Languages.DotnetCommon, which brings in NuGet. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <!-- System -->
    <PackageVersion Include="System.Composition.AttributedModel" Version="10.0.12" />
    <PackageVersion Include="System.Composition.Hosting" Version="10.0.12" />
    <PackageVersion Include="System.Configuration.ConfigurationManager" Version="10.0.12" />
    <!-- Source Link -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="8.0.0" />
    <!-- Format -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <!-- Tests -->
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Avalonia.Headless.XUnit 12.0.5 depends on xunit v3 (a different package family from
         classic "xunit" 2.x above), so RunPad.Runtime.UI.Tests uses these instead — see its
         csproj comment. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <!-- IL disassembly for the "IL" output tab — ILSpy/SharpDevelop team, actively maintained. -->
    <PackageVersion Include="ICSharpCode.Decompiler" Version="11.1.0.9782" />
  </ItemGroup>
</Project>